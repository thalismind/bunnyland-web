{
  "name": "bunnyland-web",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:ui": "node scripts/sync-ui-web.mjs",
    "check:ui": "node scripts/sync-ui-web.mjs --check",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "lint:js": "eslint \"**/*.{js,html}\"",
    "lint:css": "stylelint \"**/*.{css,html}\"",
    "lint:html": "htmlhint \"**/*.html\"",
    "test": "node --test",
    "build": "npm run check",
    "check": "npm run check:ui && npm run lint && npm test"
  },
  "dependencies": {
    "@bunnyland/ui-web": "file:../bunnyland-ui-web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "eslint-plugin-html": "^8.1.4",
    "globals": "^17.6.0",
    "htmlhint": "^1.9.2",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.13.0"
  }
}
