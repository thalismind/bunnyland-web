{
  "name": "bunnyland-web",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "lint:js": "eslint \"**/*.{js,ts,tsx,html}\"",
    "lint:css": "stylelint \"**/*.{css,html}\"",
    "lint:html": "htmlhint \"**/*.html\"",
    "test": "node --test && vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "build": "vite build && node scripts/check-player-entry-budgets.mjs",
    "check:player-budgets": "node scripts/check-player-entry-budgets.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@bunnyland/ui-web": "0.2.6",
    "litegraph.js": "0.7.13",
    "preact": "^10.29.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.0",
    "@testing-library/preact": "^3.2.0",
    "@types/node": "^24.0.0",
    "axe-core": "^4.10.3",
    "eslint": "^10.7.0",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "htmlhint": "^1.9.2",
    "jsdom": "^29.1.1",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.13.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.49.0",
    "vite": "^8.1.0",
    "vitest": "^4.0.0"
  }
}
