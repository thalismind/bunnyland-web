map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

map $uri $bunnyland_cache_control {
    "~^/(?:[^/]+/)*assets/.*-[A-Za-z0-9_-]{8,}\.[^/]+$" "public, max-age=31536000, immutable";
    /config.json "no-store";
    default "no-cache";
}

gzip on;
gzip_comp_level 6;
gzip_min_length 1024;
gzip_types application/javascript application/json image/svg+xml text/css text/plain;

resolver 127.0.0.11 ipv6=off valid=10s;

limit_req_zone $binary_remote_addr zone=bunnyland_api:10m rate=${BUNNYLAND_EDGE_API_RATE};
limit_conn_zone $binary_remote_addr zone=bunnyland_api_conn:10m;
limit_req_status 429;
limit_conn_status 429;

server {
    listen 8080;
    server_name ${BUNNYLAND_SERVER_NAME};
    set $bunnyland_api_upstream ${BUNNYLAND_API_UPSTREAM};

    root /usr/share/nginx/html;
    index index.html;

    # Security headers travel with the container so protection does not depend on an edge
    # reverse proxy being in front. Kept in sync with the app server block in
    # bunnyland-server/deploy/nginx/frontend-tunnel.conf.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header X-Frame-Options "DENY" always;
    add_header Cache-Control $bunnyland_cache_control always;

    location = /config.json {
        alias /tmp/bunnyland-config.json;
        default_type application/json;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/v1/admin/ {
        return 403;
    }

    location /api/ {
        limit_req zone=bunnyland_api burst=${BUNNYLAND_EDGE_API_BURST} nodelay;
        limit_conn bunnyland_api_conn ${BUNNYLAND_EDGE_API_CONNECTIONS};
        client_max_body_size ${BUNNYLAND_EDGE_MAX_BODY_SIZE};

        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $bunnyland_api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
    }
}
