#!/usr/bin/env python3
"""Playwright regression test for the Bunnyland Web TUI."""

from __future__ import annotations

import json
import os
import shutil
import time
from pathlib import Path
from urllib.parse import quote

from playwright.sync_api import expect, sync_playwright

from playwright_coverage import PlaywrightCoverage
from playwright_server import ensure_web_server


BASE_URL = os.environ.get("BUNNYLAND_WEB_BASE_URL", "http://127.0.0.1:8091").rstrip("/")
SCREENSHOT_DIR = Path(os.environ.get("BUNNYLAND_PLAYWRIGHT_SCREENSHOT_DIR", "/tmp"))

CHARACTER = "character:1"
OTHER = "character:2"
ROOM = "room:1"
EXIT = "room:2"
CLAIM_ID = "claim-web-tui"
CLAIM_SECRET = "secret-web-tui"

CHARACTER_LIST = {
    "world_epoch": 8,
    "characters": [{"character_id": CHARACTER, "name": "Bun", "kind": "character"}],
}

CHARACTER_PROJECTION = {
    "character_id": CHARACTER,
    "world_epoch": 8,
    "character_name": "Bun",
    "room": {
        "id": ROOM,
        "title": "Parlor",
        "exits": [{"id": EXIT, "direction": "north", "label": "Hallway"}],
        "entities": [
            {"id": CHARACTER, "name": "Bun", "kind": "character", "is_character": True},
            {"id": OTHER, "name": "Marlow", "kind": "character", "is_character": True},
        ],
    },
    "inventory": [{"id": "item:1", "label": "a brass key", "kind": "item"}],
    "points": {"action": 5, "action_max": 5, "focus": 3, "focus_max": 3},
    "controller": {"controller_id": "web:tui", "generation": 4},
    "target_groups": {
        "characters": [{"id": OTHER, "label": "Marlow", "kind": "character"}],
        "exits": [{"id": EXIT, "label": "north", "kind": "exit"}],
        "inventory": [{"id": "item:1", "label": "a brass key", "kind": "item"}],
    },
    "actions": [
        {
            "command_type": "shout",
            "tool_name": "shout",
            "title": "Shout",
            "lane": "world",
            "cost": {"action": 1, "focus": 4},
            "arguments": [],
            "available": False,
            "enough_action_points": True,
            "enough_focus_points": False,
            "has_required_target": True,
            "meets_requirements": True,
            "unavailable_reason": "not enough focus points",
        },
        {
            "command_type": "move",
            "tool_name": "move",
            "title": "Move",
            "lane": "world",
            "cost": {"action": 1, "focus": 0},
            "arguments": [
                {
                    "key": "exit_id",
                    "title": "exit",
                    "kind": "entity",
                    "required": True,
                    "target_group": "exits",
                },
            ],
        },
        {
            "command_type": "tell",
            "tool_name": "tell",
            "title": "Tell",
            "lane": "world",
            "cost": {"action": 1, "focus": 1},
            "arguments": [
                {
                    "key": "target_id",
                    "title": "target",
                    "kind": "entity",
                    "required": True,
                    "target_group": "characters",
                },
                {"key": "text", "title": "text", "kind": "string", "required": True},
            ],
        },
        {
            "command_type": "use_item",
            "tool_name": "use-item",
            "title": "Use Item",
            "lane": "world",
            "cost": {"action": 1, "focus": 0},
            "arguments": [
                {
                    "key": "target_id",
                    "title": "item",
                    "kind": "entity",
                    "required": True,
                    "target_group": "inventory",
                },
            ],
        },
        {
            "command_type": "remember",
            "tool_name": "remember",
            "title": "Remember",
            "lane": "focus",
            "cost": {"action": 0, "focus": 1},
            "arguments": [
                {"key": "query", "title": "query", "kind": "string", "required": True},
            ],
        },
    ],
}

QUEUED = {
    "character_id": CHARACTER,
    "world_epoch": 8,
    "generated_at_unix": time.time(),
    "next_tick_at_unix": time.time() + 45,
    "tick_seconds": 10,
    "commands": [
        {
            "command_id": "queued-1",
            "character_id": CHARACTER,
            "command_type": "remember",
            "payload": {"query": "brass key"},
            "cost": {"action": 0, "focus": 1},
            "lane": "focus",
            "submitted_at_epoch": 8,
        }
    ],
}
EVENTS = {"events": []}


def launch_browser(playwright):
    chrome = (
        os.environ.get("BUNNYLAND_CHROME")
        or shutil.which("google-chrome")
        or shutil.which("chromium")
        or shutil.which("chromium-browser")
    )
    kwargs = {"headless": True}
    if chrome:
        kwargs["executable_path"] = chrome
        kwargs["args"] = ["--no-sandbox"]
    return playwright.chromium.launch(**kwargs)


def json_route(body):
    def handler(route):
        route.fulfill(status=200, content_type="application/json", body=json.dumps(body))

    return handler


def install_routes(
    page,
    posted: list[dict],
    content_flags: list[str] | None = None,
    allow_missing_cookie_header: bool = False,
) -> None:
    page.route("**/config.json", json_route({"serverUrl": "", "autoConnect": False}))
    page.route("**/public/features", json_route({
        "character_chat": True, "character_sheets": True,
    }))
    page.route("**/public/world", json_route({
        "world_id": "world:test", "world_epoch": 1, "title": "Test World",
        "description": "", "content_flags": content_flags or [],
    }))
    page.route("**/auth/session", json_route({
        "subject": "play-test", "scopes": ["world:play"],
        "expires_at": 4102444800, "rotate_after": None, "rotation_eligible": False,
    }))
    deleted: list[str] = []
    fallback_updates: list[dict] = []
    claim_state = {
        "character_requests": 0,
        "event_requests": 0,
        "expired": False,
        "methods": [],
        "projection_requests": 0,
    }
    page.exposed_deleted_commands = deleted
    page.exposed_fallback_updates = fallback_updates
    page.exposed_claim_state = claim_state

    def assert_claim(route) -> None:
        headers = route.request.all_headers()
        if "x-bunnyland-claim-secret" in headers:
            raise AssertionError(f"browser leaked a claim secret header on {route.request.url}")
        if (
            not allow_missing_cookie_header
            and f"bunnyland_claim={CLAIM_SECRET}" not in headers.get("cookie", "")
        ):
            raise AssertionError(f"missing HttpOnly claim cookie on {route.request.url}")
        if f"/claims/{CLAIM_ID}" not in route.request.url:
            raise AssertionError(f"missing claim id on {route.request.url}")

    def command_handler(route):
        assert_claim(route)
        posted.append(json.loads(route.request.post_data or "{}"))
        route.fulfill(status=200, content_type="application/json", body=json.dumps({"ok": True}))

    def cancel_handler(route):
        assert_claim(route)
        deleted.append(route.request.url)
        route.fulfill(
            status=200,
            content_type="application/json",
            body=json.dumps({"cancelled": True}),
        )

    def claim_handler(route):
        claim_state["methods"].append(route.request.method)
        if route.request.method == "POST" and route.request.url.endswith("/play/claims"):
            request_body = json.loads(route.request.post_data or "{}")
            if request_body.get("delivery") != "cookie":
                raise AssertionError(f"browser claim did not request cookie delivery: {request_body!r}")
        if route.request.url.endswith("/fallback") or route.request.url.endswith("/release-controller"):
            assert_claim(route)
        if route.request.post_data:
            fallback_updates.append(json.loads(route.request.post_data))
        route.fulfill(
            status=200,
            content_type="application/json",
            headers={
                "Set-Cookie": (
                    f"bunnyland_claim={CLAIM_SECRET}; Path=/api/v1/play; "
                    "HttpOnly; SameSite=Strict"
                ),
            },
            body=json.dumps(
                {
                    "id": CLAIM_ID,
                    "character_id": CHARACTER,
                    "controller_id": "web:tui",
                    "controller_generation": 4,
                    "claim_id": CLAIM_ID,
                }
            ),
        )

    def projection_handler(route):
        assert_claim(route)
        claim_state["projection_requests"] += 1
        if claim_state["expired"]:
            route.fulfill(
                status=404,
                content_type="application/json",
                body=json.dumps({"detail": "claim does not exist"}),
            )
            return
        route.fulfill(status=200, content_type="application/json", body=json.dumps(projection))

    def character_list_handler(route):
        claim_state["character_requests"] += 1
        route.fulfill(status=200, content_type="application/json", body=json.dumps(CHARACTER_LIST))

    def scene_image_handler(route):
        assert_claim(route)
        route.fulfill(
            status=200,
            content_type="application/json",
            body=json.dumps({"ok": True, "status": "queued"}),
        )

    def recent_events_handler(route):
        assert_claim(route)
        claim_state["event_requests"] += 1
        route.fulfill(status=200, content_type="application/json", body=json.dumps(EVENTS))

    projection = {**CHARACTER_PROJECTION, **QUEUED}
    page.route("**/play/characters", character_list_handler)
    page.route("**/play/claims/**", claim_handler)
    page.route("**/play/claims/**/projection", projection_handler)
    page.route("**/play/claims/**/events**", recent_events_handler)
    page.route("**/play/claims/**/jobs", scene_image_handler)
    page.route("**/play/claims", claim_handler)
    page.route("**/play/claims/**/commands", command_handler)
    page.route("**/play/claims/**/commands/**", cancel_handler)


def connect_and_select(page) -> None:
    page.goto(f"{BASE_URL}/web-tui.html", wait_until="domcontentloaded")
    page.locator("#api-url").fill("/api/v1")
    page.locator("#btn-connect").click()
    page.wait_for_function("() => window.app?.characters?.length > 0", timeout=15000)
    page.locator("#player-select").select_option(CHARACTER)
    introduction = page.locator(".world-intro-dialog")
    expect(introduction).to_be_visible()
    introduction.get_by_role("button", name="Continue").click()
    page.wait_for_function(
        """(id) => (
            window.app?.projection?.characterId === id
            && window.app.projection.actions?.length > 0
        )""",
        arg=CHARACTER,
        timeout=15000,
    )
    expect(page.locator("#room-title")).to_contain_text("Parlor")
    expect(page.locator("#points-line")).to_contain_text("5 / 5 AP")
    expect(page.locator("#points-line")).to_contain_text("3 / 3 FP")
    expect(page.locator("#verbs")).to_contain_text("⌖ target")
    expect(page.locator("#verbs")).to_contain_text("1 AP")
    expect(page.locator("#verbs")).to_contain_text("1 FP")
    expect(page.locator("#verbs")).to_contain_text("World actions")
    expect(page.locator("#verbs")).to_contain_text("Focus actions")
    expect(page.locator("#queued")).to_contain_text("Remember")
    expect(page.locator("#queued")).to_contain_text("query: brass key")
    expect(page.locator("#queued")).to_contain_text("next tick in")
    initial_countdown = page.locator("#queued-title").text_content()
    page.wait_for_function(
        "initial => document.querySelector('#queued-title')?.textContent !== initial",
        arg=initial_countdown,
        timeout=2000,
    )
    expect(page.locator("#verbs .option").nth(0)).to_contain_text("Move")
    expect(page.locator("#verbs .option.unavailable").filter(has_text="Shout")).to_have_count(0)
    expect(page.locator(".unavailable-toggle")).to_contain_text("1 hidden")
    page.locator("#show-unavailable-actions").check()
    expect(page.locator("#verbs .option.unavailable").filter(has_text="Shout")).to_be_visible()
    expect(page.locator("#verbs")).to_contain_text("not enough focus points")


def filter_actions(page) -> None:
    page.locator("#action-filter").fill("ell")
    expect(page.locator("#verbs")).to_contain_text("Tell")
    expect(page.locator("#verbs")).not_to_contain_text("Move")
    page.locator("#action-filter-clear").click()
    expect(page.locator("#verbs")).to_contain_text("Remember")


def use_image_and_sheet_buttons(page) -> None:
    expect(page.locator("#btn-request-image")).to_contain_text("📷 Image")
    expect(page.locator("#btn-open-sheet")).to_contain_text("▣ Sheet")
    expect(page.locator("#target-label")).to_have_text("Target: none")
    expect(page.locator("#btn-clear-target")).to_be_disabled()

    with page.expect_response("**/play/claims/**/jobs"):
        page.locator("#btn-request-image").click()
    expect(page.locator("#activity")).to_contain_text("image requested")

    page.evaluate("() => { window.openedSheetUrl = ''; window.open = (url) => { window.openedSheetUrl = url; return {}; }; }")
    page.locator("#btn-open-sheet").click()
    opened = page.evaluate("() => window.openedSheetUrl")
    api_base = page.locator("#api-url").input_value().rstrip("/")
    expected_sheet = f"character.html?server={quote(api_base, safe='')}#{CHARACTER}"
    if opened != expected_sheet:
        raise AssertionError(f"sheet button opened wrong URL: {opened!r}")

    page.locator('#inventory .option[data-entity="item:1"]').click()
    expect(page.locator("#target-label")).to_have_text("Target: a brass key")
    expect(page.locator("#btn-clear-target")).to_be_enabled()
    page.locator("#btn-open-sheet").click()
    expect(page.locator("#activity")).to_contain_text("Select a visible character or clear the target.")
    page.locator("#btn-clear-target").click()
    expect(page.locator("#target-label")).to_have_text("Target: none")
    expect(page.locator("#btn-clear-target")).to_be_disabled()
    expect(page.locator('#inventory .option.selected[data-entity="item:1"]')).to_have_count(0)
    page.locator("#btn-open-sheet").click()
    opened = page.evaluate("() => window.openedSheetUrl")
    if opened != expected_sheet:
        raise AssertionError(f"sheet button did not fall back after clearing selection: {opened!r}")


def submit_tell(page, posted: list[dict]) -> None:
    page.locator("#action-filter").fill("tell")
    page.locator("#verbs .option").filter(has_text="Tell").click()
    page.locator("#action-form-dialog select.form-input").select_option(OTHER)
    page.locator("#action-form-dialog input.form-input").fill("psst")
    with page.expect_response("**/play/claims/*/commands"):
        page.locator("#action-form-dialog .form-submit").click()
    page.wait_for_function("() => !document.querySelector('#action-form-dialog')")
    if not posted:
        raise AssertionError("Web TUI did not post a command")
    expected = {
        "command_type": "tell",
        "payload": {"target_id": OTHER, "text": "psst"},
        "cost": {"action": 1, "focus": 1},
        "lane": "world",
        "on_insufficient_points": "queue",
    }
    if posted[-1] != expected:
        raise AssertionError(f"unexpected command body: {posted[-1]!r}")


def preselect_selected_target(page) -> None:
    page.locator(f'#members .option[data-entity="{OTHER}"]').click()
    page.locator("#action-filter").fill("tell")
    page.locator("#verbs .option").filter(has_text="Tell").click()
    overlay = page.locator("#action-form-dialog")
    overlay.wait_for(state="visible")
    expect(overlay.locator("select.form-input")).to_have_value(OTHER)
    page.keyboard.press("Escape")
    expect(overlay).to_have_count(0)


def preselect_inventory_target(page) -> None:
    page.locator(f'#members .option[data-entity="{OTHER}"]').click()
    expect(page.locator(f'#members .option.selected[data-entity="{OTHER}"]')).to_be_visible()
    page.locator('#inventory .option[data-entity="item:1"]').click()
    expect(page.locator('#inventory .option.selected[data-entity="item:1"]')).to_be_visible()
    expect(page.locator(f'#members .option.selected[data-entity="{OTHER}"]')).to_have_count(0)
    page.locator("#action-filter").fill("use")
    page.locator("#verbs .option").filter(has_text="Use Item").click()
    overlay = page.locator("#action-form-dialog")
    overlay.wait_for(state="visible")
    expect(overlay.locator("select.form-input")).to_have_value("item:1")
    page.keyboard.press("Escape")
    expect(overlay).to_have_count(0)
    page.locator("#action-filter-clear").click()


def update_fallback_and_release(page) -> None:
    page.locator("#btn-release-character").click()
    expect(page.locator("#claim-dialog")).to_be_visible()
    page.locator(".claim-advanced summary").click()
    page.locator("#claim-timeout").fill("17")
    with page.expect_response("**/play/claims/*"):
        page.locator("#claim-fallback").select_option("llm")
        page.locator("#btn-dialog-save-fallback").click()
    updates = page.exposed_fallback_updates
    if not updates or updates[-1]["fallback_controller"] != "llm" or updates[-1]["timeout_seconds"] != 1020:
        raise AssertionError(f"fallback settings were not posted: {updates!r}")

    with page.expect_response("**/play/claims/*"):
        page.locator("#btn-dialog-release-claim").click()
    expect(page.locator("#player-select")).to_have_value("")
    expect(page.locator("#btn-release-character")).to_be_disabled()
    expect(page.locator("#room-title")).to_have_text("Room")
    page.locator("#player-select").select_option(CHARACTER)
    page.wait_for_function(
        """(id) => (
            window.app?.projection?.characterId === id
            && window.app.projection.actions?.length > 0
        )""",
        arg=CHARACTER,
        timeout=15000,
    )


def click_door_queues_move(page, posted: list[dict]) -> None:
    with page.expect_response("**/play/claims/*/commands"):
        page.locator("#doors .option").first.click()
    if not posted or posted[-1]["command_type"] != "move":
        raise AssertionError(f"door click did not queue move: {posted!r}")
    if posted[-1]["payload"] != {"exit_id": EXIT}:
        raise AssertionError(f"door move payload wrong: {posted[-1]!r}")


def submit_unavailable(page, posted: list[dict]) -> None:
    page.locator("#action-filter").fill("shout")
    with page.expect_response("**/play/claims/*/commands"):
        page.locator("#verbs .option.unavailable").filter(has_text="Shout").click()
    if not posted or posted[-1]["command_type"] != "shout":
        raise AssertionError(f"unavailable action was not posted; posted={posted!r}")
    if posted[-1]["on_insufficient_points"] != "queue":
        raise AssertionError(f"unavailable action should still queue: {posted[-1]!r}")


def expire_and_reclaim(page) -> None:
    state = page.exposed_claim_state
    state["expired"] = True
    projection_requests = state["projection_requests"]
    page.evaluate("() => window.app.refresh()")
    expect(page.locator("#api-status")).to_contain_text("Claim expired")
    expect(page.locator("#btn-release-character")).to_contain_text("Play")
    page.wait_for_function("() => window.app?.control === null && window.app?.projection === null")
    stored = page.evaluate(
        "id => localStorage.getItem(`bunnyland.webTui.clientId.claim.${id}`)",
        CHARACTER,
    )
    if stored is not None:
        raise AssertionError(f"expired claim remained in local storage: {stored!r}")
    if state["projection_requests"] != projection_requests + 1:
        raise AssertionError(f"one refresh made duplicate projection requests: {state!r}")

    state["expired"] = False
    page.locator("#btn-release-character").click()
    with page.expect_response("**/play/claims"):
        page.locator("#btn-dialog-claim").click()
    page.wait_for_function(
        "id => window.app?.control?.claimId && window.app?.projection?.characterId === id",
        arg=CHARACTER,
    )
    if not state["methods"] or state["methods"][-1] != "POST":
        raise AssertionError(f"expired claim was not replaced with a fresh POST: {state!r}")


def assert_refresh_single_flight(page) -> None:
    state = page.exposed_claim_state
    before = {
        "character_requests": state["character_requests"],
        "event_requests": state["event_requests"],
        "projection_requests": state["projection_requests"],
    }
    page.evaluate("() => Promise.all([window.app.refresh(), window.app.refresh(), window.app.refresh()])")
    after = {
        "character_requests": state["character_requests"],
        "event_requests": state["event_requests"],
        "projection_requests": state["projection_requests"],
    }
    expected = {key: value + 1 for key, value in before.items()}
    if after != expected:
        raise AssertionError(f"concurrent refreshes were not single-flight: before={before!r} after={after!r}")


def narrate_event(page) -> None:
    EVENTS["events"] = [
        {
            "event_type": "CommandRejectedEvent",
            "data": {
                "event_type": "CommandRejectedEvent",
                "event": {
                    "event_id": "event-rejected-1",
                    "visibility": "directed",
                    "actor_id": CHARACTER,
                    "reason": "too tired",
                },
            },
        }
    ]
    page.evaluate("() => window.app.refresh()")
    expect(page.locator("#activity")).to_contain_text("too tired")
    expect(page.locator("#activity .activity-row").filter(has_text="too tired")).to_be_visible()
    expect(page.locator("#activity .option")).to_have_count(0)
    row_width = page.locator("#activity .activity-row").filter(has_text="too tired").evaluate(
        "row => row.getBoundingClientRect().width"
    )
    pane_width = page.locator("#activity").evaluate("pane => pane.getBoundingClientRect().width")
    if row_width < pane_width * 0.9:
        raise AssertionError(f"activity row collapsed: row={row_width}, pane={pane_width}")


def cancel_queued_command(page) -> None:
    with page.expect_response("**/play/claims/*/commands/*"):
        page.locator('#queued .option[data-cancel-command="queued-1"]').click()
    deleted = page.exposed_deleted_commands
    if (
        not deleted
        or f"/claims/{CLAIM_ID}/commands/queued-1" not in deleted[-1]
    ):
        raise AssertionError(f"queued command was not cancelled with controller identity: {deleted!r}")


def main() -> None:
    ensure_web_server(BASE_URL)
    SCREENSHOT_DIR.mkdir(parents=True, exist_ok=True)
    with sync_playwright() as playwright:
        coverage = PlaywrightCoverage("web-tui")
        browser = launch_browser(playwright)
        page = coverage.new_page(browser, viewport={"width": 1280, "height": 800})
        posted: list[dict] = []
        install_routes(page, posted)

        connect_and_select(page)
        assert_refresh_single_flight(page)
        use_image_and_sheet_buttons(page)
        filter_actions(page)
        preselect_selected_target(page)
        preselect_inventory_target(page)
        update_fallback_and_release(page)
        narrate_event(page)
        cancel_queued_command(page)
        click_door_queues_move(page, posted)
        submit_unavailable(page, posted)
        submit_tell(page, posted)
        expire_and_reclaim(page)
        layout = page.evaluate(
            """
            () => {
              const app = document.getElementById('app');
              const actions = document.getElementById('verbs');
              return {
                appHeight: Math.round(app.getBoundingClientRect().height),
                viewportHeight: window.innerHeight,
                actionsOverflow: getComputedStyle(actions).overflowY,
              };
            }
            """
        )
        if layout["appHeight"] != layout["viewportHeight"] or layout["actionsOverflow"] != "auto":
            raise AssertionError(f"TUI viewport is not bounded: {layout!r}")
        page.screenshot(path=str(SCREENSHOT_DIR / "bunnyland-web-tui.png"))
        coverage.close_browser(browser)

    print("web_tui=ok")


if __name__ == "__main__":
    main()
