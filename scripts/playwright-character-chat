#!/usr/bin/env python3
"""Playwright regression test for the Bunnyland character chat page."""

from __future__ import annotations

import json
import os
import re
import shutil
from pathlib import Path

from playwright.sync_api import expect, sync_playwright

from playwright_coverage import PlaywrightCoverage
from playwright_server import ensure_web_server


BASE_URL = os.environ.get("BUNNYLAND_WEB_BASE_URL", "http://127.0.0.1:8091").rstrip("/")
SCREENSHOT_DIR = Path(os.environ.get("BUNNYLAND_PLAYWRIGHT_SCREENSHOT_DIR", "/tmp"))
CLIENT_ID = "character-chat-client-1"
CHARACTER = "character:1"
OTHER = "character:2"
HISTORY_KEY = f"bunnyland.characterChat.history.{CLIENT_ID}.{CHARACTER}"


def launch_browser(playwright):
    chrome = (
        os.environ.get("BUNNYLAND_CHROME")
        or shutil.which("google-chrome")
        or shutil.which("chromium")
        or shutil.which("chromium-browser")
    )
    kwargs = {"headless": True}
    if chrome:
        kwargs["executable_path"] = chrome
        kwargs["args"] = ["--no-sandbox"]
    return playwright.chromium.launch(**kwargs)


def json_route(body):
    def handler(route):
        route.fulfill(status=200, content_type="application/json", body=json.dumps(body))

    return handler


def install_routes(page, posted: list[dict]) -> None:
    page.route(
        "**/world/chat/status",
        json_route(
            {
                "ok": True,
                "schema_version": 1,
                "world_epoch": 9,
                "enabled": True,
                "allowed_tools": [
                    "forget",
                    "inspect",
                    "look",
                    "reflect",
                    "remember",
                    "say",
                    "take_note",
                    "tell",
                    "wait",
                ],
            }
        ),
    )
    page.route(
        "**/world/characters",
        json_route(
            {
                "world_epoch": 9,
                "characters": [
                    {"character_id": CHARACTER, "name": "Juniper", "kind": "character"},
                    {"character_id": OTHER, "name": "Hazel", "kind": "character"},
                ],
            }
        ),
    )
    page.route(
        "**/world/character/character%3A1",
        json_route(
            {
                "ok": True,
                "schema_version": 1,
                "world_epoch": 9,
                "character_id": CHARACTER,
                "character_name": "Juniper",
                "can_perceive": True,
                "portrait": {"url": "/media/portraits/juniper.png", "alpha_url": ""},
                "room": {},
                "inventory": [],
                "points": {},
                "controller": None,
                "sheet": {},
                "target_groups": {},
                "actions": [],
            }
        ),
    )
    page.route(
        "**/world/character/character%3A2",
        json_route(
            {
                "ok": True,
                "schema_version": 1,
                "world_epoch": 9,
                "character_id": OTHER,
                "character_name": "Hazel",
                "can_perceive": True,
                "portrait": {"url": "/media/portraits/hazel.png", "alpha_url": ""},
                "room": {},
                "inventory": [],
                "points": {},
                "controller": None,
                "sheet": {},
                "target_groups": {},
                "actions": [],
            }
        ),
    )
    page.route(
        "**/api/media/portraits/*.png",
        lambda route: route.fulfill(
            status=200,
            content_type="image/svg+xml",
            body=(
                "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'>"
                "<rect width='100' height='100' fill='#313244'/>"
                "<circle cx='50' cy='38' r='20' fill='#89b4fa'/>"
                "<path d='M18 96c8-26 56-26 64 0z' fill='#cba6f7'/>"
                "</svg>"
            ),
        ),
    )

    def pending_handler(route):
        route.fulfill(
            status=200,
            content_type="application/json",
            body=json.dumps(
                {
                    "ok": True,
                    "schema_version": 1,
                    "world_epoch": 11,
                    "character_id": CHARACTER,
                    "command_id": "cmd-remember-1",
                    "complete": True,
                    "reply": "I remember the greenhouse warning.",
                    "action": {
                        "tool": "remember",
                        "command_id": "cmd-remember-1",
                        "status": "executed",
                        "result_events": [
                            {
                                "event_type": "NotesSearchedEvent",
                                "results": ["greenhouse warning"],
                            }
                        ],
                    },
                }
            ),
        )

    page.route("**/world/character/*/chat/pending/*", pending_handler)

    def chat_handler(route):
        payload = json.loads(route.request.post_data or "{}")
        reply = f"reply to {payload['message']}"
        action = {"tool": "look", "status": "executed"}
        if payload.get("message") == "markdown":
            reply = (
                "**bold reply** with `code` and [safe link](https://example.test/path).\n\n"
                "<img src=x onerror=alert(1)> should stay text.\n\n"
                "[unsafe](javascript:alert(1)) should not become a link.\n\n"
                "```html\n<b>literal</b>\n```"
            )
        elif payload.get("message") == "queued":
            reply = "I will try that when I can."
            action = {
                "tool": "remember",
                "command_id": "cmd-remember-1",
                "status": "queued",
            }
        posted.append(
            {
                "url": route.request.url,
                "payload": payload,
            }
        )
        route.fulfill(
            status=200,
            content_type="application/json",
            body=json.dumps(
                {
                    "ok": True,
                    "schema_version": 1,
                    "world_epoch": 10,
                    "character_id": CHARACTER,
                    "reply": reply,
                    "action": action,
                }
            ),
        )

    page.route("**/world/character/*/chat", chat_handler)


def connect(page) -> None:
    page.goto(f"{BASE_URL}/character-chat.html", wait_until="domcontentloaded")
    page.locator("#api-url").fill("/api")
    page.locator("#btn-connect").click()
    page.wait_for_function("() => document.querySelectorAll('.character-row').length === 2")
    expect(page.locator("#api-status")).to_contain_text("Live")
    expect(page.locator("#character-list")).to_contain_text("Juniper")
    expect(page.locator("#character-list")).to_contain_text("Hazel")
    expect(page.locator("#chat-title")).to_contain_text("No character selected")
    expect(page.locator("#chat-tool-list")).to_contain_text("Tools: forget, inspect")
    expect(page.locator("#selected-character")).to_be_hidden()
    expect(page.locator("#transcript")).to_contain_text("Pick a character to start chatting.")
    page.locator("#character-filter").fill("hazel")
    expect(page.locator("#character-list")).not_to_contain_text("Juniper")
    expect(page.locator("#character-list")).to_contain_text("Hazel")
    page.locator("#character-filter-clear").click()
    expect(page.locator("#character-list")).to_contain_text("Juniper")
    expect(page.locator("#character-list")).to_contain_text("Hazel")
    page.locator(f'.character-row[data-id="{CHARACTER}"]').click()
    expect(page.locator("#status-line")).to_contain_text("Chatting with Juniper")
    expect(page.locator("#selected-character")).to_be_visible()
    expect(page.locator("#chat-portrait-frame img")).to_have_attribute(
        "src", re.compile(r"/api/media/portraits/juniper\.png$")
    )


def submit_message(page, text: str) -> None:
    page.locator("#chat-input").fill(text)
    with page.expect_response("**/world/character/*/chat"):
        page.locator("#btn-send").click()


def submit_message_with_enter(page, text: str) -> None:
    page.locator("#chat-input").fill(text)
    with page.expect_response("**/world/character/*/chat"):
        page.locator("#chat-input").press("Enter")


def assert_initial_send_and_persistence(page, posted: list[dict]) -> None:
    submit_message(page, "hello")
    expect(page.locator("#transcript")).to_contain_text("hello")
    expect(page.locator("#transcript")).to_contain_text("reply to hello")
    expect(page.locator("#status-line")).to_contain_text("look: executed")
    expect(page.locator(".action-message.executed")).to_contain_text("look")
    expect(page.locator(f'.character-row[data-id="{CHARACTER}"].has-history')).to_have_count(1)
    expect(page.locator(f'.character-row[data-id="{CHARACTER}"] .history-icon')).to_contain_text("●")
    assert posted[-1]["url"].endswith("/play/world/character/character%3A1/chat")
    payload = posted[-1]["payload"]
    if payload["client_id"] != CLIENT_ID or payload["history"] != []:
        raise AssertionError(f"unexpected initial chat payload: {payload!r}")
    state = page.evaluate(
        """(key) => JSON.parse(localStorage.getItem(key))""",
        HISTORY_KEY,
    )
    if state["messages"][-3:] != [
        {"role": "user", "text": "hello"},
        {"role": "character", "text": "reply to hello"},
        {
            "role": "action",
            "text": "look finished.",
            "command_id": "",
            "action": {"tool": "look", "status": "executed"},
        },
    ]:
        raise AssertionError(f"chat history was not persisted: {state!r}")


def assert_clear_history_button(page, posted: list[dict]) -> None:
    expect(page.locator("#btn-clear-history")).to_be_enabled()
    page.locator("#btn-clear-history").click()
    expect(page.locator("#transcript")).to_contain_text("No local chat history")
    expect(page.locator("#status-line")).to_contain_text("Cleared local chat history for Juniper.")
    expect(page.locator("#btn-clear-history")).to_be_disabled()
    expect(page.locator(f'.character-row[data-id="{CHARACTER}"].has-history')).to_have_count(0)
    if page.evaluate("(key) => localStorage.getItem(key)", HISTORY_KEY) is not None:
        raise AssertionError("clear history did not remove the selected character's local state")

    submit_message(page, "after clear")
    payload = posted[-1]["payload"]
    if payload["history"] != [] or payload["history_summary"] != "":
        raise AssertionError(f"cleared chat still sent stale history: {payload!r}")
    expect(page.locator("#btn-clear-history")).to_be_enabled()


def assert_keyboard_submit_behavior(page, posted: list[dict]) -> None:
    page.locator("#chat-input").fill("line one")
    page.locator("#chat-input").press("Shift+Enter")
    page.locator("#chat-input").type("line two")
    if page.locator("#chat-input").input_value() != "line one\nline two":
        raise AssertionError("Shift+Enter did not insert a newline")
    before = len(posted)
    submit_message_with_enter(page, "enter submit")
    if len(posted) != before + 1:
        raise AssertionError("Enter did not submit the current chat message")
    if posted[-1]["payload"]["message"] != "enter submit":
        raise AssertionError(f"Enter submitted the wrong payload: {posted[-1]['payload']!r}")
    if page.locator("#chat-input").input_value() != "":
        raise AssertionError("Enter submit did not clear the composer")


def assert_queued_action_block_and_followup(page) -> None:
    submit_message(page, "queued")
    action = page.locator('.action-message[data-command-id="cmd-remember-1"]')
    expect(action).to_contain_text("remember")
    expect(action).to_contain_text("queued as a game action")
    expect(action.locator(".action-icon")).to_contain_text("🧠")
    expect(page.locator("#status-line")).to_contain_text("remember: queued")
    page.wait_for_function(
        """() => document.querySelector('[data-command-id="cmd-remember-1"]')?.classList.contains('executed')""",
        timeout=5000,
    )
    expect(action).to_contain_text("finished")
    expect(page.locator("#transcript")).to_contain_text("I remember the greenhouse warning.")


def assert_markdown_rendering_without_html(page) -> None:
    submit_message(page, "markdown")
    expect(page.locator("#markdown-toggle")).to_be_checked()
    expect(page.locator("#transcript .message strong", has_text="bold reply")).to_contain_text(
        "bold reply"
    )
    expect(page.locator("#transcript code").first).to_contain_text("code")
    expect(page.locator('#transcript a[href="https://example.test/path"]')).to_contain_text(
        "safe link"
    )
    expect(page.locator("#transcript")).to_contain_text("<img src=x onerror=alert(1)>")
    expect(page.locator("#transcript pre code")).to_contain_text("<b>literal</b>")
    if page.locator("#transcript img").count() != 0:
        raise AssertionError("raw HTML image tag was rendered in chat transcript")
    if page.locator("#transcript a[href^='javascript:']").count() != 0:
        raise AssertionError("unsafe javascript URL was rendered in chat transcript")
    page.locator("#markdown-toggle").uncheck()
    expect(page.locator("#transcript")).to_contain_text("**bold reply**")
    expect(page.locator("#transcript")).to_contain_text("[safe link](https://example.test/path)")
    if page.locator("#transcript .message strong").count() != 0:
        raise AssertionError("markdown strong tag remained after disabling markdown rendering")
    if page.locator("#transcript .message a").count() != 0:
        raise AssertionError("markdown links remained after disabling markdown rendering")
    if page.locator("#transcript .message img").count() != 0:
        raise AssertionError("raw HTML image tag was rendered with markdown disabled")
    if page.evaluate("() => localStorage.getItem('bunnyland.characterChat.markdown')") != "0":
        raise AssertionError("markdown toggle preference was not persisted")
    page.locator("#markdown-toggle").check()
    expect(page.locator("#transcript .message strong", has_text="bold reply")).to_contain_text(
        "bold reply"
    )


def assert_bounded_history_payload(page, posted: list[dict]) -> None:
    page.evaluate(
        """(key) => {
          const messages = Array.from({ length: 30 }, (_, index) => ({
            role: index % 2 === 0 ? 'user' : 'character',
            text: `old ${index}`,
          }));
          localStorage.setItem(key, JSON.stringify({ summary: 'old summary', messages }));
        }""",
        HISTORY_KEY,
    )
    submit_message(page, "bounded")
    payload = posted[-1]["payload"]
    if payload["history_summary"] != "old summary" or len(payload["history"]) != 24:
        raise AssertionError(f"bounded history payload was wrong: {payload!r}")
    if payload["history"][0]["text"] != "old 6" or payload["history"][-1]["text"] != "old 29":
        raise AssertionError(f"bounded history window was wrong: {payload['history']!r}")


def assert_character_selection(page, posted: list[dict]) -> None:
    page.locator(f'.character-row[data-id="{OTHER}"]').click()
    expect(page.locator("#status-line")).to_contain_text("Chatting with Hazel")
    expect(page.locator("#transcript")).to_contain_text("No local chat history")
    expect(page.locator("#chat-portrait-frame img")).to_have_attribute(
        "src", re.compile(r"/api/media/portraits/hazel\.png$")
    )
    submit_message(page, "hazel hello")
    if not posted[-1]["url"].endswith("/play/world/character/character%3A2/chat"):
        raise AssertionError(f"Hazel chat used wrong URL: {posted[-1]['url']!r}")
    expect(page.locator("#transcript")).to_contain_text("hazel hello")
    expect(page.locator("#transcript")).to_contain_text("reply to hazel hello")
    expect(page.locator(f'.character-row[data-id="{OTHER}"].has-history')).to_have_count(1)


def assert_desktop_viewport(page) -> None:
    layout = page.evaluate(
        """
        () => {
          const app = document.getElementById('app');
          const transcript = document.getElementById('transcript');
          return {
            appHeight: Math.round(app.getBoundingClientRect().height),
            viewportHeight: window.innerHeight,
            transcriptOverflow: getComputedStyle(transcript).overflowY,
          };
        }
        """
    )
    if layout["appHeight"] != layout["viewportHeight"] or layout["transcriptOverflow"] != "auto":
        raise AssertionError(f"character chat viewport is not bounded: {layout!r}")


def assert_mobile_layout(page) -> None:
    page.set_viewport_size({"width": 390, "height": 760})
    page.wait_for_timeout(100)
    main_grid = page.locator("#main").evaluate(
        "node => getComputedStyle(node).gridTemplateColumns"
    )
    if "," in main_grid or len(main_grid.split()) > 1:
        raise AssertionError(f"mobile chat layout still has multiple columns: {main_grid!r}")
    input_box = page.locator("#chat-input").bounding_box()
    send_box = page.locator("#btn-send").bounding_box()
    if not input_box or not send_box or input_box["x"] + input_box["width"] > send_box["x"]:
        raise AssertionError("mobile composer controls overlap")


def main() -> None:
    ensure_web_server(BASE_URL)
    SCREENSHOT_DIR.mkdir(parents=True, exist_ok=True)
    with sync_playwright() as playwright:
        coverage = PlaywrightCoverage("character-chat")
        browser = launch_browser(playwright)
        page = coverage.new_page(browser, viewport={"width": 1280, "height": 800})
        page.add_init_script(
            f"""
            localStorage.setItem('bunnyland.clientMenu.seen', '1');
            localStorage.setItem('bunnyland.characterChat.clientId', {json.dumps(CLIENT_ID)});
            """
        )
        posted: list[dict] = []
        install_routes(page, posted)

        connect(page)
        assert_initial_send_and_persistence(page, posted)
        assert_clear_history_button(page, posted)
        assert_keyboard_submit_behavior(page, posted)
        assert_queued_action_block_and_followup(page)
        assert_markdown_rendering_without_html(page)
        assert_bounded_history_payload(page, posted)
        assert_character_selection(page, posted)
        assert_desktop_viewport(page)
        assert_mobile_layout(page)
        page.screenshot(path=str(SCREENSHOT_DIR / "bunnyland-character-chat.png"))
        coverage.close_browser(browser)

    print("character_chat=ok")


if __name__ == "__main__":
    main()
