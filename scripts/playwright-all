#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == "--coverage" ]]; then
  export BUNNYLAND_PLAYWRIGHT_COVERAGE=1
  shift
fi
if [[ "${CI:-}" == "true" && -z "${BUNNYLAND_PLAYWRIGHT_COVERAGE:-}" ]]; then
  export BUNNYLAND_PLAYWRIGHT_COVERAGE=1
fi

PORT="${BUNNYLAND_WEB_PORT:-8091}"
BASE_URL="${BUNNYLAND_WEB_BASE_URL:-http://127.0.0.1:${PORT}}"
export BUNNYLAND_WEB_BASE_URL="${BASE_URL}"
export PYTHONDONTWRITEBYTECODE=1
export BUNNYLAND_PLAYWRIGHT_COVERAGE_DIR="${BUNNYLAND_PLAYWRIGHT_COVERAGE_DIR:-artifacts/playwright-coverage}"
test_report_dir="${BUNNYLAND_WEB_TEST_REPORT_DIR:-artifacts/test-results}"
mkdir -p "$test_report_dir"

server_pid=""
if [[ "${BUNNYLAND_WEB_NO_SERVER:-0}" != "1" ]]; then
  if ! curl -fsS "${BASE_URL}/index.html" >/dev/null 2>&1; then
    ./serve.sh "${PORT}" >/tmp/bunnyland-web-playwright-server.log 2>&1 &
    server_pid="$!"
    for _ in {1..50}; do
      if curl -fsS "${BASE_URL}/index.html" >/dev/null 2>&1; then
        break
      fi
      sleep 0.1
    done
    if ! curl -fsS "${BASE_URL}/index.html" >/dev/null 2>&1; then
      echo "Timed out waiting for ${BASE_URL}" >&2
      exit 1
    fi
  fi
fi

cleanup() {
  if [[ -n "${server_pid}" ]]; then
    kill "${server_pid}" >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT

failures=0
run_regression() {
  local name="$1"
  shift
  local log_file="${test_report_dir}/${name}.log"
  local xml_file="${test_report_dir}/${name}.xml"
  local started
  local finished
  local elapsed
  started="$(date +%s)"
  if "$@" >"$log_file" 2>&1; then
    cat "$log_file"
    finished="$(date +%s)"
    elapsed=$((finished - started))
    python3 scripts/ci_report.py write-case \
      --output "$xml_file" \
      --suite "$name" \
      --name "$name" \
      --status passed \
      --time "$elapsed" \
      --log-file "$log_file"
  else
    cat "$log_file"
    finished="$(date +%s)"
    elapsed=$((finished - started))
    python3 scripts/ci_report.py write-case \
      --output "$xml_file" \
      --suite "$name" \
      --name "$name" \
      --status failed \
      --time "$elapsed" \
      --log-file "$log_file"
    failures=$((failures + 1))
  fi
}

run_regression inspector scripts/playwright-inspector
run_regression world-generator scripts/playwright-world-generator
run_regression world-editor-toolbar scripts/playwright-world-editor-toolbar
run_regression world-editor scripts/playwright-world-editor
run_regression character-memory scripts/playwright-character-memory
run_regression script-editor scripts/playwright-script-editor
run_regression behavior-editor scripts/playwright-behavior-editor
run_regression discord-link scripts/playwright-discord-link
run_regression toon-action-form scripts/playwright-toon-action-form
run_regression character scripts/playwright-character
run_regression web-tui scripts/playwright-web-tui
run_regression web-repl scripts/playwright-web-repl
run_regression event-stream scripts/playwright-event-stream
run_regression trace-analyzer scripts/playwright-trace-analyzer
run_regression responsive scripts/playwright-responsive

if [[ "${BUNNYLAND_PLAYWRIGHT_COVERAGE:-0}" == "1" ]]; then
  python3 scripts/playwright_coverage.py "${BUNNYLAND_PLAYWRIGHT_COVERAGE_DIR}"
fi

if (( failures > 0 )); then
  exit 1
fi
