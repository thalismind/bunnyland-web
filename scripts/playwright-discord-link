#!/usr/bin/env python3
"""Playwright checks for the deployment Discord link surfaced from config.json.

The frontend renders config.json from its environment at container start; a configured
``discordUrl`` should appear on the welcome page hero button and in the shared client
menu footer, and should be absent when no URL is configured. This test mocks config.json
with Playwright route interception so it does not depend on a deployed value.
"""

from pathlib import Path
import json
import os
import shutil

from playwright.sync_api import sync_playwright

from playwright_coverage import PlaywrightCoverage
from playwright_server import ensure_web_server


BASE_URL = os.environ.get("BUNNYLAND_WEB_BASE_URL", "http://127.0.0.1:8091").rstrip("/")
SCREENSHOT_DIR = Path(os.environ.get("BUNNYLAND_PLAYWRIGHT_SCREENSHOT_DIR", "/tmp"))
DISCORD_URL = "https://discord.gg/bunnyland-example"


def launch_browser(playwright):
    chrome = (
        os.environ.get("BUNNYLAND_CHROME")
        or shutil.which("google-chrome")
        or shutil.which("chromium")
        or shutil.which("chromium-browser")
    )
    kwargs = {"headless": True}
    if chrome:
        kwargs["executable_path"] = chrome
        kwargs["args"] = ["--no-sandbox"]
    return playwright.chromium.launch(**kwargs)


def mock_config(page, discord_url: str) -> None:
    body = json.dumps(
        {"serverUrl": "/api/", "autoConnect": False, "discordUrl": discord_url}
    )
    page.route(
        "**/config.json",
        lambda route: route.fulfill(
            status=200, content_type="application/json", body=body
        ),
    )


def check_present(page) -> None:
    mock_config(page, DISCORD_URL)
    page.add_init_script(
        """
        window.__clipboardWrites = [];
        Object.defineProperty(navigator, 'clipboard', {
          configurable: true,
          value: { writeText: async (text) => window.__clipboardWrites.push(String(text)) },
        });
        """
    )
    page.goto(f"{BASE_URL}/index.html", wait_until="networkidle")

    hero = page.locator("#discord-link")
    hero.wait_for(state="visible")
    if hero.get_attribute("href") != DISCORD_URL:
        raise AssertionError("welcome hero Discord button has the wrong href")

    page.locator("#btn-client-menu").click()
    footer = page.locator(".client-menu-discord")
    footer.wait_for(state="visible")
    if footer.get_attribute("href") != DISCORD_URL:
        raise AssertionError("client menu Discord link has the wrong href")
    page.keyboard.press("Escape")

    page.locator('[data-copy="cmd-tui"]').click()
    page.locator('[data-copy="cmd-tui"]').wait_for()
    writes = page.evaluate("window.__clipboardWrites")
    expected_copy = f"uv run --extra tui bunnyland-tui --server {BASE_URL}/api"
    if writes != [expected_copy]:
        raise AssertionError(f"welcome copy button wrote unexpected text: {writes!r}")
    if page.locator('[data-copy="cmd-tui"]').text_content() != "Copied":
        raise AssertionError("welcome copy button did not show copied feedback")


def check_absent(page) -> None:
    mock_config(page, "")
    page.goto(f"{BASE_URL}/index.html", wait_until="networkidle")

    if page.locator("#discord-link").is_visible():
        raise AssertionError("welcome hero Discord button should stay hidden when unset")
    page.locator("#btn-client-menu").click()
    page.locator(".client-menu-item").first.wait_for()
    if page.locator(".client-menu-discord").count() != 0:
        raise AssertionError("client menu Discord link should be absent when unset")


def main() -> None:
    ensure_web_server(BASE_URL)
    with sync_playwright() as playwright:
        coverage = PlaywrightCoverage("discord-link")
        browser = launch_browser(playwright)

        present = coverage.new_page(browser, viewport={"width": 1280, "height": 720})
        check_present(present)
        coverage.close_page(present)

        absent = coverage.new_page(browser, viewport={"width": 1280, "height": 720})
        check_absent(absent)
        coverage.close_page(absent)

        coverage.close_browser(browser)

    print("discord_link=ok")


if __name__ == "__main__":
    main()
