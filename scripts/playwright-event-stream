#!/usr/bin/env python3
"""Playwright regression test for the Bunnyland event stream admin page."""

from __future__ import annotations

import json
import os
import shutil
from pathlib import Path

from playwright.sync_api import expect, sync_playwright

from playwright_coverage import PlaywrightCoverage
from playwright_server import ensure_web_server


BASE_URL = os.environ.get("BUNNYLAND_WEB_BASE_URL", "http://127.0.0.1:8091").rstrip("/")
SCREENSHOT_DIR = Path(os.environ.get("BUNNYLAND_PLAYWRIGHT_SCREENSHOT_DIR", "/tmp"))


def launch_browser(playwright):
    chrome = (
        os.environ.get("BUNNYLAND_CHROME")
        or shutil.which("google-chrome")
        or shutil.which("chromium")
        or shutil.which("chromium-browser")
    )
    kwargs = {"headless": True}
    if chrome:
        kwargs["executable_path"] = chrome
        kwargs["args"] = ["--no-sandbox"]
    return playwright.chromium.launch(**kwargs)


def snapshot_payload() -> dict:
    return {
        "ok": True,
        "schema_version": 1,
        "world_epoch": 120,
        "entities": [
            {
                "id": "char-pip",
                "prefab": "entity",
                "components": {
                    "CharacterComponent": {"species": "homunculus", "biography": "", "public": True},
                    "IdentityComponent": {"name": "Pip Crucible", "kind": "character", "tags": []},
                },
                "relationships": {},
            },
            {
                "id": "char-eloise",
                "prefab": "entity",
                "components": {
                    "CharacterComponent": {"species": "ghost", "biography": "", "public": True},
                    "IdentityComponent": {"name": "Eloise Drowned", "kind": "character", "tags": []},
                },
                "relationships": {},
            },
            {
                "id": "room-vault",
                "prefab": "entity",
                "components": {
                    "RoomComponent": {"title": "Hidden Vault", "biome": "laboratory", "indoor": True},
                },
                "relationships": {},
            },
        ],
    }


def recent_events_payload() -> dict:
    return {
        "events": [
            {
                "type": "event",
                "data": {
                    "event_type": "EntitySeenEvent",
                    "event": {
                        "event_id": "event-seen",
                        "world_epoch": 100,
                        "created_at": "2026-06-24T17:00:00Z",
                        "visibility": "private",
                        "actor_id": "char-pip",
                        "room_id": "room-vault",
                        "target_ids": ["char-eloise"],
                        "entity_id": "char-eloise",
                    },
                },
            },
            {
                "type": "event",
                "data": {
                    "event_type": "SpeechSaidEvent",
                    "event": {
                        "event_id": "event-speech",
                        "world_epoch": 105,
                        "created_at": "2026-06-24T17:00:05Z",
                        "visibility": "room",
                        "actor_id": "char-pip",
                        "room_id": "room-vault",
                        "target_ids": ["char-eloise"],
                        "text": "Eloise, did the black fern letter mention ownership?",
                    },
                },
            },
            {
                "type": "event",
                "data": {
                    "event_type": "CommandExecutedEvent",
                    "event": {
                        "event_id": "event-command",
                        "world_epoch": 110,
                        "created_at": "2026-06-24T17:00:10Z",
                        "visibility": "system",
                        "actor_id": "char-pip",
                        "room_id": "room-vault",
                        "target_ids": ["char-eloise"],
                        "command_id": "cmd-say",
                        "command_type": "say",
                        "payload": {"target_id": "char-eloise"},
                        "result_events": [
                            {
                                "event_type": "SpeechSaidEvent",
                                "actor_id": "char-pip",
                                "target_ids": ["char-eloise"],
                            }
                        ],
                    },
                },
            },
        ]
    }


def route_api(page) -> None:
    page.route(
        "**/mock/world/snapshot",
        lambda route: route.fulfill(
            status=200,
            content_type="application/json",
            body=json.dumps(snapshot_payload()),
        ),
    )
    page.route(
        "**/mock/world/events/recent",
        lambda route: route.fulfill(
            status=200,
            content_type="application/json",
            body=json.dumps(recent_events_payload()),
        ),
    )
    page.route(
        "**/config.json",
        lambda route: route.fulfill(status=200, content_type="application/json", body="{}"),
    )


def test_event_stream(page) -> None:
    route_api(page)
    page.goto(f"{BASE_URL}/event-stream.html?server=/mock", wait_until="networkidle")

    expect(page.locator("#api-status")).to_contain_text("connected")
    expect(page.locator("#total-events")).to_have_text("3")
    expect(page.locator("#visible-count")).to_have_text("2")
    expect(page.locator("#event-list .event-record")).to_have_count(2)
    expect(page.locator("#event-list")).to_contain_text("Pip Crucible")
    expect(page.locator("#event-list")).to_contain_text("Eloise, did the black fern letter")

    page.locator("#event-list .event-record").first.locator("summary").click()
    expect(page.locator("#event-list .event-record").first.locator(".event-detail")).to_contain_text("Eloise Drowned")
    expect(page.locator("#event-list .event-record").first.locator(".json-view")).to_contain_text("SpeechSaidEvent")

    page.locator("#hide-routine").uncheck()
    expect(page.locator("#event-list .event-record")).to_have_count(3)
    page.locator("#event-type-filter").select_option("CommandExecutedEvent")
    expect(page.locator("#event-list .event-record")).to_have_count(1)
    expect(page.locator("#event-list")).to_contain_text("executed say")

    page.locator("#event-search").fill("black fern")
    expect(page.locator("#event-list")).to_contain_text("No matching events")
    page.locator("#event-type-filter").select_option("")
    expect(page.locator("#event-list .event-record")).to_have_count(1)

    page.locator("#btn-client-menu").click()
    active = page.locator(".client-menu-item.active")
    expect(active).to_contain_text("Event Stream")
    href = active.get_attribute("href") or ""
    if not href.startswith("event-stream.html"):
        raise AssertionError(f"active menu item is {href!r}")


def main() -> None:
    ensure_web_server(BASE_URL)
    SCREENSHOT_DIR.mkdir(parents=True, exist_ok=True)
    with sync_playwright() as playwright:
        coverage = PlaywrightCoverage("event-stream")
        browser = launch_browser(playwright)
        page = coverage.new_page(browser, viewport={"width": 1280, "height": 800})
        test_event_stream(page)
        page.screenshot(path=str(SCREENSHOT_DIR / "bunnyland-event-stream.png"))
        coverage.close_browser(browser)


if __name__ == "__main__":
    main()
