#!/usr/bin/env python3
"""Responsive shell and pane regressions for the Vite web clients."""

from pathlib import Path
import os
import shutil

from playwright.sync_api import sync_playwright

from playwright_coverage import PlaywrightCoverage
from playwright_server import ensure_web_server


BASE_URL = os.environ.get("BUNNYLAND_WEB_BASE_URL", "http://127.0.0.1:8091").rstrip("/")
SCREENSHOT_DIR = Path(os.environ.get("BUNNYLAND_WEB_SCREENSHOT_DIR", "/tmp"))
FULL_SCREEN_PAGES = (
    "behavior-editor.html",
    "character-memory.html",
    "character.html",
    "event-stream.html",
    "inspector.html",
    "script-editor.html",
    "toon-client.html",
    "trace-analyzer.html",
    "web-repl.html",
    "web-tui.html",
    "world-editor.html",
    "world-generator.html",
)
STACKS = {
    "behavior-editor.html": ("#library-pane", "#editor-pane", "#preview-pane"),
    "character-memory.html": ("#characters-pane", "#documents-pane", "#editor-pane"),
    "script-editor.html": ("#library-pane", "#editor-pane", "#preview-pane"),
    "world-generator.html": ("#main > .pane:nth-child(1)", "#main > .pane:nth-child(2)", "#entity-pane"),
    "world-editor.html": ("#main > .pane:nth-child(1)", "#main > .pane:nth-child(2)", "#preview-pane"),
}
LANDSCAPE_PAGES = ("character.html", "toon-client.html", "web-repl.html", "web-tui.html")
PLAYER_BOTTOM_PANES = {
    "character.html": "#details-pane",
    "toon-client.html": "#actions",
    "web-repl.html": "#side-pane",
}


def launch_browser(playwright):
    chrome = (
        os.environ.get("BUNNYLAND_CHROME")
        or shutil.which("google-chrome")
        or shutil.which("chromium")
        or shutil.which("chromium-browser")
    )
    kwargs = {"headless": True}
    if chrome:
        kwargs["executable_path"] = chrome
        kwargs["args"] = ["--no-sandbox"]
    return playwright.chromium.launch(**kwargs)


def assert_shell(page, name: str) -> None:
    page.locator("#app").wait_for()
    layout = page.evaluate(
        """
        () => {
          const app = document.querySelector('#app');
          const toolbar = document.querySelector('#toolbar, .bl-toolbar');
          const panes = [...document.querySelectorAll('.pane, #sidebar, #identity-pane, #details-pane, #actions-pane, #side-pane')]
            .filter((pane) => getComputedStyle(pane).display !== 'none')
            .map((pane) => {
              const rect = pane.getBoundingClientRect();
              return { id: pane.id, left: rect.left, right: rect.right, width: rect.width };
            });
          return {
            appHeight: app.getBoundingClientRect().height,
            viewportHeight: innerHeight,
            viewportWidth: innerWidth,
            scrollWidth: Math.max(document.documentElement.scrollWidth, document.body.scrollWidth),
            toolbarClientWidth: toolbar?.clientWidth || 0,
            toolbarScrollWidth: toolbar?.scrollWidth || 0,
            toolbarWidth: toolbar?.getBoundingClientRect().width || 0,
            toolbarRows: [...document.querySelectorAll(
              '#toolbar > .toolbar-row, #toolbar > #connection-details > .toolbar-row, .bl-toolbar > .toolbar-row'
            )]
              .map((row, index) => {
                const rect = row.getBoundingClientRect();
                const contentBottom = Math.max(rect.top, ...[...row.children].map((child) => child.getBoundingClientRect().bottom));
                const style = getComputedStyle(row);
                return {
                  index,
                  top: rect.top,
                  bottom: rect.bottom,
                  contentBottom,
                  clientWidth: row.clientWidth,
                  scrollWidth: row.scrollWidth,
                  borderTopWidth: style.borderTopWidth,
                  brand: Boolean(row.querySelector('.toolbar-brand')),
                  menu: Boolean(row.querySelector('#btn-client-menu')),
                  api: Boolean(row.querySelector('#api-url')),
                  character: Boolean(row.querySelector('#player-select, #character-select')),
                  fragments: Boolean(row.querySelector('#fragment-file')),
                };
              }),
            panes,
          };
        }
        """
    )
    if abs(layout["appHeight"] - layout["viewportHeight"]) > 1:
        raise AssertionError(f"{name} app does not fill the viewport: {layout!r}")
    if layout["scrollWidth"] > layout["viewportWidth"] + 1:
        raise AssertionError(f"{name} has document-level horizontal overflow: {layout!r}")
    if layout["toolbarWidth"] > layout["viewportWidth"] + 1:
        raise AssertionError(f"{name} toolbar exceeds the viewport: {layout!r}")
    if layout["toolbarScrollWidth"] > layout["toolbarClientWidth"] + 1:
        raise AssertionError(f"{name} toolbar scrolls horizontally: {layout!r}")
    if not layout["toolbarRows"] or not layout["toolbarRows"][0]["brand"] or not layout["toolbarRows"][0]["menu"]:
        raise AssertionError(f"{name} title and menu are not together on the first row: {layout!r}")
    for index, row in enumerate(layout["toolbarRows"]):
        if row["scrollWidth"] > row["clientWidth"] + 1:
            raise AssertionError(f"{name} toolbar row scrolls horizontally: {layout!r}")
        if row["contentBottom"] > row["bottom"] + 1:
            raise AssertionError(f"{name} toolbar content escapes its row: {layout!r}")
        if index and layout["toolbarRows"][index - 1]["bottom"] > row["top"] + 1:
            raise AssertionError(f"{name} toolbar rows overlap: {layout!r}")
        if index and row["borderTopWidth"] == "0px":
            raise AssertionError(f"{name} additional toolbar row lacks a border: {layout!r}")
    api_rows = [row["index"] for row in layout["toolbarRows"] if row["api"]]
    character_rows = [row["index"] for row in layout["toolbarRows"] if row["character"]]
    fragment_rows = [row["index"] for row in layout["toolbarRows"] if row["fragments"]]
    if api_rows and api_rows[0] > 1:
        raise AssertionError(f"{name} server controls are below the second row: {layout!r}")
    if character_rows and character_rows != [2]:
        raise AssertionError(f"{name} character selection is not on the row after server controls: {layout!r}")
    if fragment_rows and fragment_rows != [2]:
        raise AssertionError(f"{name} fragment selection is not on the row after server controls: {layout!r}")
    for pane in layout["panes"]:
        if pane["width"] > layout["viewportWidth"] + 1 or pane["left"] < -1 or pane["right"] > layout["viewportWidth"] + 1:
            raise AssertionError(f"{name} pane exceeds the viewport: {pane!r}")


def assert_stack(page, name: str, selectors: tuple[str, ...]) -> None:
    boxes = []
    for selector in selectors:
        locator = page.locator(selector)
        locator.wait_for(state="visible")
        box = locator.bounding_box()
        if box is None:
            raise AssertionError(f"{name} pane is not measurable: {selector}")
        boxes.append(box)
    if any(boxes[index]["y"] >= boxes[index + 1]["y"] for index in range(len(boxes) - 1)):
        raise AssertionError(f"{name} panes are not vertically stacked: {boxes!r}")
    overflow = page.locator("#main").evaluate("node => getComputedStyle(node).overflowY")
    if overflow != "auto":
        raise AssertionError(f"{name} stacked work surface is not scrollable: {overflow!r}")


def assert_web_tui_drawers(page) -> None:
    for tab, pane in (("#tab-world", "#world-pane"), ("#tab-actions", "#actions-pane")):
        page.locator(tab).click()
        bounds = page.evaluate(
            """pane => {
              const main = document.querySelector('#main').getBoundingClientRect();
              const drawer = document.querySelector(pane).getBoundingClientRect();
              return { drawerBottom: drawer.bottom, mainBottom: main.bottom };
            }""",
            pane,
        )
        if abs(bounds["drawerBottom"] - bounds["mainBottom"]) > 1:
            raise AssertionError(f"web-tui.html {pane} does not reach the bottom: {bounds!r}")


def assert_player_pane_bottom(page, name: str, pane: str) -> None:
    bounds = page.evaluate(
        """pane => {
          const main = document.querySelector('#main').getBoundingClientRect();
          const panel = document.querySelector(pane).getBoundingClientRect();
          return { mainBottom: main.bottom, paneBottom: panel.bottom };
        }""",
        pane,
    )
    if abs(bounds["paneBottom"] - bounds["mainBottom"]) > 1:
        raise AssertionError(f"{name} {pane} does not reach the bottom: {bounds!r}")


def main() -> None:
    ensure_web_server(BASE_URL)
    SCREENSHOT_DIR.mkdir(parents=True, exist_ok=True)
    with sync_playwright() as playwright:
        coverage = PlaywrightCoverage("responsive")
        browser = launch_browser(playwright)
        portrait = browser.new_context(viewport={"width": 390, "height": 760}, device_scale_factor=1, is_mobile=True, has_touch=True)
        page = portrait.new_page()
        coverage.start_page(page)
        page.route("https://cdn.jsdelivr.net/**", lambda route: route.fulfill(status=200, body=""))
        page.route("**/api/v1/auth/session", lambda route: route.fulfill(status=200, json={
            "subject": "responsive-test", "scopes": ["world:admin"],
            "expires_at": 4102444800, "rotate_after": None, "rotation_eligible": False,
        }))

        for name in FULL_SCREEN_PAGES:
            page.goto(f"{BASE_URL}/{name}", wait_until="domcontentloaded")
            page.locator("#toolbar").wait_for(state="visible")
            page.evaluate(
                """() => {
                  const status = document.querySelector('#api-status, #status, #tempo-status');
                  if (status) status.textContent = 'Connection failed: ' + 'upstream-gateway-with-an-unusually-long-hostname.example.invalid/'.repeat(5);
                }"""
            )
            assert_shell(page, name)
            if name == "web-tui.html":
                assert_web_tui_drawers(page)
            elif name in PLAYER_BOTTOM_PANES:
                assert_player_pane_bottom(page, name, PLAYER_BOTTOM_PANES[name])
            if name in STACKS:
                assert_stack(page, name, STACKS[name])
            if name in {"character.html", "toon-client.html", "world-editor.html"}:
                page.screenshot(path=str(SCREENSHOT_DIR / f"bunnyland-responsive-{name[:-5]}.png"))

        page.set_viewport_size({"width": 768, "height": 900})
        for name in FULL_SCREEN_PAGES:
            page.goto(f"{BASE_URL}/{name}", wait_until="domcontentloaded")
            page.locator("#toolbar").wait_for(state="visible")
            page.evaluate(
                """() => {
                  const status = document.querySelector('#api-status, #status, #tempo-status');
                  if (status) status.textContent = 'Connection failed: ' + 'upstream-gateway-with-an-unusually-long-hostname.example.invalid/'.repeat(5);
                }"""
            )
            assert_shell(page, name)
            if name == "web-tui.html":
                assert_web_tui_drawers(page)
            elif name in PLAYER_BOTTOM_PANES:
                assert_player_pane_bottom(page, name, PLAYER_BOTTOM_PANES[name])

        page.set_viewport_size({"width": 320, "height": 760})
        page.goto(
            f"{BASE_URL}/index.html?server=%2Fapi%2Fv1%2Fsandboxes%2Fmobile-regression-with-a-long-name",
            wait_until="domcontentloaded",
        )
        welcome = page.evaluate("""
          () => ({
            width: document.documentElement.scrollWidth,
            viewport: innerWidth,
            screenWidth: screen.width,
            minHeight: document.querySelector('#app').getBoundingClientRect().height,
            viewportHeight: innerHeight,
            commands: ['cmd-tui', 'cmd-repl'].map((id) => {
              const command = document.getElementById(id).closest('.cmd');
              const rect = command.getBoundingClientRect();
              const children = [...command.children].map((child) => child.getBoundingClientRect());
              return {
                id,
                left: rect.left,
                right: rect.right,
                width: rect.width,
                clientWidth: command.clientWidth,
                scrollWidth: command.scrollWidth,
                childLeft: Math.min(...children.map((child) => child.left)),
                childRight: Math.max(...children.map((child) => child.right)),
              };
            }),
            cards: [...document.querySelectorAll('[aria-labelledby="terminal-title"] .info-card')].map((card) => {
              const rect = card.getBoundingClientRect();
              return {
                title: card.querySelector('h3').textContent,
                left: rect.left,
                right: rect.right,
                clientWidth: card.clientWidth,
                scrollWidth: card.scrollWidth,
              };
            }),
            sectionHeadingDirection: getComputedStyle(document.querySelector('.section-heading')).flexDirection,
            touchTargets: [...document.querySelectorAll('.quick-links .button-link')]
              .filter((link) => getComputedStyle(link).display !== 'none')
              .map((link) => ({ label: link.textContent.trim(), height: link.getBoundingClientRect().height })),
          })
        """)
        if (
            welcome["viewport"] > welcome["screenWidth"] + 1
            or welcome["width"] > welcome["screenWidth"] + 1
            or welcome["minHeight"] < welcome["viewportHeight"]
        ):
            raise AssertionError(f"welcome page is not responsive: {welcome!r}")
        for command in welcome["commands"]:
            if (
                command["left"] < -1
                or command["right"] > welcome["screenWidth"] + 1
                or command["scrollWidth"] > command["clientWidth"] + 1
                or command["childLeft"] < command["left"] - 1
                or command["childRight"] > command["right"] + 1
            ):
                raise AssertionError(f"welcome command block overflows on mobile: {command!r}")
        for card in welcome["cards"]:
            if (
                card["left"] < -1
                or card["right"] > welcome["screenWidth"] + 1
                or card["scrollWidth"] > card["clientWidth"] + 1
            ):
                raise AssertionError(f"welcome info card overflows on mobile: {card!r}")
        if welcome["sectionHeadingDirection"] != "column":
            raise AssertionError(f"welcome section headings do not stack on mobile: {welcome!r}")
        for target in welcome["touchTargets"]:
            if target["height"] < 44:
                raise AssertionError(f"welcome touch target is too short: {target!r}")

        first_link = page.locator('.quick-links .button-link').first
        first_link.focus()
        if first_link.evaluate("node => getComputedStyle(node).outlineWidth") != "2px":
            raise AssertionError("welcome links lack a visible keyboard focus outline")

        page.locator("#btn-client-menu").click()
        menu = page.locator("#client-menu-dialog")
        menu.wait_for(state="visible")
        menu_state = menu.evaluate("""
          (dialog) => ({
            sections: [...dialog.querySelectorAll('.client-menu-section-title')]
              .map((heading) => heading.textContent.trim()),
            firstPlayer: dialog.querySelector('.client-menu-section-title:nth-of-type(2) + .client-menu-item')?.textContent,
            recommended: dialog.querySelector('.client-menu-recommended')?.textContent,
          })
        """)
        if menu_state["sections"] != ["Bunnyland", "Player clients", "Builder & admin"]:
            raise AssertionError(f"client menu sections are out of order: {menu_state!r}")
        if "Web TUI" not in (menu_state["firstPlayer"] or "") or menu_state["recommended"] != "Recommended":
            raise AssertionError(f"Web TUI is not the recommended player client: {menu_state!r}")
        page.locator(".client-menu-close").click()

        page.evaluate("""() => {
          window.__bunnylandDialogResult = BunnylandUI.promptDialog('Name this binding.', {
            label: 'Binding name', title: 'Bind entity', value: 'front_door',
          });
        }""")
        action_dialog = page.locator("#bl-action-dialog[open]")
        action_dialog.wait_for(state="visible")
        action_dialog.locator("input[name=value]").fill("market_door")
        action_dialog.locator(".bl-dialog-confirm").click()
        if page.evaluate("async () => await window.__bunnylandDialogResult") != "market_door":
            raise AssertionError("shared prompt dialog did not return its submitted value")

        page.evaluate("""() => {
          window.__bunnylandDialogResult = BunnylandUI.confirmDialog('Delete this entity?', {
            confirmLabel: 'Delete', title: 'Delete entity', tone: 'danger',
          });
        }""")
        action_dialog.wait_for(state="visible")
        page.keyboard.press("Escape")
        if page.evaluate("async () => await window.__bunnylandDialogResult") is not False:
            raise AssertionError("shared confirm dialog did not cancel on Escape")
        page.screenshot(path=str(SCREENSHOT_DIR / "bunnyland-responsive-welcome.png"), full_page=True)
        coverage.close_page(page)
        portrait.close()

        landscape = browser.new_context(viewport={"width": 844, "height": 390}, device_scale_factor=1, is_mobile=True, has_touch=True)
        page = landscape.new_page()
        coverage.start_page(page)
        page.route("https://cdn.jsdelivr.net/**", lambda route: route.fulfill(status=200, body=""))
        page.route("**/api/v1/auth/session", lambda route: route.fulfill(status=200, json={
            "subject": "responsive-test", "scopes": ["world:admin"],
            "expires_at": 4102444800, "rotate_after": None, "rotation_eligible": False,
        }))
        for name in LANDSCAPE_PAGES:
            page.goto(f"{BASE_URL}/{name}", wait_until="domcontentloaded")
            page.locator("#toolbar").wait_for(state="visible")
            assert_shell(page, name)
            if name == "web-tui.html":
                assert_web_tui_drawers(page)
            elif name in PLAYER_BOTTOM_PANES:
                assert_player_pane_bottom(page, name, PLAYER_BOTTOM_PANES[name])
        coverage.close_page(page)
        landscape.close()
        coverage.close_browser(browser)

    print("responsive=ok")


if __name__ == "__main__":
    main()
