#!/usr/bin/env python3
"""Playwright regression test for the Bunnyland trace analyzer."""

from __future__ import annotations

import json
import os
import shutil
import tempfile
from pathlib import Path

from playwright.sync_api import expect, sync_playwright

from playwright_coverage import PlaywrightCoverage
from playwright_server import ensure_web_server


BASE_URL = os.environ.get("BUNNYLAND_WEB_BASE_URL", "http://127.0.0.1:8091").rstrip("/")
SCREENSHOT_DIR = Path(os.environ.get("BUNNYLAND_PLAYWRIGHT_SCREENSHOT_DIR", "/tmp"))


def launch_browser(playwright):
    chrome = (
        os.environ.get("BUNNYLAND_CHROME")
        or shutil.which("google-chrome")
        or shutil.which("chromium")
        or shutil.which("chromium-browser")
    )
    kwargs = {"headless": True}
    if chrome:
        kwargs["executable_path"] = chrome
        kwargs["args"] = ["--no-sandbox"]
    return playwright.chromium.launch(**kwargs)


def span(
    name: str,
    span_id: str,
    *,
    parent_span_id: str | None = None,
    start_ms: int = 0,
    end_ms: int = 10,
    service: str = "bunnyland-server",
    status: str = "UNSET",
) -> dict:
    return {
        "name": name,
        "trace_id": "11111111111111111111111111111111",
        "span_id": span_id,
        "parent_span_id": parent_span_id,
        "start_time_unix_nano": 1_750_000_000_000_000_000 + start_ms * 1_000_000,
        "end_time_unix_nano": 1_750_000_000_000_000_000 + end_ms * 1_000_000,
        "attributes": {"command.type": name, "world.epoch": start_ms},
        "events": [
            {
                "name": "checked",
                "timestamp_unix_nano": 1_750_000_000_000_000_000 + start_ms * 1_000_000,
                "attributes": {"ok": status != "ERROR"},
            }
        ],
        "status": {"code": f"StatusCode.{status}", "description": ""},
        "resource": {"service.name": service},
    }


def write_fixtures(tmp: Path) -> tuple[Path, Path]:
    spans = [
        span("release.multiclient", "aaaaaaaaaaaaaaaa", start_ms=0, end_ms=50, service="release-runner"),
        span("claim.character", "bbbbbbbbbbbbbbbb", parent_span_id="aaaaaaaaaaaaaaaa", start_ms=4, end_ms=16),
        span(
            "move",
            "cccccccccccccccc",
            parent_span_id="aaaaaaaaaaaaaaaa",
            start_ms=20,
            end_ms=44,
            status="ERROR",
        ),
    ]
    jsonl = tmp / "release-trace.jsonl"
    jsonl.write_text("\n".join(json.dumps(item) for item in spans), encoding="utf-8")
    array_json = tmp / "release-trace.json"
    array_json.write_text(json.dumps(spans), encoding="utf-8")
    return jsonl, array_json


def tempo_search_payload() -> dict:
    return {
        "traces": [
            {
                "traceID": "454a36f2e9b401741b5469f4209d8ae",
                "rootServiceName": "bunnyland",
                "rootTraceName": "game.loop.iteration",
                "startTimeUnixNano": "1750000000000000000",
                "durationMs": 3.74,
            },
            {
                "traceID": "33333333333333333333333333333333",
                "rootServiceName": "bunnyland-server",
                "rootTraceName": "command.submit",
                "startTimeUnixNano": "1749999999000000000",
                "durationMs": 1.25,
            },
        ]
    }


def tempo_trace_payload(trace_id: str) -> dict:
    if trace_id.endswith("33333333"):
        service = "bunnyland-server"
        root_name = "command.submit"
        child_name = "command.queue"
        start_ns = 1_749_999_999_000_000_000
        trace_id_json = "MzMzMzMzMzMzMzMzMzMzMw=="
    else:
        service = "bunnyland"
        root_name = "game.loop.iteration"
        child_name = "controller.run_once"
        start_ns = 1_750_000_000_000_000_000
        trace_id_json = "BFSjby6bQBdBtUafQgnYrg=="
    return {
        "resourceSpans": [
            {
                "resource": {
                    "attributes": [
                        {"key": "service.name", "value": {"stringValue": service}},
                        {"key": "telemetry.sdk.name", "value": {"stringValue": "opentelemetry"}},
                    ]
                },
                "scopeSpans": [
                    {
                        "scope": {"name": "bunnyland-test"},
                        "spans": [
                            {
                                "traceId": trace_id_json,
                                "spanId": "qqqqqqqqqqo=",
                                "name": root_name,
                                "startTimeUnixNano": str(start_ns),
                                "endTimeUnixNano": str(start_ns + 3_740_000),
                                "attributes": [{"key": "loop.tick_index", "value": {"intValue": "12"}}],
                                "events": [],
                                "status": {"code": 0},
                            },
                            {
                                "traceId": trace_id_json,
                                "spanId": "u7u7u7u7u7s=",
                                "parentSpanId": "qqqqqqqqqqo=",
                                "name": child_name,
                                "startTimeUnixNano": str(start_ns + 250_000),
                                "endTimeUnixNano": str(start_ns + 1_250_000),
                                "attributes": [{"key": "command.type", "value": {"stringValue": child_name}}],
                                "events": [
                                    {
                                        "name": "queued",
                                        "timeUnixNano": str(start_ns + 300_000),
                                        "attributes": [{"key": "ok", "value": {"boolValue": False}}],
                                    }
                                ],
                                "status": {"code": 2},
                            },
                        ],
                    }
                ],
            }
        ]
    }


def route_tempo(page) -> None:
    page.route(
        "**/tempo/api/search**",
        lambda route: route.fulfill(
            status=200,
            content_type="application/json",
            body=json.dumps(tempo_search_payload()),
        ),
    )

    def fulfill_trace(route) -> None:
        trace_id = route.request.url.rsplit("/", 1)[-1]
        route.fulfill(
            status=200,
            content_type="application/json",
            body=json.dumps(tempo_trace_payload(trace_id)),
        )

    page.route("**/tempo/api/traces/**", fulfill_trace)


def load_trace(page, path: Path) -> None:
    page.goto(f"{BASE_URL}/trace-analyzer.html", wait_until="domcontentloaded")
    page.locator("#trace-file").set_input_files(str(path))
    expect(page.locator("#trace-title")).to_contain_text("release-runner: release.multiclient")
    expect(page.locator("#stat-spans")).to_have_text("3")
    expect(page.locator("#stat-services")).to_have_text("2")
    expect(page.locator("#stat-errors")).to_have_text("1")
    expect(page.locator("#span-rows .span-row")).to_have_count(3)
    expect(page.locator("#detail-pane")).to_contain_text("Span attributes")


def test_jsonl_trace(page, jsonl: Path) -> None:
    load_trace(page, jsonl)
    page.locator("#filter-text").fill("move")
    expect(page.locator("#span-rows .span-row")).to_have_count(1)
    expect(page.locator("#span-rows")).to_contain_text("move")
    page.locator("#span-rows .span-row").click()
    expect(page.locator("#detail-pane")).to_contain_text("Status: ERROR")
    page.locator("#detail-pane button", has_text="Span ID").click()
    writes = page.evaluate("window.__clipboardWrites")
    if writes[-1] != "cccccccccccccccc":
        raise AssertionError(f"span copy button wrote unexpected text: {writes!r}")
    expect(page.locator("#detail-pane button", has_text="Copied")).to_be_visible()
    page.locator("#filter-text").fill("")
    page.locator("#filter-service").select_option("release-runner")
    expect(page.locator("#span-rows .span-row")).to_have_count(1)
    page.locator("#filter-status").select_option("ERROR")
    expect(page.locator("#span-rows")).to_contain_text("No spans match")
    page.locator("#clear-filters").click()
    expect(page.locator("#span-rows .span-row")).to_have_count(3)


def test_json_trace(page, json_file: Path) -> None:
    load_trace(page, json_file)
    page.locator("#theme-select").select_option("anime-light")
    theme = page.evaluate(
        "() => ({ current: BunnylandUI.currentTheme(), anime: document.documentElement.classList.contains('bl-theme-anime-light') })"
    )
    if theme != {"current": "anime-light", "anime": True}:
        raise AssertionError(f"theme selector did not use shared theme setup: {theme!r}")
    if page.locator(".client-menu-item").count() != 0:
        raise AssertionError("trace analyzer should not render the shared client menu")


def test_live_tempo_trace(page) -> None:
    route_tempo(page)
    page.goto(f"{BASE_URL}/trace-analyzer.html", wait_until="domcontentloaded")
    page.locator("#tempo-connect").click()
    expect(page.locator("#tempo-status")).to_contain_text("live")
    expect(page.locator("#trace-title")).to_contain_text("bunnyland: game.loop.iteration")
    expect(page.locator("#stat-spans")).to_have_text("2")
    expect(page.locator("#span-rows .span-row")).to_have_count(2)
    expect(page.locator("#detail-pane")).to_contain_text("loop.tick_index")

    page.locator("#trace-select").select_option("33333333333333333333333333333333")
    expect(page.locator("#trace-title")).to_contain_text("bunnyland-server: command.submit")
    expect(page.locator("#stat-spans")).to_have_text("2")
    page.locator("#span-rows .span-row").nth(1).click()
    expect(page.locator("#detail-pane")).to_contain_text("Status: ERROR")


def main() -> None:
    ensure_web_server(BASE_URL)
    SCREENSHOT_DIR.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="bunnyland-trace-analyzer-") as tmp_dir:
        jsonl, json_file = write_fixtures(Path(tmp_dir))
        with sync_playwright() as playwright:
            coverage = PlaywrightCoverage("trace-analyzer")
            browser = launch_browser(playwright)
            page = coverage.new_page(browser, viewport={"width": 1400, "height": 900})
            page.add_init_script(
                """
                window.__clipboardWrites = [];
                Object.defineProperty(navigator, 'clipboard', {
                  configurable: true,
                  value: { writeText: async (text) => window.__clipboardWrites.push(String(text)) },
                });
                """
            )
            test_jsonl_trace(page, jsonl)
            test_json_trace(page, json_file)
            test_live_tempo_trace(page)
            page.screenshot(path=str(SCREENSHOT_DIR / "bunnyland-trace-analyzer.png"))
            coverage.close_browser(browser)


if __name__ == "__main__":
    main()
