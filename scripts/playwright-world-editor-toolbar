#!/usr/bin/env python3
"""Playwright checks for the Bunnyland world editor toolbar layout."""

from pathlib import Path
import json
import os
import shutil

from playwright.sync_api import sync_playwright

from playwright_coverage import PlaywrightCoverage
from playwright_server import ensure_web_server


BASE_URL = os.environ.get("BUNNYLAND_WEB_BASE_URL", "http://127.0.0.1:8091").rstrip("/")
SCREENSHOT_DIR = Path(os.environ.get("BUNNYLAND_PLAYWRIGHT_SCREENSHOT_DIR", "/tmp"))
SCREENSHOT = SCREENSHOT_DIR / "bunnyland-world-editor-toolbar.png"


def launch_browser(playwright):
    chrome = (
        os.environ.get("BUNNYLAND_CHROME")
        or shutil.which("google-chrome")
        or shutil.which("chromium")
        or shutil.which("chromium-browser")
    )
    kwargs = {"headless": True}
    if chrome:
        kwargs["executable_path"] = chrome
        kwargs["args"] = ["--no-sandbox"]
    return playwright.chromium.launch(**kwargs)


def main() -> None:
    ensure_web_server(BASE_URL)
    SCREENSHOT_DIR.mkdir(parents=True, exist_ok=True)
    with sync_playwright() as playwright:
        coverage = PlaywrightCoverage("world-editor-toolbar")
        browser = launch_browser(playwright)
        page = coverage.new_page(browser, viewport={"width": 1280, "height": 720}, device_scale_factor=1)
        page.goto(f"{BASE_URL}/world-editor.html", wait_until="networkidle")

        fragment_parent = page.locator("#fragment-file").evaluate("node => node.closest('.toolbar-row').id")
        if fragment_parent != "toolbar-row3":
            raise AssertionError(f"expected fragments controls in toolbar-row3, found {fragment_parent!r}")

        menu_button = page.locator("#btn-client-menu")
        menu_button.wait_for()
        if not menu_button.is_visible():
            raise AssertionError("client menu button is not visible")
        menu_button.click()
        script_editor = page.locator('.client-menu-item[href="script-editor.html"]')
        script_editor.wait_for()
        if not script_editor.is_visible():
            raise AssertionError("Script Editor menu item is not visible")
        page.keyboard.press("Escape")

        boxes = page.evaluate(
            """
            () => {
              const ids = ['toolbar-row1', 'toolbar-row2', 'toolbar-row3'];
              return Object.fromEntries(ids.map((id) => {
                const rect = document.getElementById(id).getBoundingClientRect();
                return [id, { top: rect.top, bottom: rect.bottom, height: rect.height }];
              }));
            }
            """
        )
        if boxes["toolbar-row1"]["bottom"] > boxes["toolbar-row2"]["top"]:
            raise AssertionError("toolbar row 1 overlaps row 2")
        if boxes["toolbar-row2"]["bottom"] > boxes["toolbar-row3"]["top"]:
            raise AssertionError("toolbar row 2 overlaps row 3")
        if boxes["toolbar-row3"]["height"] < 20:
            raise AssertionError("toolbar row 3 is unexpectedly collapsed")

        page.locator("#toolbar").screenshot(path=str(SCREENSHOT))

        page.goto(f"{BASE_URL}/index.html", wait_until="networkidle")
        if not page.locator("h1").text_content() or "shared world" not in page.locator("h1").text_content():
            raise AssertionError("welcome page headline did not render")
        if page.locator('a[href="toon-client.html"]').count() < 1:
            raise AssertionError("welcome page is missing a Toon Client link")
        if page.locator('a[href="https://bunnyland.dev/guides/"]').count() < 1:
            raise AssertionError("welcome page is missing guides link")
        welcome_text = page.locator("body").text_content()
        if "Discord" not in welcome_text or "Textual TUI" not in welcome_text:
            raise AssertionError("welcome page is missing alternate player input options")
        if "Character Sheet" not in welcome_text or "Character Chat" not in welcome_text:
            raise AssertionError("welcome page is missing character feature cards")
        section_order = page.evaluate(
            """
            () => {
              const terminal = document.getElementById('terminal-title').closest('section');
              const characters = document.getElementById('characters-title').closest('section');
              return Boolean(terminal.compareDocumentPosition(characters) & Node.DOCUMENT_POSITION_FOLLOWING);
            }
            """
        )
        if not section_order:
            raise AssertionError("character section should follow the terminal section")
        if page.locator('#character-sheet-card.feature-disabled').count() != 1:
            raise AssertionError("character sheet card should be disabled without health features")
        if page.locator('#character-chat-card.feature-disabled').count() != 1:
            raise AssertionError("character chat card should be disabled without health features")
        if page.locator('#character-sheet-link[aria-disabled="true"][tabindex="-1"]').count() != 1:
            raise AssertionError("character sheet link should be readonly when disabled")
        if page.locator('#character-chat-link[aria-disabled="true"][tabindex="-1"]').count() != 1:
            raise AssertionError("character chat link should be readonly when disabled")
        welcome_layout = page.evaluate(
            """
            () => {
              const cards = Array.from(document.querySelectorAll('.info-card'));
              const shortCards = cards
                .map((card) => ({ title: card.querySelector('h3')?.textContent?.trim(), height: card.getBoundingClientRect().height }))
                .filter((card) => card.height < 199);
              const unalignedActions = cards
                .map((card) => {
                  const action = card.querySelector('.info-actions');
                  if (!action) return null;
                  const cardRect = card.getBoundingClientRect();
                  const actionRect = action.getBoundingClientRect();
                  return { title: card.querySelector('h3')?.textContent?.trim(), gap: cardRect.bottom - actionRect.bottom };
                })
                .filter(Boolean)
                .filter((card) => Math.abs(card.gap - 14) > 1);
              const textualOrder = ['cmd-tui', 'cmd-repl'].every((id) => {
                const command = document.getElementById(id).closest('.cmd');
                const text = command.parentElement.querySelector('p');
                return Boolean(text.compareDocumentPosition(command) & Node.DOCUMENT_POSITION_FOLLOWING);
              });
              return { shortCards, unalignedActions, textualOrder };
            }
            """
        )
        if welcome_layout["shortCards"]:
            raise AssertionError(f"welcome info cards should be at least 200px tall: {welcome_layout['shortCards']!r}")
        if welcome_layout["unalignedActions"]:
            raise AssertionError(
                f"welcome info-card actions should align to the bottom: {welcome_layout['unalignedActions']!r}"
            )
        if not welcome_layout["textualOrder"]:
            raise AssertionError("Textual client descriptions should appear above their uv run commands")
        page.locator("#btn-client-menu").click()
        if page.locator('.client-menu-item[href="index.html"].active').count() != 1:
            raise AssertionError("shared client menu does not include active welcome page")
        page.goto(f"{BASE_URL}/world-editor.html", wait_until="networkidle")
        page.locator("#btn-toggle-snapshot").click()
        if not page.locator("#main.snapshot-hidden").is_visible():
            raise AssertionError("snapshot toggle did not hide the preview pane")
        if page.locator("#btn-toggle-snapshot").text_content() != "Show Snapshot":
            raise AssertionError("snapshot toggle button did not switch to show state")
        page.locator("#btn-toggle-snapshot").click()
        if page.locator("#main.snapshot-hidden").count() != 0:
            raise AssertionError("snapshot toggle did not restore the preview pane")
        page.locator("#btn-new").click()
        page.locator("#meta-seed").fill("toolbar-seed")
        page.locator("#meta-generator").fill("toolbar-generator")
        page.locator("#meta-epoch").fill("42")
        snapshot = json.loads(page.locator("#json-output").input_value())
        meta = {
            "seed": snapshot["bunnyland"]["seed"],
            "generator": snapshot["bunnyland"]["generator"],
            "epoch": snapshot["metadata"]["epoch"],
            "saved": snapshot["bunnyland"]["saved_at_epoch"],
            "info": page.locator("#world-info").text_content(),
        }
        expected_meta = {
            "seed": "toolbar-seed",
            "generator": "toolbar-generator",
            "epoch": 42,
            "saved": 42,
            "info": "1 entities · epoch 42",
        }
        if meta != expected_meta:
            raise AssertionError(f"metadata controls did not update world state: {meta!r}")
        coverage.close_browser(browser)

    print("world_editor_toolbar=ok")
    print(f"screenshot={SCREENSHOT}")


if __name__ == "__main__":
    main()
