#!/usr/bin/env python3
"""Playwright checks for the Bunnyland world editor toolbar layout."""

from pathlib import Path
import json
import os
import re
import shutil
from urllib.parse import urlparse

from playwright.sync_api import sync_playwright

from playwright_coverage import PlaywrightCoverage
from playwright_server import ensure_web_server


BASE_URL = os.environ.get("BUNNYLAND_WEB_BASE_URL", "http://127.0.0.1:8091").rstrip("/")
SCREENSHOT_DIR = Path(os.environ.get("BUNNYLAND_PLAYWRIGHT_SCREENSHOT_DIR", "/tmp"))
SCREENSHOT = SCREENSHOT_DIR / "bunnyland-world-editor-toolbar.png"
WELCOME_MOBILE_SCREENSHOT = SCREENSHOT_DIR / "bunnyland-welcome-mobile.png"


def launch_browser(playwright):
    chrome = (
        os.environ.get("BUNNYLAND_CHROME")
        or shutil.which("google-chrome")
        or shutil.which("chromium")
        or shutil.which("chromium-browser")
    )
    kwargs = {"headless": True}
    if chrome:
        kwargs["executable_path"] = chrome
        kwargs["args"] = ["--no-sandbox"]
    return playwright.chromium.launch(**kwargs)


def dismiss_sign_in(page) -> None:
    sign_in_dialog = page.locator("#bl-action-dialog[open]")
    if not sign_in_dialog.is_visible():
        return
    if sign_in_dialog.locator("#bl-action-dialog-title").text_content() != "Sign in to Bunnyland":
        raise AssertionError("world editor opened an unexpected shared dialog")
    layout = sign_in_dialog.evaluate("""
      (dialog) => {
        const rect = dialog.getBoundingClientRect();
        const inputRect = dialog.querySelector('input').getBoundingClientRect();
        const buttonRect = dialog.querySelector('.bl-dialog-confirm').getBoundingClientRect();
        return {
          backdrop: getComputedStyle(dialog, '::backdrop').backgroundColor,
          centerX: rect.left + rect.width / 2,
          centerY: rect.top + rect.height / 2,
          inputInset: inputRect.left - rect.left,
          actionInset: rect.right - buttonRect.right,
          viewportCenterX: innerWidth / 2,
          viewportCenterY: innerHeight / 2,
        };
      }
    """)
    horizontally_offset = abs(layout["centerX"] - layout["viewportCenterX"]) > 1
    vertically_offset = abs(layout["centerY"] - layout["viewportCenterY"]) > 1
    if horizontally_offset or vertically_offset:
        raise AssertionError(f"shared dialog is not centered: {layout!r}")
    if layout["inputInset"] < 12 or layout["actionInset"] < 12:
        raise AssertionError(f"shared dialog content lacks edge padding: {layout!r}")
    if layout["backdrop"] in ("transparent", "rgba(0, 0, 0, 0)"):
        raise AssertionError(f"shared dialog backdrop is transparent: {layout!r}")
    sign_in_dialog.locator(".bl-dialog-cancel").click()


def main() -> None:
    ensure_web_server(BASE_URL)
    SCREENSHOT_DIR.mkdir(parents=True, exist_ok=True)
    with sync_playwright() as playwright:
        coverage = PlaywrightCoverage("world-editor-toolbar")
        browser = launch_browser(playwright)
        page = coverage.new_page(browser, viewport={"width": 1280, "height": 720}, device_scale_factor=1)
        page.route("**/api/v1/auth/session", lambda route: route.fulfill(status=200, json={
            "subject": "world-editor-toolbar-test", "scopes": ["world:admin"],
            "expires_at": 4102444800, "rotate_after": None, "rotation_eligible": False,
        }))
        page.goto(f"{BASE_URL}/world-editor.html", wait_until="networkidle")
        dismiss_sign_in(page)

        fragment_parent = page.locator("#fragment-file").evaluate("node => node.closest('.toolbar-row').id")
        if fragment_parent != "toolbar-row3":
            raise AssertionError(f"expected fragments controls in toolbar-row3, found {fragment_parent!r}")

        menu_button = page.locator("#btn-client-menu")
        menu_button.wait_for()
        if not menu_button.is_visible():
            raise AssertionError("client menu button is not visible")
        menu_button.click()
        script_editor = page.locator('.client-menu-item[href="script-editor.html"]')
        script_editor.wait_for()
        if not script_editor.is_visible():
            raise AssertionError("Script Editor menu item is not visible")
        page.keyboard.press("Escape")

        boxes = page.evaluate(
            """
            () => {
              const ids = ['toolbar-row1', 'toolbar-row2', 'toolbar-row3', 'toolbar-row4'];
              return Object.fromEntries(ids.map((id) => {
                const rect = document.getElementById(id).getBoundingClientRect();
                return [id, { top: rect.top, bottom: rect.bottom, height: rect.height }];
              }));
            }
            """
        )
        if boxes["toolbar-row1"]["bottom"] > boxes["toolbar-row2"]["top"]:
            raise AssertionError("toolbar row 1 overlaps row 2")
        if boxes["toolbar-row2"]["bottom"] > boxes["toolbar-row3"]["top"]:
            raise AssertionError("toolbar row 2 overlaps row 3")
        if boxes["toolbar-row3"]["bottom"] > boxes["toolbar-row4"]["top"]:
            raise AssertionError("toolbar row 3 overlaps row 4")
        if boxes["toolbar-row3"]["height"] < 20:
            raise AssertionError("toolbar row 3 is unexpectedly collapsed")

        button_heights = page.evaluate(
            """
            () => Object.fromEntries(['btn-toggle-live', 'btn-save-live'].map((id) => [
              id,
              document.getElementById(id).getBoundingClientRect().height,
            ]))
            """
        )
        if abs(button_heights["btn-toggle-live"] - button_heights["btn-save-live"]) > 1:
            raise AssertionError(f"runtime toolbar buttons have different heights: {button_heights!r}")

        page.locator("#toolbar").screenshot(path=str(SCREENSHOT))

        welcome_dialogs = []
        welcome_api_requests = []
        page.on("dialog", lambda dialog: (welcome_dialogs.append(dialog.message), dialog.dismiss()))
        page.on(
            "request",
            lambda request: welcome_api_requests.append(request.url)
            if re.search(r"/api(?:/v1)?/public/features(?:[?#]|$)", request.url)
            else None,
        )
        page.route(
            re.compile(r".*/api(?:/v1)?/public/features(?:\?.*)?$"),
            lambda route: route.fulfill(
                status=200,
                content_type="application/json",
                body=json.dumps({"character_chat": True, "character_sheets": True}),
            ),
        )
        page.goto(f"{BASE_URL}/index.html", wait_until="networkidle")
        if welcome_dialogs:
            raise AssertionError(f"anonymous welcome page prompted for player credentials: {welcome_dialogs!r}")
        if not welcome_api_requests:
            raise AssertionError(f"welcome page did not request public features: {welcome_api_requests!r}")
        if not any(urlparse(url).path == "/api/v1/public/features" for url in welcome_api_requests):
            raise AssertionError(f"welcome page did not use the versioned API root: {welcome_api_requests!r}")
        if page.locator("h1").text_content() != "Welcome to Bunnyland":
            raise AssertionError("welcome page headline did not render")
        if page.locator('.quick-links a.primary[href^="web-tui.html?"]').count() != 1:
            raise AssertionError("welcome page does not recommend the Web TUI")
        if page.locator('.play-list a[href^="web-tui.html?"]').count() != 1:
            raise AssertionError("welcome page first-run guidance does not open the Web TUI")
        if page.locator('.quick-links a[href^="toon-client.html?"]').count() != 1:
            raise AssertionError("welcome page is missing the alternate Toon Client link")
        if page.locator('a[href="https://bunnyland.dev/guides/"]').count() < 1:
            raise AssertionError("welcome page is missing guides link")
        welcome_text = page.locator("body").text_content()
        if "Choose and claim an available character." not in welcome_text:
            raise AssertionError("welcome page is missing generic first-run guidance")
        if any(term in welcome_text for term in ("Moss", "Juniper", "Market Lane", "post office", "market apple")):
            raise AssertionError("welcome page includes scenario-specific tutorial copy")
        if "Discord" not in welcome_text or "Textual TUI" not in welcome_text:
            raise AssertionError("welcome page is missing alternate player input options")
        if "Character Profile" not in welcome_text:
            raise AssertionError("welcome page is missing the character profile card")
        section_order = page.evaluate(
            """
            () => {
              const terminal = document.getElementById('terminal-title').closest('section');
              const characters = document.getElementById('characters-title').closest('section');
              return Boolean(terminal.compareDocumentPosition(characters) & Node.DOCUMENT_POSITION_FOLLOWING);
            }
            """
        )
        if not section_order:
            raise AssertionError("character section should follow the terminal section")
        if page.locator('#character-card.feature-disabled').count() != 0:
            raise AssertionError("character profile card should be enabled with character features")
        if page.locator('#character-link[aria-disabled="false"]').count() != 1:
            raise AssertionError("character profile link should be enabled with character features")
        welcome_layout = page.evaluate(
            """
            () => {
              const cards = Array.from(document.querySelectorAll('.info-card'));
              const shortCards = cards
                .map((card) => ({ title: card.querySelector('h3')?.textContent?.trim(), height: card.getBoundingClientRect().height }))
                .filter((card) => card.height < 199);
              const unalignedActions = cards
                .map((card) => {
                  const action = card.querySelector('.info-actions');
                  if (!action) return null;
                  const cardRect = card.getBoundingClientRect();
                  const actionRect = action.getBoundingClientRect();
                  return { title: card.querySelector('h3')?.textContent?.trim(), gap: cardRect.bottom - actionRect.bottom };
                })
                .filter(Boolean)
                .filter((card) => Math.abs(card.gap - 14) > 1);
              const textualOrder = ['cmd-tui', 'cmd-repl'].every((id) => {
                const command = document.getElementById(id).closest('.cmd');
                const text = command.parentElement.querySelector('p');
                return Boolean(text.compareDocumentPosition(command) & Node.DOCUMENT_POSITION_FOLLOWING);
              });
              return { shortCards, unalignedActions, textualOrder };
            }
            """
        )
        if welcome_layout["shortCards"]:
            raise AssertionError(f"welcome info cards should be at least 200px tall: {welcome_layout['shortCards']!r}")
        if welcome_layout["unalignedActions"]:
            raise AssertionError(
                f"welcome info-card actions should align to the bottom: {welcome_layout['unalignedActions']!r}"
            )
        if not welcome_layout["textualOrder"]:
            raise AssertionError("Textual client descriptions should appear above their uv run commands")
        page.locator("#btn-client-menu").click()
        if page.locator('.client-menu-item[href="index.html"].active').count() != 1:
            raise AssertionError("shared client menu does not include active welcome page")
        mobile_context = browser.new_context(
            viewport={"width": 390, "height": 760}, device_scale_factor=1, is_mobile=True, has_touch=True
        )
        mobile_page = mobile_context.new_page()
        coverage.start_page(mobile_page)
        mobile_page.goto(f"{BASE_URL}/index.html", wait_until="networkidle")
        scroll_metrics = mobile_page.evaluate(
            """
            () => {
              const root = document.scrollingElement;
              const app = document.getElementById('app');
              return {
                appHeight: app.getBoundingClientRect().height,
                clientHeight: root.clientHeight,
                scrollHeight: root.scrollHeight,
              };
            }
            """
        )
        if scroll_metrics["scrollHeight"] <= scroll_metrics["clientHeight"]:
            raise AssertionError(f"mobile welcome page has no scrollable document: {scroll_metrics!r}")
        if scroll_metrics["appHeight"] <= scroll_metrics["clientHeight"]:
            raise AssertionError(f"mobile welcome app root is constrained to the viewport: {scroll_metrics!r}")
        mobile_page.evaluate("window.scrollTo(0, 240)")
        mobile_page.wait_for_timeout(50)
        scroll_metrics["scrollTop"] = mobile_page.evaluate("document.scrollingElement.scrollTop")
        if scroll_metrics["scrollTop"] <= 0:
            raise AssertionError(f"mobile welcome page did not scroll: {scroll_metrics!r}")
        mobile_page.screenshot(path=str(WELCOME_MOBILE_SCREENSHOT))
        coverage.close_page(mobile_page)
        mobile_context.close()
        page.goto(f"{BASE_URL}/world-editor.html", wait_until="networkidle")
        dismiss_sign_in(page)
        page.locator("#btn-toggle-snapshot").click()
        if not page.locator("#main.snapshot-hidden").is_visible():
            raise AssertionError("snapshot toggle did not hide the preview pane")
        if page.locator("#btn-toggle-snapshot").text_content() != "Show Snapshot":
            raise AssertionError("snapshot toggle button did not switch to show state")
        page.locator("#btn-toggle-snapshot").click()
        if page.locator("#main.snapshot-hidden").count() != 0:
            raise AssertionError("snapshot toggle did not restore the preview pane")
        page.locator("#btn-new").click()
        page.locator("#meta-seed").fill("toolbar-seed")
        page.locator("#meta-generator").fill("toolbar-generator")
        page.locator("#meta-epoch").fill("42")
        snapshot = json.loads(page.locator("#json-output").input_value())
        meta = {
            "seed": snapshot["bunnyland"]["seed"],
            "generator": snapshot["bunnyland"]["generator"],
            "epoch": snapshot["metadata"]["epoch"],
            "saved": snapshot["bunnyland"]["saved_at_epoch"],
            "info": page.locator("#world-info").text_content(),
        }
        expected_meta = {
            "seed": "toolbar-seed",
            "generator": "toolbar-generator",
            "epoch": 42,
            "saved": 42,
            "info": "1 entities · epoch 42",
        }
        if meta != expected_meta:
            raise AssertionError(f"metadata controls did not update world state: {meta!r}")
        coverage.close_browser(browser)

    print("world_editor_toolbar=ok")
    print(f"screenshot={SCREENSHOT}")


if __name__ == "__main__":
    main()
