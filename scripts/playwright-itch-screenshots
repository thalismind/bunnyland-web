#!/usr/bin/env python3
"""Capture Bunnyland screenshots for an itch.io game page from a real server.

The browser clients default to the live sandbox. The script never installs Playwright
routes or fixture data; setup calls read the same live API that the pages use.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import socket
import subprocess
import tempfile
import textwrap
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Any

from playwright.sync_api import TimeoutError as PlaywrightTimeoutError
from playwright.sync_api import expect, sync_playwright


DEFAULT_WEB_URL = "https://sandbox.bunnyland.dev"
DEFAULT_API_URL = "https://sandbox.bunnyland.dev/api"
DEFAULT_OUT_DIR = Path("/tmp/bunnyland-itch-screenshots")
LOCAL_API_HOST = "127.0.0.1"
LOCAL_WEB_HOST = "127.0.0.1"
RESOLUTION_PRESETS = {
    "480p": (854, 480),
    "720p": (1280, 720),
    "1080p": (1920, 1080),
    "1440p": (2560, 1440),
    "4k": (3840, 2160),
    "2160p": (3840, 2160),
}


def parse_resolution(value: str) -> tuple[int, int]:
    key = value.lower().strip()
    if key in RESOLUTION_PRESETS:
        return RESOLUTION_PRESETS[key]
    parts = key.replace("x", " ").split()
    if len(parts) != 2:
        raise argparse.ArgumentTypeError(
            "resolution must be a preset like 1080p/4k or WIDTHxHEIGHT"
        )
    try:
        width, height = (int(part) for part in parts)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("resolution dimensions must be integers") from exc
    if width < 640 or height < 480:
        raise argparse.ArgumentTypeError("minimum supported screenshot size is 640x480")
    return width, height


def browser_page_url(web_url: str, path: str, api_url: str) -> str:
    return (
        f"{web_url.rstrip('/')}/{path}"
        f"?server={urllib.parse.quote(api_url.rstrip('/'), safe='')}"
    )


def static_page_url(web_url: str, path: str) -> str:
    return f"{web_url.rstrip('/')}/{path}"


def operator_headers(operator_token: str | None = None) -> dict[str, str]:
    if operator_token:
        token = operator_token.removeprefix("Bearer ")
        return {"Authorization": f"Bearer {token}"}
    return {}


def operator_headers_js(operator_token: str | None = None) -> dict[str, str]:
    return operator_headers(operator_token)


def api_get(
    api_url: str,
    path: str,
    operator_token: str | None = None,
) -> dict[str, Any]:
    request = urllib.request.Request(f"{api_url.rstrip('/')}{path}")
    for key, value in operator_headers(operator_token).items():
        request.add_header(key, value)
    with urllib.request.urlopen(request, timeout=25) as response:
        return json.loads(response.read().decode("utf-8"))


def api_post(
    api_url: str,
    path: str,
    body: dict[str, Any],
    operator_token: str | None = None,
    extra_headers: dict[str, str] | None = None,
) -> dict[str, Any]:
    data = json.dumps(body).encode("utf-8")
    request = urllib.request.Request(
        f"{api_url.rstrip('/')}{path}",
        data=data,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    for key, value in operator_headers(operator_token).items():
        request.add_header(key, value)
    for key, value in (extra_headers or {}).items():
        request.add_header(key, value)
    with urllib.request.urlopen(request, timeout=30) as response:
        return json.loads(response.read().decode("utf-8"))


def reserve_port() -> int:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
        sock.bind(("127.0.0.1", 0))
        return int(sock.getsockname()[1])


def wait_for_http(url: str, label: str) -> None:
    deadline = time.monotonic() + 45
    last_error: Exception | None = None
    while time.monotonic() < deadline:
        try:
            with urllib.request.urlopen(url, timeout=5):
                return
        except (urllib.error.URLError, TimeoutError, ConnectionError) as exc:
            last_error = exc
            time.sleep(0.5)
    raise RuntimeError(f"timed out waiting for {label} at {url}: {last_error}")


class ManagedProcess:
    def __init__(self, name: str, process: subprocess.Popen):
        self.name = name
        self.process = process

    def check_running(self) -> None:
        code = self.process.poll()
        if code is not None:
            raise RuntimeError(f"{self.name} exited early with status {code}")

    def stop(self) -> None:
        if self.process.poll() is not None:
            return
        self.process.terminate()
        try:
            self.process.wait(timeout=10)
        except subprocess.TimeoutExpired:
            self.process.kill()
            self.process.wait(timeout=10)


def start_local_api(server_repo: Path, port: int) -> tuple[ManagedProcess, str]:
    env = os.environ.copy()
    token_db = Path("/tmp") / f"bunnyland-itch-auth-{port}.sqlite3"
    provision = subprocess.run(
        [
            "uv", "run", "bunnyland", "auth", "provision-token",
            "--db", str(token_db), "--subject", "itch-screenshots",
            "--scope", "world:admin",
        ],
        cwd=server_repo,
        env=env,
        check=True,
        capture_output=True,
        text=True,
    )
    operator_token = provision.stdout.strip()
    process = subprocess.Popen(
        [
            "uv",
            "run",
            "--extra",
            "server",
            "bunnyland",
            "serve",
            "--generator",
            os.environ.get("BUNNYLAND_LOCAL_GENERATOR", "apartment-demo"),
            "--ticks",
            "0",
            "--api-host",
            LOCAL_API_HOST,
            "--api-port",
            str(port),
            "--token-db",
            str(token_db),
        ],
        cwd=server_repo,
        env=env,
    )
    return ManagedProcess("local Bunnyland API", process), operator_token


def start_local_web(web_repo: Path, port: int) -> ManagedProcess:
    process = subprocess.Popen(
        [
            "python3",
            "-m",
            "http.server",
            str(port),
            "--bind",
            LOCAL_WEB_HOST,
        ],
        cwd=web_repo,
    )
    return ManagedProcess("local Bunnyland web server", process)


def launch_browser(playwright):
    chrome = (
        os.environ.get("BUNNYLAND_CHROME")
        or shutil.which("google-chrome")
        or shutil.which("chromium")
        or shutil.which("chromium-browser")
    )
    kwargs: dict[str, Any] = {"headless": True}
    if chrome:
        kwargs["executable_path"] = chrome
        kwargs["args"] = ["--no-sandbox"]
    elif os.environ.get("CI"):
        kwargs["args"] = ["--no-sandbox"]
    return playwright.chromium.launch(**kwargs)


def wait_for_api(api_url: str) -> None:
    deadline = time.monotonic() + 45
    last_error: Exception | None = None
    while time.monotonic() < deadline:
        try:
            api_get(api_url, "/public/health")
            return
        except urllib.error.HTTPError as exc:
            last_error = exc
            if exc.code in {401, 403, 404}:
                try:
                    api_get(api_url, "/play/world/characters")
                    return
                except (
                    urllib.error.URLError,
                    TimeoutError,
                    ConnectionError,
                    json.JSONDecodeError,
                ) as fallback_exc:
                    last_error = fallback_exc
            time.sleep(1)
        except (urllib.error.URLError, TimeoutError, ConnectionError, json.JSONDecodeError) as exc:
            last_error = exc
            time.sleep(1)
    raise RuntimeError(f"timed out waiting for {api_url}: {last_error}")


def character_id(summary: dict[str, Any]) -> str:
    return str(summary.get("character_id") or summary.get("id") or "")


def entity_is_character(entity: dict[str, Any]) -> bool:
    return bool(
        entity.get("is_character")
        or entity.get("kind") == "character"
        or (entity.get("components") or {}).get("CharacterComponent")
    )


def entity_is_door(entity: dict[str, Any]) -> bool:
    return bool(
        entity.get("kind") == "door"
        or (entity.get("components") or {}).get("DoorComponent")
    )


def choose_character(api_url: str) -> tuple[str, dict[str, Any]]:
    lobby = api_get(api_url, "/play/world/characters")
    candidates: list[tuple[int, str, dict[str, Any]]] = []
    for summary in lobby.get("characters", []):
        cid = character_id(summary)
        if not cid:
            continue
        try:
            projection = api_get(api_url, f"/play/world/character/{urllib.parse.quote(cid, safe='')}")
        except urllib.error.URLError:
            continue
        room = projection.get("room") or {}
        entities = room.get("entities") or []
        character_count = sum(1 for entity in entities if entity_is_character(entity))
        object_count = sum(
            1
            for entity in entities
            if not entity_is_character(entity)
            and entity.get("kind") != "room"
            and not entity_is_door(entity)
        )
        target_actions = sum(
            1
            for action in projection.get("actions") or []
            if any(arg.get("target_group") for arg in action.get("arguments") or [])
        )
        exit_count = len(room.get("exits") or [])
        score = character_count * 10 + object_count * 4 + target_actions * 2 + exit_count
        candidates.append((score, cid, projection))
    if not candidates:
        raise RuntimeError("no claimable characters returned by live server")
    candidates.sort(key=lambda item: item[0], reverse=True)
    return candidates[0][1], candidates[0][2]


def wait_for_connected(page, app_expr: str = "window.app?.connected") -> None:
    page.wait_for_function(app_expr, timeout=20000)


def clean_screenshot_overlays(page) -> None:
    page.evaluate(
        """() => {
          let style = document.getElementById('bunnyland-screenshot-cleanup');
          if (!style) {
            style = document.createElement('style');
            style.id = 'bunnyland-screenshot-cleanup';
            style.textContent = `
              #loading-overlay,
              #client-menu-dialog,
              #graph-context-menu {
                display: none !important;
                opacity: 0 !important;
                pointer-events: none !important;
                visibility: hidden !important;
              }
            `;
            document.head.appendChild(style);
          }
          document.querySelectorAll('#loading-overlay').forEach((el) => el.remove());
          document.getElementById('client-menu-dialog')?.classList.add('hidden');
          document.getElementById('graph-context-menu')?.classList.add('hidden');
        }"""
    )


def select_player(page, character_id_value: str, app_expr: str) -> None:
    page.locator("#player-select").select_option(character_id_value)
    page.wait_for_function(app_expr, arg=character_id_value, timeout=20000)


def open_first_target_action(page, selector: str) -> bool:
    target = page.locator(selector).filter(has_text="target").first
    try:
        target.click(timeout=5000)
        return True
    except PlaywrightTimeoutError:
        fallback = page.locator(selector).first
        try:
            fallback.click(timeout=5000)
            return True
        except PlaywrightTimeoutError:
            return False


def connect_toon(page, web_url: str, api_url: str, character_id_value: str) -> None:
    page.goto(browser_page_url(web_url, "toon-client.html", api_url), wait_until="domcontentloaded")
    page.locator("#stage").wait_for(timeout=15000)
    page.wait_for_function("() => window.app?.connected", timeout=20000)
    page.wait_for_function("() => window.app?.characterList?.length > 0", timeout=20000)
    select_player(
        page,
        character_id_value,
        """(id) => (
          window.app?.control?.characterId === id
          && window.app?.characterProjection?.characterId === id
          && window.app.characterProjection.actions?.length
        )""",
    )
    page.wait_for_function(
        "() => document.querySelectorAll('#stage .sprite').length >= 1",
        timeout=20000,
    )
    clean_screenshot_overlays(page)


def connect_web_tui(page, web_url: str, api_url: str, character_id_value: str) -> None:
    page.goto(browser_page_url(web_url, "web-tui.html", api_url), wait_until="domcontentloaded")
    wait_for_connected(page)
    page.wait_for_function("() => window.app?.characters?.length > 0", timeout=20000)
    select_player(
        page,
        character_id_value,
        """(id) => (
          window.app?.playerId === id
          && window.app?.projection?.characterId === id
          && window.app.projection.actions?.length
        )""",
    )
    expect(page.locator("#room-title")).not_to_have_text("Room", timeout=10000)
    expect(page.locator("#verbs")).not_to_be_empty(timeout=10000)
    clean_screenshot_overlays(page)


def connect_web_repl(page, web_url: str, api_url: str, character_id_value: str) -> None:
    page.goto(browser_page_url(web_url, "web-repl.html", api_url), wait_until="domcontentloaded")
    wait_for_connected(page)
    page.wait_for_function("() => window.app?.characters?.length > 0", timeout=20000)
    select_player(
        page,
        character_id_value,
        """(id) => (
          window.app?.playerId === id
          && window.app?.projection?.characterId === id
          && window.app.projection.actions?.length
        )""",
    )
    expect(page.locator("#side-actions")).not_to_be_empty(timeout=10000)
    clean_screenshot_overlays(page)


def submit_repl_command(page, line: str) -> None:
    page.locator("#repl-input").fill(line)
    page.locator("#btn-send").click()
    page.wait_for_timeout(350)


def queue_visible_say(page, api_url: str, character_id_value: str, text: str) -> None:
    state = page.evaluate(
        """() => ({
          projection: window.app?.projection || window.app?.characterProjection || null,
          control: window.app?.control || null,
        })"""
    )
    projection = state.get("projection") or {}
    control = state.get("control") or {}
    say = next(
        (
            action
            for action in projection.get("actions") or []
            if (action.get("tool_name") or action.get("command_type")) == "say"
        ),
        None,
    )
    if not say or not control:
        return
    cost = say.get("cost") or {"action": 1, "focus": 1}
    claim_id = control.get("claimId") or control.get("claim_id") or ""
    claim_secret = control.get("claimSecret") or control.get("claim_secret") or ""
    api_post(
        api_url,
        "/play/world/commands",
        {
            "character_id": character_id_value,
            "controller_id": control.get("controllerId") or control.get("controller_id"),
            "controller_generation": int(control.get("generation") or control.get("controller_generation") or 0),
            **({"claim_id": claim_id} if claim_id else {}),
            "command_type": say.get("command_type") or "say",
            "payload": {"text": text},
            "cost": {
                "action": int(cost.get("action") or 0),
                "focus": int(cost.get("focus") or 0),
            },
            "lane": say.get("lane") or "world",
            "on_insufficient_points": "queue",
        },
        extra_headers=(
            {"X-Bunnyland-Claim-Secret": claim_secret}
            if claim_secret
            else None
        ),
    )


def capture_toon(
    page,
    web_url: str,
    api_url: str,
    character_id_value: str,
    out_path: Path,
) -> None:
    connect_toon(page, web_url, api_url, character_id_value)
    queue_visible_say(page, api_url, character_id_value, "hello from the itch screenshot run")
    page.evaluate("() => window.app?.refresh?.()")
    page.wait_for_timeout(1000)
    clean_screenshot_overlays(page)
    page.screenshot(path=str(out_path), full_page=True)


def capture_toon_action_selector(
    page,
    web_url: str,
    api_url: str,
    character_id_value: str,
    out_path: Path,
) -> None:
    connect_toon(page, web_url, api_url, character_id_value)
    opened = open_first_target_action(page, "#actions-body .verb.ready[data-tool]")
    if opened:
        page.locator("#action-form-overlay").wait_for(state="visible", timeout=8000)
    clean_screenshot_overlays(page)
    page.screenshot(path=str(out_path), full_page=True)


def capture_web_tui(
    page,
    web_url: str,
    api_url: str,
    character_id_value: str,
    out_path: Path,
) -> None:
    connect_web_tui(page, web_url, api_url, character_id_value)
    queue_visible_say(page, api_url, character_id_value, "queued from the itch screenshot run")
    page.evaluate("() => window.app?.refresh?.()")
    page.wait_for_timeout(1000)
    clean_screenshot_overlays(page)
    page.screenshot(path=str(out_path), full_page=True)


def capture_web_repl(
    page,
    web_url: str,
    api_url: str,
    character_id_value: str,
    out_path: Path,
) -> None:
    connect_web_repl(page, web_url, api_url, character_id_value)
    commands = [
        "look",
        "inventory",
        "points",
        "queued",
        "say hello from the itch screenshot run",
    ]
    for command in commands:
        submit_repl_command(page, command)
    page.locator("#repl-log").evaluate("(el) => { el.scrollTop = el.scrollHeight; }")
    page.wait_for_timeout(1000)
    clean_screenshot_overlays(page)
    page.screenshot(path=str(out_path), full_page=True)


def capture_world_generator(
    page,
    web_url: str,
    api_url: str,
    out_path: Path,
    operator_token: str | None,
    run_generation: bool,
) -> None:
    page.goto(static_page_url(web_url, "world-generator.html"), wait_until="domcontentloaded")
    page.on("dialog", lambda dialog: dialog.dismiss())
    page.wait_for_function("() => window.app", timeout=15000)
    page.locator("#seed-input").fill(
        "a moonlit clockwork garden with talkative caretakers and tiny hidden workshops"
    )
    page.locator("#max-rooms").fill("6")
    if not page.locator("#confirm-reset").is_checked():
        page.locator("#confirm-reset").check()
    headers = operator_headers_js(operator_token)
    if not headers:
        page.evaluate(
            """async (apiUrl) => {
              window.app.base = apiUrl;
              await window.app._fetchSnapshot();
              window.app._renderGenerators();
              window.app._setStatus('live snapshot · operator token required for generation', 'err');
              window.app._log('Loaded live world snapshot from the configured server', 'ok');
              window.app._log('Set BUNNYLAND_OPERATOR_TOKEN and BUNNYLAND_RUN_WORLD_GENERATION=1 to generate a replacement world', '');
            }""",
            api_url,
        )
        page.wait_for_timeout(1000)
        clean_screenshot_overlays(page)
        page.screenshot(path=str(out_path), full_page=True)
        return

    page.evaluate(
        """async ({apiUrl, headers}) => {
          const getJson = async (path) => {
            const response = await fetch(`${apiUrl}${path}`, {headers});
            const data = await response.json().catch(() => ({}));
            if (!response.ok) throw new Error(data.detail || `HTTP ${response.status}`);
            return data;
          };
          const [generators, snapshot] = await Promise.all([
            getJson('/admin/world/generators'),
            getJson('/admin/world/snapshot'),
          ]);
          window.app.base = apiUrl;
          window.app.generators = generators.generators || [];
          window.app._applySnapshot(snapshot);
          window.app._renderGenerators();
          window.app._setStatus('live', 'ok');
          window.app._log('Loaded live world snapshot from the configured server', 'ok');
        }""",
        {"apiUrl": api_url, "headers": headers},
    )
    if run_generation:
        page.evaluate(
            """async ({apiUrl, headers}) => {
              const generator = document.getElementById('generator-select').value;
              const seed = document.getElementById('seed-input').value.trim();
              const maxRooms = Number(document.getElementById('max-rooms').value || 0);
              const response = await fetch(`${apiUrl}/admin/world/generate`, {
                method: 'POST',
                headers: {...headers, 'Content-Type': 'application/json'},
                body: JSON.stringify({
                  seed,
                  generator,
                  max_rooms: maxRooms > 0 ? maxRooms : null,
                  confirm_reset: true,
                  save: false,
                }),
              });
              const data = await response.json().catch(() => ({}));
              if (!response.ok) throw new Error(data.detail || `HTTP ${response.status}`);
              window.app._log(`Generation job ${data.job_id} is ${data.status}`, 'ok');
            }""",
            {"apiUrl": api_url, "headers": headers},
        )
        page.wait_for_function(
            "() => document.querySelector('#activity-list')?.textContent.match(/Generated|Generation complete|Generation job/)",
            timeout=120000,
        )
    else:
        page.evaluate(
            """() => {
              window.app._log('Prompt staged for live generation preview', 'ok');
              window.app._log('Set BUNNYLAND_RUN_WORLD_GENERATION=1 with an operator token to replace the live world', '');
            }"""
        )
    page.wait_for_timeout(1000)
    clean_screenshot_overlays(page)
    page.screenshot(path=str(out_path), full_page=True)


def capture_inspector(
    page,
    web_url: str,
    api_url: str,
    out_path: Path,
    character_id_value: str,
    operator_token: str | None,
) -> None:
    target = f"map/{character_id_value}"
    page.goto(
        static_page_url(web_url, "inspector.html") + f"#{urllib.parse.quote(target)}",
        wait_until="domcontentloaded",
    )
    page.wait_for_function("() => window.app", timeout=15000)
    headers = operator_headers_js(operator_token)
    if headers:
        page.evaluate(
            """async ({apiUrl, headers}) => {
              const response = await fetch(`${apiUrl}/admin/world/snapshot`, {headers});
              const data = await response.json().catch(() => ({}));
              if (!response.ok) throw new Error(data.detail || `HTTP ${response.status}`);
              window.app._apiBase = apiUrl;
              window.app._applyWorld(parseApiSnapshot(data), {resetView: true});
              window.app._setApiStatus('live', `● Live · epoch ${window.app.world.epoch}s`);
            }""",
            {"apiUrl": api_url, "headers": headers},
        )
    else:
        page.goto(
            browser_page_url(web_url, "inspector.html", api_url) + f"#{urllib.parse.quote(target)}",
            wait_until="domcontentloaded",
        )
    page.wait_for_function("() => window.app && window.app.world?.entities", timeout=30000)
    page.wait_for_timeout(1000)
    page.evaluate(
        """(id) => {
          if (window.app.world?.entities?.[id]) window.app.selectEntity(id);
        }""",
        character_id_value,
    )
    page.locator("#search-input").fill(character_id_value)
    page.wait_for_timeout(1000)
    clean_screenshot_overlays(page)
    page.screenshot(path=str(out_path), full_page=True)


def capture_discord(page, out_path: Path) -> bool:
    url = os.environ.get("BUNNYLAND_DISCORD_URL")
    if not url:
        source = os.environ.get("BUNNYLAND_DISCORD_SCREENSHOT")
        if source:
            shutil.copyfile(source, out_path)
            return True
        return False
    page.goto(url, wait_until="domcontentloaded")
    page.wait_for_timeout(int(os.environ.get("BUNNYLAND_DISCORD_WAIT_MS", "5000")))
    clean_screenshot_overlays(page)
    page.screenshot(path=str(out_path), full_page=True)
    return True


def terminal_capture_command(out_path: Path, width: int, height: int, api_url: str) -> list[str] | None:
    template = os.environ.get("BUNNYLAND_TEXTUAL_CAPTURE_CMD")
    if not template:
        return None
    return [
        part.format(
            output=str(out_path),
            width=str(width),
            height=str(height),
            server=api_url,
        )
        for part in template.split()
    ]


def rasterize_svg(browser, svg_path: Path, out_path: Path, width: int, height: int) -> None:
    page = browser.new_page(viewport={"width": width, "height": height})
    try:
        page.goto(svg_path.as_uri(), wait_until="load")
        page.screenshot(path=str(out_path), full_page=False, timeout=60000)
    finally:
        page.close()


def capture_terminal_tui(
    browser,
    web_url: str,
    api_url: str,
    character_id_value: str,
    out_path: Path,
    width: int,
    height: int,
    open_target_action: bool = False,
) -> bool:
    command = terminal_capture_command(out_path, width, height, api_url)
    if command:
        subprocess.run(command, check=True, cwd=Path(__file__).resolve().parents[2])
        return out_path.exists()

    server_repo = Path(
        os.environ.get(
            "BUNNYLAND_SERVER_REPO",
            Path(__file__).resolve().parents[2] / "bunnyland-server",
        )
    )
    helper = server_repo / "scripts" / "textual-tui-screenshot"
    if helper.exists() and shutil.which("uv"):
        columns = max(80, min(240, width // 12))
        rows = max(24, min(90, height // 22))
        with tempfile.NamedTemporaryFile(suffix=".svg", delete=False) as handle:
            svg_path = Path(handle.name)
        try:
            subprocess.run(
                [
                    "uv",
                    "run",
                    "--all-extras",
                    "python",
                    str(helper),
                    "--server",
                    api_url,
                    "--output",
                    str(svg_path),
                    "--columns",
                    str(columns),
                    "--rows",
                    str(rows),
                    *(["--open-target-action"] if open_target_action else []),
                ],
                check=True,
                cwd=server_repo,
            )
            rasterize_svg(browser, svg_path, out_path, width, height)
            return out_path.exists()
        finally:
            svg_path.unlink(missing_ok=True)

    page = browser.new_page(viewport={"width": width, "height": height})
    try:
        connect_web_tui(page, web_url, api_url, character_id_value)
        if open_target_action:
            opened = open_first_target_action(page, "#verbs .option")
            if opened:
                page.locator("#action-form-overlay").wait_for(state="visible", timeout=8000)
        page.add_style_tag(
            content="""
            body::before {
              content: "Terminal TUI capture fallback: configure BUNNYLAND_TEXTUAL_CAPTURE_CMD for a native terminal screenshot.";
              position: fixed;
              left: 10px;
              bottom: 8px;
              z-index: 99999;
              padding: 5px 8px;
              border: 1px solid #6b7280;
              background: #111827;
              color: #f9fafb;
              font: 12px monospace;
            }
            """
        )
        clean_screenshot_overlays(page)
        page.screenshot(path=str(out_path), full_page=True)
        return True
    finally:
        page.close()


def composite_side_by_side(left_path: Path, right_path: Path, out_path: Path, width: int, height: int) -> None:
    html = f"""
    <!doctype html>
    <html>
    <head>
      <meta charset="utf-8">
      <style>
        * {{ box-sizing: border-box; }}
        body {{
          margin: 0;
          width: {width}px;
          height: {height}px;
          overflow: hidden;
          background: #05070a;
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 10px;
          padding: 10px;
        }}
        img {{
          width: 100%;
          height: 100%;
          object-fit: cover;
          object-position: top left;
          border: 1px solid #2f3a4a;
        }}
      </style>
    </head>
    <body>
      <img src="{left_path.as_uri()}" alt="Toon client">
      <img src="{right_path.as_uri()}" alt="Web REPL">
    </body>
    </html>
    """
    with tempfile.NamedTemporaryFile("w", suffix=".html", delete=False, encoding="utf-8") as handle:
        handle.write(textwrap.dedent(html))
        html_path = Path(handle.name)
    try:
        with sync_playwright() as playwright:
            browser = launch_browser(playwright)
            page = browser.new_page(viewport={"width": width, "height": height})
            page.goto(html_path.as_uri(), wait_until="load")
            page.screenshot(path=str(out_path), full_page=True)
            browser.close()
    finally:
        html_path.unlink(missing_ok=True)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--web-url",
        default=os.environ.get("BUNNYLAND_WEB_URL"),
        help=(
            "Existing Bunnyland web URL. If omitted, the script starts a local static "
            "web server from this checkout."
        ),
    )
    parser.add_argument(
        "--api-url",
        default=os.environ.get("BUNNYLAND_API_URL"),
        help=(
            "Existing Bunnyland API URL. If omitted, the script starts a local Bunnyland "
            "server from BUNNYLAND_SERVER_REPO or ../bunnyland-server."
        ),
    )
    parser.add_argument(
        "--live-sandbox",
        action="store_true",
        help="Use the public sandbox defaults instead of starting local services.",
    )
    parser.add_argument(
        "--resolution",
        type=parse_resolution,
        default=parse_resolution(os.environ.get("BUNNYLAND_SCREENSHOT_RESOLUTION", "1080p")),
        help="Preset 480p/720p/1080p/1440p/4k or WIDTHxHEIGHT. Default: 1080p.",
    )
    parser.add_argument(
        "--out-dir",
        type=Path,
        default=Path(os.environ.get("BUNNYLAND_ITCH_SCREENSHOT_DIR", DEFAULT_OUT_DIR)),
    )
    args = parser.parse_args(argv)

    width, height = args.resolution
    web_repo = Path(__file__).resolve().parents[1]
    server_repo = Path(
        os.environ.get(
            "BUNNYLAND_SERVER_REPO",
            Path(__file__).resolve().parents[2] / "bunnyland-server",
        )
    )
    managed: list[ManagedProcess] = []
    local_operator_token: str | None = None
    try:
        web_url_value = args.web_url
        api_url_value = args.api_url
        if args.live_sandbox:
            web_url_value = web_url_value or DEFAULT_WEB_URL
            api_url_value = api_url_value or DEFAULT_API_URL

        if not api_url_value:
            if not server_repo.exists():
                raise RuntimeError(f"BUNNYLAND_SERVER_REPO does not exist: {server_repo}")
            api_port = int(os.environ.get("BUNNYLAND_LOCAL_API_PORT") or reserve_port())
            api_process, local_operator_token = start_local_api(server_repo, api_port)
            managed.append(api_process)
            api_url_value = f"http://{LOCAL_API_HOST}:{api_port}"
            wait_for_http(f"{api_url_value}/public/health", "local Bunnyland API")
            api_process.check_running()

        if not web_url_value:
            web_port = int(os.environ.get("BUNNYLAND_LOCAL_WEB_PORT") or reserve_port())
            web_process = start_local_web(web_repo, web_port)
            managed.append(web_process)
            web_url_value = f"http://{LOCAL_WEB_HOST}:{web_port}"
            wait_for_http(f"{web_url_value}/toon-client.html", "local Bunnyland web server")
            web_process.check_running()

        web_url = web_url_value.rstrip("/")
        api_url = api_url_value.rstrip("/")
        return run_capture(web_url, api_url, width, height, args.out_dir, local_operator_token)
    finally:
        for process in reversed(managed):
            process.stop()


def run_capture(
    web_url: str,
    api_url: str,
    width: int,
    height: int,
    out_dir: Path,
    local_operator_token: str | None,
) -> int:
    out_dir.mkdir(parents=True, exist_ok=True)

    wait_for_api(api_url)
    picked_character, _projection = choose_character(api_url)
    operator_token = local_operator_token or os.environ.get("BUNNYLAND_OPERATOR_TOKEN")
    run_generation = os.environ.get("BUNNYLAND_RUN_WORLD_GENERATION") == "1"
    if run_generation and not operator_token:
        raise RuntimeError("BUNNYLAND_RUN_WORLD_GENERATION=1 requires an operator token")

    outputs = {
        "toon": out_dir / "01-toon-client.png",
        "web_tui": out_dir / "02-web-tui.png",
        "web_repl": out_dir / "03-web-repl.png",
        "world_generator": out_dir / "04-world-generator.png",
        "inspector": out_dir / "05-world-inspector.png",
        "discord": out_dir / "06-discord.png",
        "terminal_tui": out_dir / "07-terminal-tui.png",
        "two_clients": out_dir / "08-toon-and-repl.png",
        "toon_action_selector": out_dir / "09-toon-action-selector.png",
        "terminal_tui_action_selector": out_dir / "10-terminal-tui-action-selector.png",
        "two_clients_action_selector": out_dir / "11-toon-selector-and-repl.png",
    }
    skipped: list[str] = []

    with sync_playwright() as playwright:
        browser = launch_browser(playwright)
        context = browser.new_context(
            viewport={"width": width, "height": height},
            device_scale_factor=1,
        )

        toon = context.new_page()
        capture_toon(toon, web_url, api_url, picked_character, outputs["toon"])

        toon_selector = context.new_page()
        capture_toon_action_selector(
            toon_selector,
            web_url,
            api_url,
            picked_character,
            outputs["toon_action_selector"],
        )

        tui = context.new_page()
        capture_web_tui(tui, web_url, api_url, picked_character, outputs["web_tui"])

        repl = context.new_page()
        capture_web_repl(repl, web_url, api_url, picked_character, outputs["web_repl"])

        generator = context.new_page()
        capture_world_generator(
            generator,
            web_url,
            api_url,
            outputs["world_generator"],
            operator_token,
            run_generation,
        )

        inspector = context.new_page()
        capture_inspector(
            inspector,
            web_url,
            api_url,
            outputs["inspector"],
            picked_character,
            operator_token,
        )

        discord = context.new_page()
        if not capture_discord(discord, outputs["discord"]):
            skipped.append("06-discord: set BUNNYLAND_DISCORD_URL or BUNNYLAND_DISCORD_SCREENSHOT")

        if not capture_terminal_tui(
            browser,
            web_url,
            api_url,
            picked_character,
            outputs["terminal_tui"],
            width,
            height,
        ):
            skipped.append("07-terminal-tui: set BUNNYLAND_TEXTUAL_CAPTURE_CMD")

        if not capture_terminal_tui(
            browser,
            web_url,
            api_url,
            picked_character,
            outputs["terminal_tui_action_selector"],
            width,
            height,
            open_target_action=True,
        ):
            skipped.append("10-terminal-tui-action-selector: set BUNNYLAND_TEXTUAL_CAPTURE_CMD")

        context.close()
        browser.close()

    composite_side_by_side(outputs["toon"], outputs["web_repl"], outputs["two_clients"], width, height)
    composite_side_by_side(
        outputs["toon_action_selector"],
        outputs["web_repl"],
        outputs["two_clients_action_selector"],
        width,
        height,
    )

    print(json.dumps({
        "api_url": api_url,
        "web_url": web_url,
        "resolution": {"width": width, "height": height},
        "character_id": picked_character,
        "screenshots": {key: str(path) for key, path in outputs.items() if path.exists()},
        "skipped": skipped,
    }, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
