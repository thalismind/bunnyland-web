#!/usr/bin/env python3
"""Playwright regression test for the Bunnyland Web REPL.

The test mocks the player-facing API, claims a character, submits a typed command, and
asserts the command body sent to ``/world/commands``.
"""

from __future__ import annotations

import json
import os
import shutil
import time
from pathlib import Path

from playwright.sync_api import expect, sync_playwright

from playwright_coverage import PlaywrightCoverage


BASE_URL = os.environ.get("BUNNYLAND_WEB_BASE_URL", "http://127.0.0.1:8080").rstrip("/")
SCREENSHOT_DIR = Path(os.environ.get("BUNNYLAND_PLAYWRIGHT_SCREENSHOT_DIR", "/tmp"))

CHARACTER = "character:1"
OTHER = "character:2"
ROOM = "room:1"
EXIT = "room:2"

CHARACTER_LIST = {
    "world_epoch": 8,
    "characters": [{"character_id": CHARACTER, "name": "Bun", "kind": "character"}],
}

CHARACTER_PROJECTION = {
    "character_id": CHARACTER,
    "world_epoch": 8,
    "room": {
        "id": ROOM,
        "title": "Parlor",
        "exits": [{"id": EXIT, "direction": "north", "label": "Hallway"}],
        "entities": [
            {"id": CHARACTER, "name": "Bun", "kind": "character", "is_character": True},
            {"id": OTHER, "name": "Marlow", "kind": "character", "is_character": True},
        ],
    },
    "inventory": [{"id": "item:1", "label": "a brass key", "kind": "item"}],
    "points": {"action": 5, "action_max": 5, "focus": 3, "focus_max": 3},
    "controller": {"controller_id": "web:repl", "generation": 3},
    "target_groups": {
        "characters": [{"id": OTHER, "label": "Marlow", "kind": "character"}],
        "exits": [{"id": EXIT, "label": "north", "kind": "exit"}],
        "inventory": [{"id": "item:1", "label": "a brass key", "kind": "item"}],
    },
    "actions": [
        {
            "command_type": "shout",
            "tool_name": "shout",
            "title": "Shout",
            "lane": "world",
            "cost": {"action": 1, "focus": 4},
            "arguments": [],
            "available": False,
            "enough_action_points": True,
            "enough_focus_points": False,
            "has_required_target": True,
            "meets_requirements": True,
            "unavailable_reason": "not enough focus points",
        },
        {
            "command_type": "say",
            "tool_name": "say",
            "title": "Say",
            "lane": "world",
            "cost": {"action": 1, "focus": 1},
            "arguments": [
                {"key": "text", "title": "text", "kind": "string", "required": True},
            ],
        },
        {
            "command_type": "tell",
            "tool_name": "tell",
            "title": "Tell",
            "lane": "world",
            "cost": {"action": 1, "focus": 1},
            "arguments": [
                {
                    "key": "target_id",
                    "title": "target",
                    "kind": "entity",
                    "required": True,
                    "target_group": "characters",
                },
                {"key": "text", "title": "text", "kind": "string", "required": True},
            ],
        },
    ],
}

QUEUED = {
    "character_id": CHARACTER,
    "world_epoch": 8,
    "generated_at_unix": time.time(),
    "next_tick_at_unix": time.time() + 45,
    "tick_seconds": 10,
    "commands": [
        {
            "command_id": "queued-1",
            "character_id": CHARACTER,
            "command_type": "say",
            "payload": {"text": "later"},
            "cost": {"action": 1, "focus": 1},
            "lane": "world",
            "submitted_at_epoch": 8,
        }
    ],
}
EVENTS = {"events": []}


def launch_browser(playwright):
    chrome = (
        os.environ.get("BUNNYLAND_CHROME")
        or shutil.which("google-chrome")
        or shutil.which("chromium")
        or shutil.which("chromium-browser")
    )
    kwargs = {"headless": True}
    if chrome:
        kwargs["executable_path"] = chrome
        kwargs["args"] = ["--no-sandbox"]
    return playwright.chromium.launch(**kwargs)


def json_route(body):
    def handler(route):
        route.fulfill(status=200, content_type="application/json", body=json.dumps(body))

    return handler


def install_routes(page, posted: list[dict]) -> None:
    deleted: list[str] = []
    page.exposed_deleted_commands = deleted

    def command_handler(route):
        posted.append(json.loads(route.request.post_data or "{}"))
        route.fulfill(status=200, content_type="application/json", body=json.dumps({"ok": True}))

    def cancel_handler(route):
        deleted.append(route.request.url)
        route.fulfill(
            status=200,
            content_type="application/json",
            body=json.dumps({"cancelled": True}),
        )

    def claim_handler(route):
        route.fulfill(
            status=200,
            content_type="application/json",
            body=json.dumps(
                {
                    "character_id": CHARACTER,
                    "controller_id": "web:repl",
                    "controller_generation": 3,
                }
            ),
        )

    page.route("**/world/events/recent", json_route(EVENTS))
    page.route("**/world/characters", json_route(CHARACTER_LIST))
    page.route("**/world/character/*", json_route(CHARACTER_PROJECTION))
    page.route("**/world/character/*/commands", json_route(QUEUED))
    page.route("**/world/controllers/web/claim", claim_handler)
    page.route("**/world/controllers/web/fallback", claim_handler)
    page.route("**/world/commands", command_handler)
    page.route("**/world/character/*/commands/*", cancel_handler)


def connect_and_select(page) -> None:
    page.goto(f"{BASE_URL}/web-repl.html", wait_until="domcontentloaded")
    page.locator("#api-url").fill("/api")
    page.locator("#btn-connect").click()
    expect(page.locator('label[for="player-select"]')).to_have_text("Character:")
    page.wait_for_function("() => window.app?.characters?.length > 0", timeout=15000)
    page.locator("#player-select").select_option(CHARACTER)
    page.wait_for_function(
        """(id) => (
            window.app?.projection?.characterId === id
            && window.app.projection.actions?.length > 0
        )""",
        arg=CHARACTER,
        timeout=15000,
    )
    expect(page.locator("#side-actions")).to_contain_text("say")
    expect(page.locator("#side-actions")).to_contain_text("not enough focus points")
    expect(page.locator("#side-actions .side-row").nth(0)).to_contain_text("say")
    expect(page.locator("#side-actions .side-row.unavailable")).to_contain_text("shout")
    page.locator("#repl-input").fill("queued")
    page.locator("#btn-send").click()
    expect(page.locator("#repl-log")).to_contain_text("Next tick in")
    expect(page.locator("#repl-log")).to_contain_text("text=later")


def submit_say(page, posted: list[dict]) -> None:
    page.locator("#repl-input").fill("say hello web")
    page.locator("#btn-send").click()
    page.wait_for_function("() => document.querySelector('#repl-log')?.textContent.includes('» say')")
    if not posted:
        raise AssertionError("REPL did not post a command")
    body = posted[-1]
    expected = {
        "character_id": CHARACTER,
        "controller_id": "web:repl",
        "controller_generation": 3,
        "command_type": "say",
        "payload": {"text": "hello web"},
        "cost": {"action": 1, "focus": 1},
        "lane": "world",
        "on_insufficient_points": "queue",
    }
    if body != expected:
        raise AssertionError(f"unexpected command body: {body!r}")


def submit_unavailable(page, posted: list[dict]) -> None:
    page.locator("#repl-input").fill("shout")
    page.locator("#btn-send").click()
    page.wait_for_function("() => document.querySelector('#repl-log')?.textContent.includes('» shout')")
    if not posted or posted[-1]["command_type"] != "shout":
        raise AssertionError(f"unavailable action was not posted; posted={posted!r}")
    if posted[-1]["on_insufficient_points"] != "queue":
        raise AssertionError(f"unavailable action should still queue: {posted[-1]!r}")


def submit_tell_named_target(page, posted: list[dict]) -> None:
    page.locator("#repl-input").fill("tell Marlow psst")
    page.locator("#btn-send").click()
    page.wait_for_function("() => document.querySelector('#repl-log')?.textContent.includes('» tell')")
    body = posted[-1]
    if body["command_type"] != "tell" or body["payload"] != {"target_id": OTHER, "text": "psst"}:
        raise AssertionError(f"tell command did not resolve visible target: {body!r}")


def cancel_queued_command(page) -> None:
    page.locator("#repl-input").fill("cancel queued-1")
    with page.expect_response("**/world/character/*/commands/*"):
        page.locator("#btn-send").click()
    expect(page.locator("#repl-log")).to_contain_text("Cancelled queued-1.")
    deleted = page.exposed_deleted_commands
    if not deleted or "controller_id=web%3Arepl" not in deleted[-1] or "controller_generation=3" not in deleted[-1]:
        raise AssertionError(f"queued command was not cancelled with controller identity: {deleted!r}")


def narrate_event(page) -> None:
    EVENTS["events"] = [
        {
            "event_type": "ActorMovedEvent",
            "data": {
                "event_type": "ActorMovedEvent",
                "event": {
                    "event_id": "event-moved-1",
                    "visibility": "directed",
                    "actor_id": CHARACTER,
                    "arrival_summary": "You arrive in the Hallway.",
                },
            },
        }
    ]
    page.evaluate("() => window.app.refresh()")
    expect(page.locator("#repl-log")).to_contain_text("You arrive in the Hallway.")


def main() -> None:
    SCREENSHOT_DIR.mkdir(parents=True, exist_ok=True)
    with sync_playwright() as playwright:
        coverage = PlaywrightCoverage("web-repl")
        browser = launch_browser(playwright)
        page = coverage.new_page(browser, viewport={"width": 1280, "height": 800})
        posted: list[dict] = []
        install_routes(page, posted)

        connect_and_select(page)
        cancel_queued_command(page)
        narrate_event(page)
        submit_unavailable(page, posted)
        submit_say(page, posted)
        submit_tell_named_target(page, posted)
        page.screenshot(path=str(SCREENSHOT_DIR / "bunnyland-web-repl.png"))
        coverage.close_browser(browser)

    print("web_repl=ok")


if __name__ == "__main__":
    main()
