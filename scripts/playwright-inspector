#!/usr/bin/env python3
"""Playwright checks for the Bunnyland snapshot inspector."""

from pathlib import Path
import json
import os
import shutil

from playwright.sync_api import sync_playwright

from playwright_coverage import PlaywrightCoverage
from playwright_server import ensure_web_server


BASE_URL = os.environ.get("BUNNYLAND_WEB_BASE_URL", "http://127.0.0.1:8091").rstrip("/")
SCREENSHOT_DIR = Path(os.environ.get("BUNNYLAND_PLAYWRIGHT_SCREENSHOT_DIR", "/tmp"))
SCREENSHOT = SCREENSHOT_DIR / "bunnyland-web-node-readability.png"


def assert_no_rect_overlaps(rects):
    for index, left in enumerate(rects):
        for right in rects[index + 1 :]:
            overlaps = (
                left["x"] < right["x"] + right["w"]
                and left["x"] + left["w"] > right["x"]
                and left["y"] < right["y"] + right["h"]
                and left["y"] + left["h"] > right["y"]
            )
            if overlaps:
                raise AssertionError(f"room nodes overlap: {left['id']} {left!r} and {right['id']} {right!r}")


def launch_browser(playwright):
    chrome = (
        os.environ.get("BUNNYLAND_CHROME")
        or shutil.which("google-chrome")
        or shutil.which("chromium")
        or shutil.which("chromium-browser")
    )
    kwargs = {"headless": True}
    if chrome:
        kwargs["executable_path"] = chrome
        kwargs["args"] = ["--no-sandbox"]
    return playwright.chromium.launch(**kwargs)


def main() -> None:
    ensure_web_server(BASE_URL)
    SCREENSHOT_DIR.mkdir(parents=True, exist_ok=True)
    with sync_playwright() as playwright:
        coverage = PlaywrightCoverage("inspector")
        browser = launch_browser(playwright)
        page = coverage.new_page(browser, viewport={"width": 1440, "height": 900}, device_scale_factor=1)
        page.add_init_script(
            """
            window.__promptCalls = [];
            window.__promptResponses = [];
            window.__webSocketUrls = [];
            window.__webSocketFrames = [];
            window.WebSocket = class {
              constructor(url) {
                this.url = url;
                window.__webSocketUrls.push(String(url));
                setTimeout(() => {
                  if (this.onopen) this.onopen({});
                }, 0);
              }
              close() {
                if (this.onclose) this.onclose({});
              }
            };
            """
        )
        page.route("**/api/v1/auth/session", lambda route: route.fulfill(status=200, json={
            "subject": "admin", "scopes": ["world:admin"],
            "expires_at": 2000000000, "rotate_after": None, "rotation_eligible": False,
        }))
        admin_calls = []

        def admin_world_handler(route):
            request = route.request
            body = json.loads(request.post_data or "{}")
            admin_calls.append({"method": request.method, "body": body})
            route.fulfill(
                status=200,
                json={
                    "ok": True,
                    "world_epoch": 2,
                    "changed_entities": [],
                    "deleted_entities": [],
                },
            )

        page.route("**/admin/world", admin_world_handler)
        page.route("**/admin/world/runtime", lambda route: route.fulfill(status=401, json={"detail": "locked"}))
        page.goto(f"{BASE_URL}/inspector.html?server=%2Fapi%2Fv1", wait_until="domcontentloaded")
        page.wait_for_function("window.app && window.app._apiBase")
        page.evaluate(
            """
            () => {
              BunnylandUI.promptDialog = async (message) => {
                window.__promptCalls.push(String(message || ''));
                return window.__promptResponses.shift() ?? null;
              };
              BunnylandUI.confirmDialog = async () => true;
            }
            """
        )
        page.wait_for_timeout(200)
        if not page.locator("#client-menu-dialog:not(.hidden)").is_visible():
            raise AssertionError("client menu did not open on first inspector load")
        menu_titles = page.locator(".client-menu-item-title").evaluate_all(
            "(els) => els.map((el) => el.childNodes[0].textContent.trim())"
        )
        expected_titles = [
            "Welcome",
            "Bunnyland.dev",
            "Web TUI",
            "Toon Client",
            "Web REPL",
            "Character Profile",
            "World Generator",
            "World Graph",
            "Behavior Editor",
            "Memory Editor",
            "Script Editor",
            "World Editor",
            "Event Stream",
            "Trace Analyzer",
        ]
        if menu_titles != expected_titles:
            raise AssertionError(f"unexpected client menu order: {menu_titles!r}")
        website_link = page.locator('.client-menu-item[href="https://bunnyland.dev/"]')
        if website_link.get_attribute("target") != "_blank" or website_link.get_attribute("rel") != "noopener":
            raise AssertionError("bunnyland.dev menu link should open as an external link")
        toon_href = page.locator('.client-menu-item[href^="toon-client.html"]').get_attribute("href")
        if not toon_href or "server=%2Fapi%2Fv1" not in toon_href:
            raise AssertionError(f"toon client menu link did not preserve server URL: {toon_href!r}")
        tui_href = page.locator('.client-menu-item[href^="web-tui.html"]').get_attribute("href")
        if not tui_href or "server=%2Fapi%2Fv1" not in tui_href:
            raise AssertionError(f"web tui menu link did not preserve server URL: {tui_href!r}")
        repl_href = page.locator('.client-menu-item[href^="web-repl.html"]').get_attribute("href")
        if not repl_href or "server=%2Fapi%2Fv1" not in repl_href:
            raise AssertionError(f"web repl menu link did not preserve server URL: {repl_href!r}")
        chat_href = page.locator('.client-menu-item[href^="character.html"]').get_attribute("href")
        if not chat_href or "server=%2Fapi%2Fv1" not in chat_href:
            raise AssertionError(f"character profile menu link did not preserve server URL: {chat_href!r}")
        page.keyboard.press("Escape")
        prompt_calls = page.evaluate("window.__promptCalls")
        if prompt_calls:
            raise AssertionError(f"unexpected admin prompts during read-only connect: {prompt_calls!r}")

        page.evaluate(
            """
            () => window.app.loadSnapshot({
              metadata: { version: '1.0', epoch: 2 },
              bunnyland: {},
              entities: { world_state: { prefab: 'entity', created_epoch: 0 } },
              components: {
                WorldClockComponent: {
                  world_state: { game_time_seconds: 2, tick_index: 1, time_scale: 1 },
                },
                WorldInfoComponent: {
                  world_state: {
                    title: 'Test World',
                    description: 'A world used by the inspector regression.',
                    content_flags: ['pvp'],
                  },
                },
              },
              relationships: {},
            })
            """
        )
        page.locator("#inspector-edit-world-details").click()
        page.wait_for_function(
            "document.querySelector('#inspector-world-title')?.value === 'Test World'"
        )
        if page.locator("#inspector-world-title").evaluate("(input) => input.tagName") != "INPUT":
            raise AssertionError("inspector world title editor should be a one-line input")
        page.locator("#inspector-world-title").fill("Clover City")
        page.locator("#inspector-world-description").fill(
            "A world used by the **inspector** regression."
        )
        page.wait_for_function(
            "document.querySelector('#inspector-world-description-preview strong')?.textContent === 'inspector'"
        )
        page.locator("#inspector-world-content-flags").fill("adult:violence")
        page.locator(".world-details-flag-entry button").click()
        page.locator('[data-content-flag="pvp"]').uncheck()
        page.locator("#inspector-save-world-details").click()
        page.wait_for_function(
            "document.querySelector('#api-status').textContent === '● World details saved'"
        )
        if not any(
            call["method"] == "PATCH"
            and call["body"].get("operations") == [
                {
                    "op": "set_component",
                    "entity_id": "world_state",
                    "component": {
                        "type": "WorldInfoComponent",
                        "fields": {
                            "content_flags": ["adult:violence"],
                            "description": "A world used by the **inspector** regression.",
                            "title": "Clover City",
                        },
                    },
                }
            ]
            for call in admin_calls
        ):
            raise AssertionError(
                f"inspector title editor did not patch WorldInfoComponent: {admin_calls!r}"
            )

        auth_page = coverage.new_page(browser, viewport={"width": 800, "height": 600}, device_scale_factor=1)
        auth_page.add_init_script(
            """
            window.__promptResponses = ['admin', 'secret'];
            window.__promptCalls = [];
            window.__webSocketUrls = [];
            window.__webSocketFrames = [];
            window.WebSocket = class {
              constructor(url) {
                window.__webSocketUrls.push(String(url));
                setTimeout(() => { if (this.onopen) this.onopen({}); }, 0);
              }
              send(frame) { window.__webSocketFrames.push(String(frame)); }
              close() {}
            };
            """
        )
        authenticated = {"value": False}
        def auth_session(route):
            if route.request.method == "POST":
                authenticated["value"] = True
            if not authenticated["value"]:
                route.fulfill(status=401, json={"detail": "bearer token required"})
                return
            route.fulfill(status=200, json={
                "subject": "admin", "scopes": ["world:play", "world:admin"],
                "expires_at": 2000000000, "rotate_after": 1990000000,
                "rotation_eligible": False,
            })

        auth_page.route("**/api/v1/auth/session", auth_session)
        auth_page.route("**/api/v1/admin/world", lambda route: route.fulfill(
            status=200 if authenticated["value"] else 401,
            json={"ok": True} if authenticated["value"] else {"detail": "locked"},
        ))
        auth_page.route("**/api/v1/admin/world/runtime", lambda route: route.fulfill(status=200, json={"running": True, "paused": False}))
        auth_page.goto(f"{BASE_URL}/inspector.html?server=%2Fapi%2Fv1#map", wait_until="domcontentloaded")
        auth_page.get_by_role("button", name="Close client menu").click()
        auth_page.locator("#btn-connect").click()
        requested_scopes = auth_page.locator(".bl-auth-scopes").text_content()
        if "World administration (world:admin)" not in (requested_scopes or ""):
            raise AssertionError(f"admin login modal omitted requested scopes: {requested_scopes!r}")
        auth_page.get_by_label("Username").fill("admin")
        auth_page.get_by_label("Password").fill("secret")
        auth_page.locator("button", has_text="Sign in").click()
        auth_page.wait_for_function("window.__webSocketFrames.length > 0")
        auth_result = auth_page.evaluate(
            """
            () => ({
              prompts: window.__promptCalls,
              sockets: window.__webSocketUrls,
              frames: window.__webSocketFrames,
              apiBase: window.app._apiBase,
            })
            """
        )
        if auth_result["prompts"]:
            raise AssertionError(f"inspector used native prompts instead of the shared login modal: {auth_result!r}")
        expected_socket = f"{BASE_URL.replace('http://', 'ws://').replace('https://', 'wss://')}/api/v1/admin/world/stream"
        if auth_result["sockets"] != [expected_socket]:
            raise AssertionError(f"inspector did not authenticate websocket: {auth_result!r}")
        frames = [json.loads(frame) for frame in auth_result["frames"]]
        if len(frames) != 1 or frames[0].get("type") != "authenticate" or not frames[0].get("data", {}).get("client_id"):
            raise AssertionError(f"inspector did not send first-frame authentication: {auth_result!r}")
        if auth_result["apiBase"] != "/api/v1":
            raise AssertionError(f"inspector changed relative API base unexpectedly: {auth_result!r}")
        auth_page.close()

        theme_contract = page.evaluate(
            """
            () => {
              const root = document.documentElement;
              const readBg = () => getComputedStyle(root).getPropertyValue('--bl-bg').trim();
              BunnylandUI.setColorScheme('dark');
              const darkBefore = root.classList.contains('bl-theme-midnight')
                && root.classList.contains('bl-color-scheme-dark');
              const darkBg = readBg();
              BunnylandUI.setTheme('anime-light');
              const lightApplied = BunnylandUI.currentTheme() === 'candy'
                && BunnylandUI.currentColorScheme() === 'light'
                && root.classList.contains('bl-theme-candy')
                && root.classList.contains('bl-color-scheme-light');
              const lightBg = readBg();
              BunnylandUI.setTheme('dark');
              return {
                darkBefore,
                lightApplied,
                bgChanged: darkBg !== lightBg,
                restored: root.classList.contains('bl-theme-midnight')
                  && root.classList.contains('bl-color-scheme-dark')
                  && !root.classList.contains('bl-theme-candy'),
              };
            }
            """
        )
        if not all(theme_contract.values()):
            raise AssertionError(f"theme class contract failed: {theme_contract!r}")
        page.locator("#btn-client-menu").click()
        page.locator("#client-menu-theme-select").select_option("earth")
        page.locator("#client-menu-color-scheme-select").select_option("light")
        menu_theme = page.evaluate(
            """
            () => ({
              current: BunnylandUI.currentTheme(),
              earth: document.documentElement.classList.contains('bl-theme-earth'),
              light: document.documentElement.classList.contains('bl-color-scheme-light'),
              selectValue: document.getElementById('client-menu-theme-select')?.value,
              schemeValue: document.getElementById('client-menu-color-scheme-select')?.value,
            })
            """
        )
        if menu_theme != {"current": "earth", "earth": True, "light": True, "selectValue": "earth", "schemeValue": "light"}:
            raise AssertionError(f"theme controls did not apply earth light: {menu_theme!r}")
        page.keyboard.press("Escape")

        page.goto(f"{BASE_URL}/toon-client.html", wait_until="domcontentloaded")
        lobby_contract = page.evaluate(
            """
            () => window.parseCharacterList({
              world_epoch: 11,
              characters: [
                { character_id: 'char_1', name: 'Juniper', kind: 'character', suspended: false },
                { character_id: 'char_2', name: 'Bramble', kind: 'character', suspended: true },
              ],
            })
            """
        )
        if lobby_contract["epoch"] != 11 or len(lobby_contract["characters"]) != 2:
            raise AssertionError(f"toon character list was not normalized: {lobby_contract!r}")
        first, second = lobby_contract["characters"]
        if first["id"] != "char_1" or first["name"] != "Juniper" or first["suspended"] is not False:
            raise AssertionError(f"toon character list fields were not normalized: {lobby_contract!r}")
        if second["id"] != "char_2" or second["suspended"] is not True:
            raise AssertionError(f"toon character list suspended flag was not normalized: {lobby_contract!r}")
        projection_contract = page.evaluate(
            """
            () => window.parseCharacterProjection({
              character_id: 'char_1',
              world_epoch: 12,
              points: {
                action: 2,
                action_max: 3,
                focus: 1,
                focus_max: 4,
              },
              controller: {
                controller_id: 'ctrl_1',
                generation: 7,
              },
              target_groups: {
                exit: [
                  { id: 'room_2', label: 'north', kind: 'exit' },
                ],
                object: [
                  { id: 'apple_1', label: 'Apple', kind: 'food' },
                ],
              },
            })
            """
        )
        if projection_contract["characterId"] != "char_1" or projection_contract["worldEpoch"] != 12:
            raise AssertionError(f"toon character projection identity was not normalized: {projection_contract!r}")
        if projection_contract["points"]["action"] != 2 or projection_contract["points"]["focus_max"] != 4:
            raise AssertionError(f"toon character projection points were not preserved: {projection_contract!r}")
        if projection_contract["controller"]["controller_id"] != "ctrl_1":
            raise AssertionError(f"toon character projection controller was not preserved: {projection_contract!r}")
        if projection_contract["targetGroups"]["exit"][0]["value"] != "room_2":
            raise AssertionError(f"toon character projection exits were not normalized: {projection_contract!r}")
        if projection_contract["targetGroups"]["object"][0]["label"] != "Apple":
            raise AssertionError(f"toon character projection objects were not normalized: {projection_contract!r}")
        room_contract = page.evaluate(
            """
            () => window.parseRoomProjection({
              world_epoch: 13,
              room: {
                id: 'room_1',
                title: 'Landing',
                default_start: true,
                sprite: {
                  image_url: '/rooms/landing.png',
                  bounds: { width: 120, height: 80, solid: false },
                },
                entities: [
                  {
                    id: 'char_1',
                    name: 'Juniper',
                    kind: 'character',
                    is_character: true,
                    sprite: {
                      position: { x: 10, y: 20 },
                      layer: 30,
                      bounds: { width: 5, height: 8, solid: true },
                    },
                  },
                ],
                exits: [
                  { id: 'room_2', direction: 'north', label: 'North Room', locked: false },
                ],
              },
            })
            """
        )
        if room_contract["room"]["id"] != "room_1" or room_contract["worldEpoch"] != 13:
            raise AssertionError(f"toon room projection identity was not normalized: {room_contract!r}")
        if room_contract["room"]["sprite"]["image_url"] != "/rooms/landing.png":
            raise AssertionError(f"toon room projection sprite was not preserved: {room_contract!r}")
        if room_contract["entities"][0]["id"] != "char_1" or not room_contract["entities"][0]["isCharacter"]:
            raise AssertionError(f"toon room projection entities were not normalized: {room_contract!r}")
        if room_contract["room"]["exits"][0]["id"] != "room_2":
            raise AssertionError(f"toon room projection exits were not normalized: {room_contract!r}")
        queued_contract = page.evaluate(
            """
            () => window.parseQueuedCommands({
              character_id: 'char_1',
              world_epoch: 14,
              commands: [
                { command_id: 'cmd_1', character_id: 'char_1', command_type: 'wait' },
              ],
            })
            """
        )
        if queued_contract["characterId"] != "char_1" or queued_contract["commands"][0]["command_id"] != "cmd_1":
            raise AssertionError(f"toon queued command projection was not normalized: {queued_contract!r}")

        page.goto(f"{BASE_URL}/inspector.html", wait_until="domcontentloaded")
        collision_rects = page.evaluate(
            """
            () => {
              window.app.loadSnapshot({
                entities: { root: {}, east_a: {}, east_b: {}, east_c: {} },
                components: {
                  RoomComponent: {
                    root: { title: 'Root', indoor: true },
                    east_a: { title: 'East A', indoor: true },
                    east_b: { title: 'East B', indoor: true },
                    east_c: { title: 'East C', indoor: true },
                  },
                },
                relationships: {
                  ExitTo: {
                    root: [
                      { target: 'east_a', edge: { direction: 'east' } },
                      { target: 'east_b', edge: { direction: 'east' } },
                      { target: 'east_c', edge: {} },
                    ],
                  },
                },
              });
              return window.app.lgraph._nodes.map((node) => ({
                id: node.entityId,
                x: node.pos[0],
                y: node.pos[1],
                w: node.size[0],
                h: node.size[1],
              }));
            }
            """
        )
        assert_no_rect_overlaps(collision_rects)
        page.evaluate(
            """
            async () => {
              const snapshot = await fetch('/examples/seed-world.json').then((res) => res.json());
              window.app.loadSnapshot(snapshot);
            }
            """
        )
        page.wait_for_function("window.app && window.app.lgraph && window.app.lgraph._nodes.length > 0")
        canvas_box = page.locator("#graph-canvas").bounding_box()
        if not canvas_box:
            raise AssertionError("graph canvas was not visible")
        page.mouse.click(canvas_box["x"] + 100, canvas_box["y"] + 100, button="right")
        assert page.locator(".litecontextmenu").count() == 0
        page.locator("#search-input").fill("component:RoomComponent")
        page.wait_for_function("document.querySelectorAll('#search-results .search-item').length > 0")
        first_type = page.locator("#search-results .search-item .si-type").first.text_content()
        if "room" not in first_type:
            raise AssertionError(f"component filter did not return a room result: {first_type!r}")
        selected = page.evaluate(
            """
            () => {
              const id = window.app.lgraph._nodes[0].entityId;
              window.app.selectEntity(id);
              return id;
            }
            """
        )
        editor_href = page.locator("#inspector-links a").get_attribute("href")
        if not editor_href or "world-editor.html" not in editor_href or f"#{selected}" not in editor_href:
            raise AssertionError(f"unexpected world editor link for {selected}: {editor_href!r}")

        context_result = page.evaluate(
            """
            () => {
              window.app.loadSnapshot({
                entities: { room: {}, door: {}, char: {}, old_ctrl: {}, new_ctrl: {}, item: {} },
                components: {
                  RoomComponent: { room: { title: 'Room' } },
                  DoorComponent: { door: { open: false } },
                  IdentityComponent: {
                    door: { name: 'East Door', kind: 'door', tags: [] },
                    char: { name: 'Juniper', kind: 'character', tags: [] },
                    old_ctrl: { name: 'Old', kind: 'controller', tags: [] },
                    new_ctrl: { name: 'New', kind: 'controller', tags: [] },
                    item: { name: 'Pebble', kind: 'item', tags: [] },
                  },
                  CharacterComponent: { char: { species: 'bunny' } },
                  LLMControllerComponent: {
                    old_ctrl: { profile_name: 'default', model: 'old-model' },
                    new_ctrl: { profile_name: 'default', model: 'new-model' },
                  },
                  PortableComponent: { item: {} },
                },
                relationships: {
                  Contains: {
                    room: [
                      { target: 'char', edge: { mode: 'room_content', visible: true, discovered: true, order: 0 } },
                      { target: 'door', edge: { mode: 'room_content', visible: true, discovered: true, order: 1 } },
                    ],
                  },
                  ControlledBy: {
                    char: [{ target: 'old_ctrl', edge: { generation: 2, since_epoch: 10 } }],
                  },
                  Holding: {
                    char: [{ target: 'item', edge: {} }],
                  },
                },
              });
              window.app._pushEntity('room');
              const node = window.app._nodeMap.char;
              const ds = window.app.lgcanvas.ds;
              const rect = window.app.lgcanvas.canvas.getBoundingClientRect();
              return {
                x: rect.left + (node.pos[0] + node.size[0] / 2 + ds.offset[0]) * ds.scale,
                y: rect.top + (node.pos[1] + node.size[1] / 2 + ds.offset[1]) * ds.scale,
              };
            }
            """
        )
        page.mouse.click(context_result["x"], context_result["y"], button="right")
        menu = page.locator("#graph-context-menu:not(.hidden)")
        if not menu.is_visible():
            raise AssertionError("graph node context menu did not open")
        menu_text = menu.text_content() or ""
        for expected in ["Edit in World Editor", "Assign Controller", "Remove from World", "Clone Entity"]:
            if expected not in menu_text:
                raise AssertionError(f"context menu missed {expected!r}: {menu_text!r}")
        assign_capture = page.evaluate(
            """
            async () => {
              const calls = [];
              window.app._apiBase = '/api/v1';
              window.app._sendAdmin = async (path, options) => {
                calls.push({ path, options });
                return {
                  world_epoch: 12,
                  changed_entities: [{
                    id: 'char',
                    components: {
                      IdentityComponent: { name: 'Juniper', kind: 'character', tags: [] },
                      CharacterComponent: { species: 'bunny' },
                    },
                    relationships: {
                      ControlledBy: [{ target_id: 'new_ctrl', edge: { generation: 3, since_epoch: 12 } }],
                    },
                  }],
                  deleted_entities: [],
                };
              };
              await window.app._assignController('char', 'new_ctrl');
              return calls.map(call => ({
                path: call.path,
                method: call.options.method,
                body: JSON.parse(call.options.body),
              }));
            }
            """
        )
        if assign_capture != [
            {
                "path": "/admin/characters/char/controller",
                "method": "PUT",
                "body": {"controller_id": "new_ctrl"},
            }
        ]:
            raise AssertionError(f"assign controller used unexpected request: {assign_capture!r}")
        monitor_result = page.evaluate(
            """
            async () => {
              const calls = [];
              window.app._apiBase = '/api/v1';
              window.__promptResponses = ['123456789'];
              BunnylandUI.promptDialog = async () => window.__promptResponses.shift() ?? null;
              window.app._sendPatch = async (operations, options) => {
                calls.push({ operations, options });
                return {
                  world_epoch: 13,
                  changed_entities: [{
                    id: 'room',
                    components: {
                      RoomComponent: { title: 'Room' },
                      DiscordRoomFeedComponent: { channel_id: 123456789 },
                    },
                    relationships: {
                      Contains: [{ target_id: 'char', edge: { mode: 'room_content' } }],
                    },
                  }],
                  deleted_entities: [],
                };
              };
              window.app._showContextMenu('room', 100, 100);
              const text = document.getElementById('graph-context-menu').textContent || '';
              await window.app._monitorRoom('room');
              return { text, calls };
            }
            """
        )
        if "Monitor Room" not in monitor_result["text"]:
            raise AssertionError(f"room context menu missed Monitor Room: {monitor_result['text']!r}")
        expected_monitor_ops = [
            {
                "op": "add_component",
                "entity_id": "room",
                "component": {
                    "type": "DiscordRoomFeedComponent",
                    "fields": {"channel_id": 123456789},
                },
            }
        ]
        if monitor_result["calls"][0]["operations"] != expected_monitor_ops:
            raise AssertionError(f"monitor room sent unexpected patch: {monitor_result!r}")
        if monitor_result["calls"][0]["options"].get("status") != "● Room monitoring enabled":
            raise AssertionError(f"monitor room used unexpected status: {monitor_result!r}")
        page.mouse.move(0, 0)
        page.evaluate(
            """
            () => {
              window.__generationCalls = [];
              window.__promptResponses = [];
              BunnylandUI.promptDialog = async () => window.__promptResponses.shift() ?? null;
              window.app._sendAdmin = async (path, options) => {
                const body = JSON.parse(options.body);
                window.__generationCalls.push({ type: 'generate', path, body });
                return { result: { patch: { operations: [{ op: 'add_entity', client_id: `$generated_${body.kind}`, components: [] }] } } };
              };
              window.app._sendPatch = async (operations, options) => {
                window.__generationCalls.push({ type: 'patch', operations, options });
                return { world_epoch: 14, changed_entities: [], deleted_entities: [] };
              };
              window.app._showContextMenu('room', 100, 100);
            }
            """
        )
        room_menu_text = page.locator("#graph-context-menu").text_content() or ""
        for expected in ["Add Character", "Add Item"]:
            if expected not in room_menu_text:
                raise AssertionError(f"room context menu missed {expected!r}: {room_menu_text!r}")
        page.evaluate("window.__promptResponses = ['a night courier']")
        page.locator('[data-menu-action="generate-character"]').dispatch_event("click")
        page.wait_for_function("window.__generationCalls.length === 2")
        page.mouse.move(0, 0)
        page.evaluate("window.app._showContextMenu('room', 100, 100); window.__promptResponses = ['a brass key']")
        page.locator('[data-menu-action="generate-item"]').dispatch_event("click")
        page.wait_for_function("window.__generationCalls.length === 4")
        page.evaluate("window.__promptResponses = ['door', 'east', 'a rain library']")
        page.locator("#btn-generate-room").click()
        page.wait_for_function("window.__generationCalls.length === 6")
        generation_calls = page.evaluate("window.__generationCalls")
        expected_generation_bodies = [
            {"kind": "character", "prompt": "a night courier", "room_entity_id": "room"},
            {"container_entity_id": "room", "kind": "item", "prompt": "a brass key"},
            {"direction": "east", "door_entity_id": "door", "kind": "room", "prompt": "a rain library"},
        ]
        if [call["body"] for call in generation_calls[::2]] != expected_generation_bodies:
            raise AssertionError(f"generation actions used unexpected requests: {generation_calls!r}")
        if [call["operations"][0]["client_id"] for call in generation_calls[1::2]] != [
            "$generated_character", "$generated_item", "$generated_room"
        ]:
            raise AssertionError(f"generation actions applied unexpected patches: {generation_calls!r}")
        clone_ops = page.evaluate(
            """
            () => window.app._cloneEntityOperations('char', 'clone_char')
            """
        )
        if clone_ops[0]["op"] != "add_entity" or clone_ops[0]["client_id"] != "clone_char":
            raise AssertionError(f"clone did not begin with add_entity: {clone_ops!r}")
        if not any(op.get("op") == "set_edge" and op.get("source_id") == "room" and op.get("target_id") == "clone_char" for op in clone_ops):
            raise AssertionError(f"clone did not copy incoming containment edges: {clone_ops!r}")
        if any(op.get("op") == "set_edge" and op.get("edge", {}).get("type") == "ControlledBy" for op in clone_ops):
            raise AssertionError(f"clone copied controller edges: {clone_ops!r}")
        delete_ops = page.evaluate(
            """
            async () => {
              const calls = [];
              BunnylandUI.confirmDialog = async () => true;
              window.app._sendPatch = async (operations, options) => {
                calls.push({ operations, options });
                return { world_epoch: 12, changed_entities: [], deleted_entities: ['char'] };
              };
              await window.app._deleteEntity('char');
              return calls;
            }
            """
        )
        if delete_ops[0]["operations"] != [{"op": "delete_entity", "entity_id": "char"}]:
            raise AssertionError(f"delete did not send delete_entity patch: {delete_ops!r}")

        regional = page.evaluate(
            """
            async () => {
              const snapshot = await fetch('/examples/regional-hierarchy.json').then((res) => res.json());
              window.app.loadSnapshot(snapshot);
              window.app.setRootView('region');
              const positions = {};
              const details = {};
              const overflowLabels = [];
              const measureCanvas = document.createElement('canvas');
              const measureCtx = measureCanvas.getContext('2d');
              measureCtx.font = '12px "Courier New", monospace';
              for (const node of window.app.lgraph._nodes) {
                positions[node.entityId] = { x: node.pos[0], y: node.pos[1], w: node.size[0], h: node.size[1] };
                details[node.entityId] = (node.widgets || []).map((widget) => widget.value || '');
                for (const label of details[node.entityId]) {
                  if (measureCtx.measureText(label).width > node.size[0] - 18) {
                    overflowLabels.push({ id: node.entityId, label });
                  }
                }
              }
              return {
                active: document.querySelector('#btn-view-region').classList.contains('active'),
                nodes: positions,
                details,
                overflowLabels,
                links: window.app.lgraph.links ? Object.keys(window.app.lgraph.links).length : 0,
              };
            }
            """
        )
        expected_order = [
            "lapin_prime",
            "mossreach_continent",
            "burrowmark_country",
            "north_warren_region",
            "clover_city",
            "old_market_area",
            "greenhill_neighborhood",
            "sunstem_zone",
            "carrot_street",
            "moonroot_tower",
            "story_three",
            "observatory_room",
        ]
        if not regional["active"]:
            raise AssertionError("region view button was not active after selecting regional view")
        missing = [node_id for node_id in expected_order if node_id not in regional["nodes"]]
        if missing:
            raise AssertionError(f"regional view missed expected node(s): {missing!r}")
        assert_no_rect_overlaps([
            {"id": node_id, **regional["nodes"][node_id]} for node_id in expected_order
        ])
        ys = [regional["nodes"][node_id]["y"] for node_id in expected_order]
        if any(lower <= upper for upper, lower in zip(ys, ys[1:], strict=False)):
            raise AssertionError(f"regional tree was not ordered planet-to-room by y position: {ys!r}")
        lapin_details = " ".join(regional["details"]["lapin_prime"])
        if "👥 8.4B" not in lapin_details or "🌡️ 14 C" not in lapin_details:
            raise AssertionError(f"regional characteristics did not render on Lapin Prime: {lapin_details!r}")
        north_warren_details = " ".join(regional["details"]["north_warren_region"])
        if "👥 2.8M" not in north_warren_details:
            raise AssertionError(
                f"numeric regional population was not abbreviated in millions: {north_warren_details!r}"
            )
        clover_details = " ".join(regional["details"]["clover_city"])
        if "👥 680k" not in clover_details:
            raise AssertionError(
                f"numeric regional population was not abbreviated in thousands: {clover_details!r}"
            )
        if regional["overflowLabels"]:
            raise AssertionError(f"regional labels exceed default node width: {regional['overflowLabels']!r}")
        if regional["links"] < len(expected_order) - 1:
            raise AssertionError(f"regional tree rendered too few links: {regional['links']}")

        sibling_order = page.evaluate(
            """
            () => {
              window.app.loadSnapshot({
                entities: {
                  root: {},
                  ordered_city: {},
                  alpha_region: {},
                  beta_city: {},
                  zeta_city: {},
                  beta_city_duplicate: {},
                },
                components: {
                  RegionComponent: {
                    root: { name: 'World', kind: 'planet' },
                    ordered_city: { name: 'Ordered City', kind: 'city' },
                    alpha_region: { name: 'Alpha Region', kind: 'region' },
                    beta_city: { name: 'Beta City', kind: 'city' },
                    zeta_city: { name: 'Zeta City', kind: 'city' },
                    beta_city_duplicate: { name: 'Beta City', kind: 'city' },
                  },
                },
                relationships: {
                  Contains: {
                    root: [
                      { target: 'zeta_city', edge: { mode: 'region', order: 0 } },
                      { target: 'beta_city_duplicate', edge: { mode: 'region', order: 0 } },
                      { target: 'ordered_city', edge: { mode: 'region', order: -1 } },
                      { target: 'beta_city', edge: { mode: 'region', order: 0 } },
                      { target: 'alpha_region', edge: { mode: 'region', order: 0 } },
                    ],
                  },
                },
              });
              window.app.setRootView('region');
              return window.app.lgraph._nodes
                .filter((node) => node.entityId !== 'root')
                .sort((left, right) => left.pos[0] - right.pos[0])
                .map((node) => node.entityId);
            }
            """
        )
        expected_sibling_order = [
            "ordered_city",
            "alpha_region",
            "beta_city",
            "beta_city_duplicate",
            "zeta_city",
        ]
        if sibling_order != expected_sibling_order:
            raise AssertionError(
                f"regional sibling order changed: expected {expected_sibling_order!r}, got {sibling_order!r}"
            )

        page.locator("#graph-wrapper").screenshot(path=str(SCREENSHOT))
        scale = page.evaluate("window.app.lgcanvas.ds.scale")
        nodes = page.evaluate("window.app.lgraph._nodes.length")
        coverage.close_browser(browser)

    print("prompt_calls=0")
    print(f"nodes={nodes}")
    print(f"scale={scale}")
    print(f"screenshot={SCREENSHOT}")


if __name__ == "__main__":
    main()
