#!/usr/bin/env python3
"""Playwright regression test for the Bunnyland Toon action form.

When a player selects an action, the Toon client opens a single modal that prompts for
every required field — a dropdown for target selections, a numeric input for numbers, and
a text input otherwise — and refuses to submit while a required field is blank. This
mirrors the terminal TUI's action form so both player clients prompt for the same fields.

The test is fully self-contained: it mocks the play-facing projections with Playwright
route interception (no live server or admin credentials), then drives the ``say`` and
``tell`` verbs through the form and asserts the submitted commands.
"""

from __future__ import annotations

import json
import os
import shutil
import time
from pathlib import Path

from playwright.sync_api import expect, sync_playwright

from playwright_coverage import PlaywrightCoverage
from playwright_server import ensure_web_server


BASE_URL = os.environ.get("BUNNYLAND_WEB_BASE_URL", "http://127.0.0.1:8091").rstrip("/")
SCREENSHOT_DIR = Path(os.environ.get("BUNNYLAND_PLAYWRIGHT_SCREENSHOT_DIR", "/tmp"))

CHARACTER = "character:1"
OTHER = "character:2"
ROOM = "room:1"
EXIT = "room:2"
CLAIM_ID = "claim-toon"
CLAIM_SECRET = "secret-toon"

CHARACTER_LIST = {
    "world_epoch": 5,
    "characters": [{"character_id": CHARACTER, "name": "Bun", "kind": "character"}],
}

CHARACTER_PROJECTION = {
    "character_id": CHARACTER,
    "world_epoch": 5,
    "room": {
        "id": ROOM,
        "title": "Parlor",
        "sprite": {},
        "exits": [{"id": EXIT, "direction": "north", "label": "north"}],
        "entities": [
            {"id": CHARACTER, "name": "Bun", "kind": "character", "is_character": True,
             "sprite": {"position": {"x": 0, "y": 0}}},
            {"id": OTHER, "name": "Marlow", "kind": "character", "is_character": True,
             "sprite": {"position": {"x": 1, "y": 1}}},
        ],
    },
    "inventory": [],
    "points": {"action": 5, "action_max": 5, "focus": 3, "focus_max": 3},
    "controller": {"controller_id": "web:1", "generation": 1},
    "target_groups": {
        "characters": [{"id": OTHER, "label": "Marlow", "kind": "character"}],
        "exits": [{"id": EXIT, "label": "north", "kind": "door"}],
    },
    "actions": [
        {
            "command_type": "shout", "tool_name": "shout", "title": "Shout", "lane": "world",
            "cost": {"action": 1, "focus": 4},
            "arguments": [],
            "available": False,
            "enough_action_points": True,
            "enough_focus_points": False,
            "has_required_target": True,
            "meets_requirements": True,
            "unavailable_reason": "not enough focus points",
        },
        {
            "command_type": "say", "tool_name": "say", "title": "Say", "lane": "world",
            "cost": {"action": 1, "focus": 1},
            "arguments": [
                {"key": "text", "title": "text", "kind": "string", "required": True,
                 "target_group": None},
            ],
        },
        {
            "command_type": "move", "tool_name": "move", "title": "Move", "lane": "world",
            "cost": {"action": 1, "focus": 0},
            "arguments": [
                {"key": "exit_id", "title": "exit", "kind": "entity", "required": True,
                 "target_group": "exits"},
            ],
        },
        {
            "command_type": "tell", "tool_name": "tell", "title": "Tell", "lane": "world",
            "cost": {"action": 1, "focus": 1},
            "arguments": [
                {"key": "target_id", "title": "target", "kind": "entity", "required": True,
                 "target_group": "characters"},
                {"key": "text", "title": "text", "kind": "string", "required": True,
                 "target_group": None},
            ],
        },
    ],
}

ROOM_PROJECTION = {"world_epoch": 5, "room": CHARACTER_PROJECTION["room"]}
QUEUED = {
    "character_id": CHARACTER,
    "world_epoch": 5,
    "generated_at_unix": time.time(),
    "next_tick_at_unix": time.time() + 45,
    "tick_seconds": 10,
    "commands": [
        {
            "command_id": "queued-1",
            "character_id": CHARACTER,
            "command_type": "say",
            "payload": {"text": "after lunch"},
            "cost": {"action": 1, "focus": 1},
            "lane": "world",
            "submitted_at_epoch": 5,
        }
    ],
}
EVENTS = {"events": []}


def launch_browser(playwright):
    chrome = (
        os.environ.get("BUNNYLAND_CHROME")
        or shutil.which("google-chrome")
        or shutil.which("chromium")
        or shutil.which("chromium-browser")
    )
    kwargs = {"headless": True}
    if chrome:
        kwargs["executable_path"] = chrome
        kwargs["args"] = ["--no-sandbox"]
    return playwright.chromium.launch(**kwargs)


def json_route(body):
    def handler(route):
        route.fulfill(status=200, content_type="application/json", body=json.dumps(body))
    return handler


def install_routes(page, posted: list[dict]) -> None:
    deleted: list[str] = []
    page.exposed_deleted_commands = deleted

    def assert_claim(route) -> None:
        if route.request.headers.get("x-bunnyland-claim-secret") != CLAIM_SECRET:
            raise AssertionError(f"missing claim secret header on {route.request.url}")
        if f"claim_id={CLAIM_ID}" not in route.request.url and (
            not route.request.post_data or f'"claim_id":"{CLAIM_ID}"' not in route.request.post_data
        ):
            raise AssertionError(f"missing claim id on {route.request.url}")

    def commands_handler(route):
        request = route.request
        if request.method == "POST":
            assert_claim(route)
            posted.append(json.loads(request.post_data or "{}"))
            route.fulfill(status=200, content_type="application/json", body=json.dumps({"ok": True}))
        else:
            route.fulfill(status=200, content_type="application/json", body=json.dumps(QUEUED))

    def cancel_handler(route):
        assert_claim(route)
        deleted.append(route.request.url)
        route.fulfill(
            status=200,
            content_type="application/json",
            body=json.dumps({"cancelled": True}),
        )

    def claim_handler(route):
        route.fulfill(
            status=200, content_type="application/json",
            body=json.dumps({
                "character_id": CHARACTER,
                "controller_id": "web:1",
                "generation": 1,
                "claim_id": CLAIM_ID,
                "claim_secret": CLAIM_SECRET,
            }),
        )

    def recent_events_handler(route):
        assert_claim(route)
        route.fulfill(status=200, content_type="application/json", body=json.dumps(EVENTS))

    # Ids carry a colon that fetch() percent-encodes, so match by glob (``*`` does not
    # cross ``/``) rather than the literal id. More specific patterns are registered last
    # so Playwright (last-match-wins) prefers them.
    page.route("**/world/characters", json_route(CHARACTER_LIST))
    page.route("**/world/character/**", json_route(CHARACTER_PROJECTION))
    page.route("**/world/character/**/events/recent**", recent_events_handler)
    page.route("**/world/room/*", json_route(ROOM_PROJECTION))
    page.route("**/world/character/**/commands**", commands_handler)
    page.route("**/world/controllers/web/claim", claim_handler)
    page.route("**/world/commands", commands_handler)
    page.route("**/world/character/**/commands/**", cancel_handler)


def connect_and_select(page) -> None:
    page.goto(f"{BASE_URL}/toon-client.html", wait_until="domcontentloaded")
    page.locator("#api-url").fill("/api")
    page.locator("#btn-connect").click()
    page.wait_for_function(
        "() => window.app?.characterList && window.app.characterList.length > 0"
    )
    page.locator("#player-select").select_option(CHARACTER)
    page.wait_for_function(
        """(id) => (
            window.app?.characterProjection?.characterId === id
            && window.app.characterProjection.actions?.length > 0
        )""",
        arg=CHARACTER,
        timeout=15000,
    )
    expect(page.locator('.verb.ready[data-tool="say"]')).to_be_visible(timeout=15000)


def check_action_search_and_indicators(page) -> None:
    expect(page.locator("#pt-summary")).to_contain_text("5 / 5 AP")
    expect(page.locator("#pt-summary")).to_contain_text("3 / 3 FP")
    expect(page.locator("#actions-body")).to_contain_text("⌖ target")
    expect(page.locator("#actions-body")).to_contain_text("1 AP")
    expect(page.locator("#actions-body")).to_contain_text("1 FP")
    expect(page.locator("#actions-body")).to_contain_text("World actions")
    expect(page.locator("#actions-body")).to_contain_text("Focus actions")
    expect(page.locator("#actions-body")).to_contain_text("not enough focus points")
    expect(page.locator("#actions-body")).to_contain_text("Queued actions")
    expect(page.locator("#actions-body")).to_contain_text("next tick in")
    expect(page.locator("#actions-body")).to_contain_text("after lunch")
    initial_countdown = page.locator("#queued-title").text_content()
    page.wait_for_function(
        "initial => document.querySelector('#queued-title')?.textContent !== initial",
        arg=initial_countdown,
        timeout=2000,
    )
    expect(page.locator("#actions-body .verb.ready").nth(0)).to_contain_text("Say")
    expect(page.locator('.verb.unavailable.ready[data-tool="shout"]')).to_be_visible()

    page.locator("#action-filter").fill("ell")
    expect(page.locator('.verb.ready[data-tool="tell"]')).to_be_visible()
    expect(page.locator('.verb.ready[data-tool="say"]')).to_have_count(0)
    page.locator("#action-filter-clear").click()
    expect(page.locator('.verb.ready[data-tool="say"]')).to_be_visible()


def check_selected_sprite_preselects_target(page) -> None:
    page.locator(".sprite").filter(has_text="Marlow").click()
    page.locator('.verb.ready[data-tool="tell"]').click()
    overlay = page.locator("#action-form-overlay")
    overlay.wait_for(state="visible")
    expect(overlay.locator("select.af-input")).to_have_value(OTHER)
    page.keyboard.press("Escape")
    expect(overlay).to_have_count(0)


def check_door_click_queues_move(page, posted: list[dict]) -> None:
    expect(page.locator(".door")).to_be_visible(timeout=15000)
    with page.expect_response("**/world/commands"):
        page.locator(".door").first.click()
    if not posted or posted[-1]["command_type"] != "move":
        raise AssertionError(f"door click did not post move: {posted!r}")
    if posted[-1]["payload"] != {"exit_id": EXIT}:
        raise AssertionError(f"door move payload wrong: {posted[-1]!r}")


def check_queue_cancel(page) -> None:
    with page.expect_response("**/world/character/*/commands/*"):
        page.locator('.queued-action[data-cancel-command="queued-1"]').click()
    deleted = page.exposed_deleted_commands
    if (
        not deleted
        or "controller_id=web%3A1" not in deleted[-1]
        or "controller_generation=1" not in deleted[-1]
        or f"claim_id={CLAIM_ID}" not in deleted[-1]
    ):
        raise AssertionError(f"queued command was not cancelled with controller identity: {deleted!r}")


def check_say_text_field(page, posted: list[dict]) -> None:
    baseline = len(posted)
    page.locator('.verb.ready[data-tool="say"]').click()
    overlay = page.locator("#action-form-overlay")
    overlay.wait_for(state="visible")
    # A free-text message is a text input, not a dropdown.
    expect(overlay.locator('input.af-input[type="text"]')).to_have_count(1)
    expect(overlay.locator("select.af-input")).to_have_count(0)

    # Submitting a blank required field reports an error and posts nothing.
    overlay.locator(".af-submit").click()
    expect(overlay.locator(".af-error")).to_contain_text("required")
    if len(posted) != baseline:
        raise AssertionError(f"blank submit should not post a command; posted={posted!r}")

    overlay.locator('input.af-input[type="text"]').fill("hello toon")
    overlay.locator(".af-submit").click()
    expect(overlay).to_have_count(0)
    if not posted or posted[-1]["command_type"] != "say":
        raise AssertionError(f"say command was not posted; posted={posted!r}")
    if posted[-1]["payload"] != {"text": "hello toon"}:
        raise AssertionError(f"say payload wrong: {posted[-1]['payload']!r}")


def check_unavailable_action_can_queue(page, posted: list[dict]) -> None:
    page.locator('.verb.unavailable.ready[data-tool="shout"]').click()
    if not posted or posted[-1]["command_type"] != "shout":
        raise AssertionError(f"unavailable action was not posted; posted={posted!r}")
    if posted[-1]["on_insufficient_points"] != "queue":
        raise AssertionError(f"unavailable action should still queue: {posted[-1]!r}")


def check_tell_dropdown_and_text(page, posted: list[dict]) -> None:
    page.locator('.verb.ready[data-tool="tell"]').click()
    overlay = page.locator("#action-form-overlay")
    overlay.wait_for(state="visible")
    # tell collects a target dropdown and a message text input in one form.
    expect(overlay.locator("select.af-input")).to_have_count(1)
    expect(overlay.locator('input.af-input[type="text"]')).to_have_count(1)

    overlay.locator("select.af-input").select_option(OTHER)
    overlay.locator('input.af-input[type="text"]').fill("psst")
    overlay.locator(".af-submit").click()
    expect(overlay).to_have_count(0)
    if not posted or posted[-1]["command_type"] != "tell":
        raise AssertionError(f"tell command was not posted; posted={posted!r}")
    if posted[-1]["payload"] != {"target_id": OTHER, "text": "psst"}:
        raise AssertionError(f"tell payload wrong: {posted[-1]['payload']!r}")


def check_single_form_at_a_time(page) -> None:
    page.locator('.verb.ready[data-tool="say"]').click()
    expect(page.locator("#action-form-overlay")).to_have_count(1)
    # Selecting a second action while a form is open must not open a second form.
    page.locator('.verb.ready[data-tool="tell"]').click()
    expect(page.locator("#action-form-overlay")).to_have_count(1)
    page.keyboard.press("Escape")
    expect(page.locator("#action-form-overlay")).to_have_count(0)


def check_event_activity(page) -> None:
    EVENTS["events"] = [
        {
            "event_type": "CommandRejectedEvent",
            "data": {
                "event_type": "CommandRejectedEvent",
                "event": {
                    "event_id": "event-rejected-1",
                    "visibility": "directed",
                    "actor_id": CHARACTER,
                    "reason": "blocked by furniture",
                },
            },
        }
    ]
    page.evaluate("() => window.app._refresh()")
    expect(page.locator("#actions-body")).to_contain_text("blocked by furniture")


def main() -> None:
    ensure_web_server(BASE_URL)
    with sync_playwright() as playwright:
        coverage = PlaywrightCoverage("toon-action-form")
        browser = launch_browser(playwright)
        page = coverage.new_page(browser, viewport={"width": 1280, "height": 800})
        posted: list[dict] = []
        install_routes(page, posted)

        connect_and_select(page)
        check_action_search_and_indicators(page)
        check_selected_sprite_preselects_target(page)
        check_door_click_queues_move(page, posted)
        check_queue_cancel(page)
        check_say_text_field(page, posted)
        check_unavailable_action_can_queue(page, posted)
        check_tell_dropdown_and_text(page, posted)
        check_single_form_at_a_time(page)
        check_event_activity(page)

        page.screenshot(path=str(SCREENSHOT_DIR / "bunnyland-toon-action-form.png"))
        coverage.close_browser(browser)

    print("toon_action_form=ok")


if __name__ == "__main__":
    main()
