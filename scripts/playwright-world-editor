#!/usr/bin/env python3
"""Playwright checks for the Bunnyland world editor."""

from pathlib import Path
import os
import shutil

from playwright.sync_api import sync_playwright


BASE_URL = os.environ.get("BUNNYLAND_WEB_BASE_URL", "http://127.0.0.1:8080").rstrip("/")
SCREENSHOT_DIR = Path(os.environ.get("BUNNYLAND_PLAYWRIGHT_SCREENSHOT_DIR", "/tmp"))
SCREENSHOT = SCREENSHOT_DIR / "bunnyland-enum-editor.png"


def launch_browser(playwright):
    chrome = (
        os.environ.get("BUNNYLAND_CHROME")
        or shutil.which("google-chrome")
        or shutil.which("chromium")
        or shutil.which("chromium-browser")
    )
    kwargs = {"headless": True}
    if chrome:
        kwargs["executable_path"] = chrome
        kwargs["args"] = ["--no-sandbox"]
    return playwright.chromium.launch(**kwargs)


def main() -> None:
    SCREENSHOT_DIR.mkdir(parents=True, exist_ok=True)
    with sync_playwright() as playwright:
        browser = launch_browser(playwright)
        page = browser.new_page(viewport={"width": 1400, "height": 900})
        prompt_messages = []
        page.on("dialog", lambda dialog: (prompt_messages.append(dialog.message), dialog.dismiss()))
        page.route(
            "**/world/snapshot",
            lambda route: route.fulfill(
                status=200,
                json={
                    "world_epoch": 2,
                    "entities": [
                        {
                            "id": "linked_entity",
                            "components": {"IdentityComponent": {"name": "Linked Entity"}},
                            "relationships": {},
                        },
                        {
                            "id": "other_entity",
                            "components": {"IdentityComponent": {"name": "Other Entity"}},
                            "relationships": {},
                        },
                    ],
                },
            ),
        )
        page.route(
            "**/admin/runtime",
            lambda route: route.fulfill(status=200, json={"paused": False, "running": True, "world_epoch": 2}),
        )
        page.route("**/world/schema", lambda route: route.fulfill(status=200, json={"components": {}}))
        page.route("**/world/library", lambda route: route.fulfill(status=200, json={"fragments": []}))
        page.goto(
            f"{BASE_URL}/world-editor.html?server=http://bunnyland.test#map/linked_entity",
            wait_until="networkidle",
        )
        page.wait_for_function("window.app && window.app.selectedId === 'linked_entity'")
        assert page.locator("#api-url").input_value() == "http://bunnyland.test"
        assert page.locator("#selected-label").text_content() == "linked_entity"
        assert page.evaluate("location.search") == "?server=http%3A%2F%2Fbunnyland.test"
        assert page.evaluate("decodeURIComponent(location.hash)") == "#linked_entity"
        inspector_href = page.locator("#inspector-link").get_attribute("href")
        if (
            not inspector_href
            or "index.html" not in inspector_href
            or "server=http%3A%2F%2Fbunnyland.test" not in inspector_href
            or "#map/linked_entity" not in inspector_href
        ):
            raise AssertionError(f"unexpected inspector link: {inspector_href!r}")

        page.goto(f"{BASE_URL}/world-editor.html", wait_until="networkidle")
        page.evaluate(
            """
            () => {
              const enumDefs = {
                ContainmentMode: {
                  type: 'string',
                  enum: ['room_content', 'inventory', 'container'],
                  title: 'ContainmentMode'
                },
                BoundaryTag: {
                  type: 'string',
                  enum: ['flirting', 'romance', 'pvp'],
                  title: 'BoundaryTag'
                }
              };
              window.app.worldSchema = {
                components: {
                  InventoryComponent: {
                    json_schema: {
                      type: 'object',
                      properties: {
                        default_drop_mode: {
                          $ref: '#/$defs/ContainmentMode',
                          default: 'inventory'
                        },
                        nickname: {
                          anyOf: [{ type: 'string' }, { type: 'null' }],
                          default: null,
                          title: 'Nickname'
                        }
                      },
                      $defs: enumDefs
                    }
                  },
                  WorldPolicyComponent: {
                    json_schema: {
                      type: 'object',
                      properties: {
                        enabled: {
                          type: 'array',
                          items: { $ref: '#/$defs/BoundaryTag' },
                          default: []
                        }
                      },
                      $defs: enumDefs
                    }
                  }
                },
                edges: {
                  Contains: {
                    json_schema: {
                      type: 'object',
                      properties: {
                        mode: {
                          $ref: '#/$defs/ContainmentMode',
                          default: 'container'
                        },
                        visible: {
                          type: 'boolean',
                          default: true,
                          title: 'Visible'
                        }
                      },
                      $defs: enumDefs
                    }
                  }
                }
              };
              window.app.world = {
                metadata: { epoch: 1 },
                entities: {
                  enum_test: {
                    id: 'enum_test',
                    prefab: 'entity',
                    created_epoch: 0,
                    components: {
                      InventoryComponent: { default_drop_mode: 'inventory', nickname: null },
                      WorldPolicyComponent: { enabled: ['pvp'] }
                    },
                    relationships: {
                      Contains: [{ target: 'target_entity', edge: { mode: 'container', visible: true } }]
                    }
                  },
                  target_entity: {
                    id: 'target_entity',
                    prefab: 'entity',
                    created_epoch: 0,
                    components: { IdentityComponent: { name: 'Target Entity' } },
                    relationships: {}
                  }
                },
                relationships: {}
              };
              window.app.selectedId = 'enum_test';
              window.app._renderAll();
            }
            """
        )
        scalar = page.locator('select.component-field[data-field="default_drop_mode"]')
        enum_list = page.locator(".enum-list-editor")
        add_select = page.locator(".enum-list-select")
        scalar.wait_for()
        enum_list.wait_for()
        page.locator("#entity-search").fill("component:InventoryComponent")
        assert page.locator(".entity-row").count() == 1
        page.evaluate(
            """
            () => {
              window.app.world.entities.enum_test.relationships.Contains = [{ target: 'missing_entity', edge: {} }];
              window.app._renderJson();
              window.app._renderEntities();
            }
            """
        )
        page.locator("#entity-search").fill("invalid")
        assert page.locator(".entity-row").count() == 1
        assert "invalid" in page.locator(".entity-row .entity-meta").text_content()
        assert page.locator("#problems .problem-link").text_content() == "enum_test"
        component_search = page.locator("#add-component-dropdown .search-dropdown-input")
        assert component_search.input_value() == ""
        assert page.locator("#add-component-type").input_value() == ""
        component_search.fill("ActionPoints")
        component_search.press("Enter")
        assert page.locator("#add-component-type").input_value() == "ActionPointsComponent"
        edge_type_search = page.locator("#add-edge-type-dropdown .search-dropdown-input")
        edge_target_search = page.locator("#add-edge-target-dropdown .search-dropdown-input")
        assert edge_type_search.input_value() == ""
        assert page.locator("#add-edge-type").input_value() == ""
        assert edge_target_search.input_value() == ""
        assert page.locator("#add-edge-target").input_value() == ""
        edge_type_search.fill("ExitTo")
        edge_type_search.press("Enter")
        edge_target_search.fill("Target")
        edge_target_search.press("Enter")
        assert page.locator("#add-edge-type").input_value() == "ExitTo"
        assert page.locator("#add-edge-target").input_value() == "target_entity"
        page.locator("#btn-add-edge").click()
        assert page.locator(".edge-card[data-type='ExitTo']").count() == 1
        assert prompt_messages == []
        page.evaluate(
            """
            () => {
              window.app.libraryFragments = [{
                id: 'fragment.alpha',
                title: 'Alpha Fragment',
                kind: 'room',
                operations: []
              }];
              window.app._renderLibraryControls();
            }
            """
        )
        fragment_search = page.locator("#fragment-dropdown .search-dropdown-input")
        fragment_search.fill("alpha")
        fragment_search.press("Enter")
        assert page.locator("#library-select").input_value() == "fragment.alpha"
        edge_mode = page.locator('.edge-card select.edge-field[data-field="mode"]')
        edge_mode.wait_for()
        assert edge_mode.input_value() == "container"
        edge_mode.select_option("inventory")
        edge_visible = page.locator('.edge-card input.edge-field[data-field="visible"]')
        assert edge_visible.is_checked()
        edge_visible.uncheck()
        edge_raw = page.locator(".edge-card[data-type='Contains'] .edge-json")
        assert '"mode": "inventory"' in edge_raw.input_value()
        assert '"visible": false' in edge_raw.input_value()
        assert scalar.input_value() == "inventory"
        nullable = page.locator('.nullable-toggle[data-field="nickname"]')
        nullable.wait_for()
        assert nullable.is_checked()
        nickname = page.locator('input.component-field[data-field="nickname"]')
        assert nickname.is_disabled()
        nullable.uncheck()
        assert not nickname.is_disabled()
        nickname.fill("alias")
        inventory_raw = page.locator(".component-card[data-type='InventoryComponent'] .component-json")
        assert '"nickname": "alias"' in inventory_raw.input_value()
        assert add_select.input_value() == "flirting"
        add_select.select_option("romance")
        page.locator("[data-add-enum-option]").click()
        raw = page.locator(".component-card[data-type='WorldPolicyComponent'] .component-json")
        assert '"pvp"' in raw.input_value()
        assert '"romance"' in raw.input_value()
        page.locator('[data-remove-enum-option="pvp"]').click()
        assert '"pvp"' not in raw.input_value()
        page.screenshot(path=str(SCREENSHOT), full_page=True)
        browser.close()

    print("world_editor_enum_dropdowns=ok")
    print(f"screenshot={SCREENSHOT}")


if __name__ == "__main__":
    main()
