#!/usr/bin/env python3
"""Live Playwright smoke test for Bunnyland Toon.

This intentionally exercises the deployed browser client against a running server:
connect, claim a character with the web controller, move its in-room sprite, then move
through a room exit. Screenshots are written after each visible step.

The Toon client is a pure player surface: it reads only the play-facing projections
(``/world/characters``, ``/world/character/{id}``, ``/world/room/{id}``,
``/world/character/{id}/commands``, ``/world/events/recent``) and never the admin-gated
snapshot or ``/world/updates`` stream. This test uses the same projections for its setup
and assertions so it works without admin credentials.
"""

from __future__ import annotations

import json
import os
import re
import time
from pathlib import Path
from typing import Any

from playwright.sync_api import expect, sync_playwright


PAGE_URL = os.environ.get(
    "BUNNYLAND_TOON_PAGE_URL", "https://sandbox.bunnyland.dev/toon-client.html"
)
API_URL = os.environ.get(
    "BUNNYLAND_TOON_API_URL", "https://sandbox.bunnyland.dev/api"
).rstrip("/")
OUT_DIR = Path(os.environ.get("BUNNYLAND_TOON_SCREENSHOT_DIR", "/tmp"))


def screenshot(page, name: str) -> str:
    path = OUT_DIR / f"bunnyland-toon-{name}.png"
    page.screenshot(path=str(path), full_page=True)
    return str(path)


def api_get(page, path: str) -> Any:
    return page.evaluate(
        """async ([api, path]) => {
            const res = await fetch(`${api}${path}`);
            if (!res.ok) throw new Error(`${path} HTTP ${res.status}`);
            return await res.json();
        }""",
        [API_URL, path],
    )


def character_room(page, character_id: str) -> dict[str, Any]:
    """The character's perceived room id via the character projection."""
    return api_get(page, f"/world/character/{character_id}")


def room_view(page, room_id: str) -> dict[str, Any]:
    return api_get(page, f"/world/room/{room_id}")


def room_entity(room: dict[str, Any], entity_id: str) -> dict[str, Any] | None:
    for entity in (room.get("room") or {}).get("entities", []):
        if entity.get("id") == entity_id:
            return entity
    return None


def sprite_pos(room: dict[str, Any], entity_id: str) -> tuple[float, float] | None:
    entity = room_entity(room, entity_id)
    pos = (entity or {}).get("sprite", {}).get("position")
    if not pos:
        return None
    return (float(pos.get("x") or 0), float(pos.get("y") or 0))


def choose_character_with_exit(page) -> tuple[str, str, str]:
    """Pick a character whose perceived room has at least one exit, using only projections."""
    lobby = api_get(page, "/world/characters")
    for summary in lobby.get("characters", []):
        character_id = summary["character_id"]
        projection = character_room(page, character_id)
        room = projection.get("room") or {}
        room_id = room.get("id")
        if not room_id:
            continue
        exits = (room_view(page, room_id).get("room") or {}).get("exits", [])
        if exits:
            return character_id, room_id, exits[0]["id"]
    raise RuntimeError("could not find a character in a room with an exit")


def wait_for(page, label: str, fetch, predicate, timeout: float = 90.0) -> dict[str, Any]:
    deadline = time.monotonic() + timeout
    last: dict[str, Any] | None = None
    while time.monotonic() < deadline:
        last = fetch()
        if predicate(last):
            return last
        time.sleep(1.0)
    raise RuntimeError(f"timed out waiting for {label}; last={json.dumps(last)[:1000]}")


def main() -> None:
    shots: list[str] = []
    with sync_playwright() as pw:
        launch_kwargs: dict[str, Any] = {"headless": True}
        if os.environ.get("CI"):
            launch_kwargs["args"] = ["--no-sandbox"]
        browser = pw.chromium.launch(**launch_kwargs)
        page = browser.new_page(viewport={"width": 1440, "height": 950})

        page.goto(PAGE_URL, wait_until="domcontentloaded")
        shots.append(screenshot(page, "01-loaded"))
        page.locator('#loading-overlay').wait_for(state="visible", timeout=2000)
        page.locator('#loading-overlay').wait_for(state="hidden", timeout=4000)

        page.locator("#api-url").fill(API_URL)
        page.locator("#btn-connect").click()
        # The status flips "● Connected" → "● Live · epoch …" within one poll, so accept
        # either rather than racing the brief Connected state.
        expect(page.locator("#api-status")).to_contain_text(
            re.compile(r"Connected|Live"), timeout=15000
        )
        page.wait_for_function(
            "() => window.app?.characterList && window.app.characterList.length > 0"
        )
        shots.append(screenshot(page, "02-connected"))

        character_id, start_room, expected_exit_room = choose_character_with_exit(page)
        page.locator("#player-select").select_option(character_id)
        page.wait_for_function(
            """(characterId) => window.app?.control?.characterId === characterId""",
            arg=character_id,
            timeout=15000,
        )
        page.wait_for_function(
            """(characterId) => (
                window.app?.characterProjection?.characterId === characterId
                && window.app.characterProjection.actions?.length > 0
            )""",
            arg=character_id,
            timeout=15000,
        )
        expect(page.locator("#actions-body")).to_contain_text("Queued actions")
        expect(page.locator('.verb.ready[data-tool="move"]')).to_be_visible(timeout=15000)
        control = page.evaluate("() => window.app.control")
        if not control or not control.get("controllerId"):
            raise RuntimeError(f"web controller claim failed: {control!r}")
        shots.append(screenshot(page, "03-claimed"))

        before_pos = sprite_pos(room_view(page, start_room), character_id) or (0.0, 0.0)
        stage = page.locator("#stage")
        box = stage.bounding_box()
        if not box:
            raise RuntimeError("stage is not visible")
        page.mouse.click(box["x"] + box["width"] / 2 + 80, box["y"] + box["height"] / 2 + 45)
        target_pos_raw = page.evaluate("() => [window.app.localPos?.x, window.app.localPos?.y]")
        if not target_pos_raw or target_pos_raw[0] is None or target_pos_raw[1] is None:
            raise RuntimeError(f"sprite click did not set an optimistic local position: {target_pos_raw!r}")
        target_pos = (float(target_pos_raw[0]), float(target_pos_raw[1]))
        wait_for(
            page,
            "sprite position update",
            lambda: room_view(page, start_room),
            lambda room: (
                (pos := sprite_pos(room, character_id)) is not None
                and abs(pos[0] - target_pos[0]) < 0.01
                and abs(pos[1] - target_pos[1]) < 0.01
            ),
        )
        page.wait_for_timeout(500)
        shots.append(screenshot(page, "04-in-room-moved"))

        page.locator('.verb.ready[data-tool="move"]').click()
        page.locator("#target-overlay .target-item").first.click()
        moved = wait_for(
            page,
            "room movement through exit",
            lambda: character_room(page, character_id),
            lambda projection: (projection.get("room") or {}).get("id") not in (None, start_room),
        )
        page.wait_for_function(
            "() => window.app?.activityLines?.length > 0",
            timeout=15000,
        )
        activity = page.evaluate("() => window.app.activityLines.map(line => line.text)")
        new_room = (moved.get("room") or {}).get("id")
        page.locator("#btn-follow").click()
        page.wait_for_timeout(1000)
        shots.append(screenshot(page, "05-room-moved"))

        # Clicking a door in your own room queues a move through that exit (no menu/picker).
        page.wait_for_function(
            "() => window.app?._playerInView() && document.querySelector('#stage .door')",
            timeout=15000,
        )
        before_door_room = new_room
        page.locator("#stage .door").first.click()
        door_moved = wait_for(
            page,
            "room movement through a clicked door",
            lambda: character_room(page, character_id),
            lambda projection: (projection.get("room") or {}).get("id")
            not in (None, before_door_room),
        )
        door_room = (door_moved.get("room") or {}).get("id")
        page.locator("#btn-follow").click()
        page.wait_for_timeout(1000)
        shots.append(screenshot(page, "06-door-moved"))

        browser.close()

    print(
        json.dumps(
            {
                "page": PAGE_URL,
                "api": API_URL,
                "character_id": character_id,
                "controller_id": control["controllerId"],
                "start_room": start_room,
                "expected_exit_room": expected_exit_room,
                "new_room": new_room,
                "door_room": door_room,
                "before_pos": before_pos,
                "target_pos": target_pos,
                "activity": activity,
                "screenshots": shots,
            },
            indent=2,
        )
    )


if __name__ == "__main__":
    main()
