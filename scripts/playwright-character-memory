#!/usr/bin/env python3
"""Playwright regression tests for the Bunnyland character memory admin page."""

import json
import os
import shlex
import shutil
import socket
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
from dataclasses import asdict, dataclass
from email.message import Message
from pathlib import Path

from playwright.sync_api import expect, sync_playwright

from playwright_coverage import PlaywrightCoverage
from playwright_server import ensure_web_server


BASE_URL = os.environ.get("BUNNYLAND_WEB_BASE_URL", "http://127.0.0.1:8091").rstrip("/")
SCREENSHOT_DIR = Path(os.environ.get("BUNNYLAND_PLAYWRIGHT_SCREENSHOT_DIR", "/tmp"))
SCREENSHOT = SCREENSHOT_DIR / "bunnyland-character-memory.png"
ADMIN_TOKEN = os.environ.get("BUNNYLAND_OPERATOR_TOKEN", "")
SERVER_IMAGE = os.environ.get(
    "BUNNYLAND_MEMORY_SERVER_IMAGE",
    "ghcr.io/thalismind/bunnyland-server:main",
)
SERVER_CONTAINER_NAME: str | None = None
TOKEN_DATA_DIR: Path | None = None


@dataclass(frozen=True)
class ClaimCreateRequest:
    character_id: str
    label: str
    fallback_controller: str
    timeout_seconds: int


@dataclass(frozen=True)
class CommandCostRequest:
    focus: int


@dataclass(frozen=True)
class ClaimCommandRequest:
    command_type: str
    payload: dict
    cost: CommandCostRequest
    lane: str
    on_insufficient_points: str
    id: str


RequestBody = ClaimCreateRequest | ClaimCommandRequest


def _runtime_works(command: list[str]) -> bool:
    try:
        return (
            subprocess.run(
                [*command, "ps"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            ).returncode
            == 0
        )
    except OSError:
        return False


def container_cli() -> list[str]:
    override = os.environ.get("BUNNYLAND_CONTAINER_CLI")
    if override:
        command = shlex.split(override)
        if not command:
            raise RuntimeError("BUNNYLAND_CONTAINER_CLI must not be empty")
        return command
    for candidate in ("nerdctl", "docker"):
        resolved = shutil.which(candidate)
        if resolved and _runtime_works([resolved]):
            return [resolved]
        sudo = shutil.which("sudo")
        if resolved and sudo and _runtime_works([sudo, resolved]):
            return [sudo, resolved]
    raise RuntimeError(
        "container runtime CLI not found; install nerdctl or set BUNNYLAND_CONTAINER_CLI"
    )


def reserve_port() -> int:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
        sock.bind(("127.0.0.1", 0))
        return int(sock.getsockname()[1])


def api_request(
    api_url: str,
    path: str,
    *,
    method: str = "GET",
    body: RequestBody | None = None,
    extra_headers: dict[str, str] | None = None,
) -> dict:
    response, _headers = api_request_with_headers(
        api_url,
        path,
        method=method,
        body=body,
        extra_headers=extra_headers,
    )
    return response


def api_request_with_headers(
    api_url: str,
    path: str,
    *,
    method: str = "GET",
    body: RequestBody | None = None,
    extra_headers: dict[str, str] | None = None,
) -> tuple[dict, Message]:
    data = None
    headers = {
        "Authorization": f"Bearer {ADMIN_TOKEN}",
        "X-Bunnyland-Client-Id": "character-memory-playwright",
    }
    if extra_headers:
        headers.update(extra_headers)
    if body is not None:
        data = json.dumps(asdict(body)).encode("utf-8")
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(
        f"{api_url}{path}",
        data=data,
        headers=headers,
        method=method,
    )
    with urllib.request.urlopen(request, timeout=5) as response:
        payload = response.read()
        return (json.loads(payload.decode("utf-8")) if payload else {}), response.headers


def api_get(api_url: str, path: str) -> dict:
    return api_request(api_url, path)


def wait_for_api(api_url: str, proc: subprocess.Popen | None, timeout: float = 45.0) -> None:
    deadline = time.monotonic() + timeout
    last_error: Exception | None = None
    while time.monotonic() < deadline:
        if proc is not None and proc.poll() is not None:
            raise RuntimeError(f"character memory API exited early with code {proc.returncode}")
        try:
            api_get(api_url, "/v1/public/health")
            return
        except (urllib.error.URLError, TimeoutError, ConnectionError, json.JSONDecodeError) as exc:
            last_error = exc
            time.sleep(0.5)
    raise RuntimeError(f"timed out waiting for {api_url}/v1/public/health: {last_error}")


def start_memory_api() -> tuple[str, subprocess.Popen | None]:
    global ADMIN_TOKEN, SERVER_CONTAINER_NAME, TOKEN_DATA_DIR
    override = os.environ.get("BUNNYLAND_MEMORY_API_URL")
    if override:
        if not ADMIN_TOKEN:
            raise RuntimeError("BUNNYLAND_OPERATOR_TOKEN is required with BUNNYLAND_MEMORY_API_URL")
        api_url = override.rstrip("/")
        wait_for_api(api_url, None)
        return api_url, None

    port = int(os.environ.get("BUNNYLAND_MEMORY_API_PORT") or reserve_port())
    api_url = f"http://127.0.0.1:{port}"
    log_path = Path(os.environ.get("BUNNYLAND_MEMORY_API_LOG", "/tmp/bunnyland-character-memory-api.log"))
    log = log_path.open("w", encoding="utf-8")
    SERVER_CONTAINER_NAME = f"bunnyland-memory-{port}"
    runtime = container_cli()
    subprocess.run([*runtime, "pull", SERVER_IMAGE], check=True)
    TOKEN_DATA_DIR = Path(tempfile.mkdtemp(prefix="bunnyland-memory-auth-"))
    provision = subprocess.run(
        [
            *runtime,
            "run",
            "--rm",
            "-v",
            f"{TOKEN_DATA_DIR}:/data",
            SERVER_IMAGE,
            "auth",
            "provision-token",
            "--db",
            "/data/auth-tokens.sqlite3",
            "--subject",
            "character-memory-playwright",
            "--scope",
            "world:admin",
        ],
        check=True,
        capture_output=True,
        text=True,
    )
    ADMIN_TOKEN = provision.stdout.strip()
    password_hash = subprocess.run(
        [
            *runtime,
            "run",
            "--rm",
            "-i",
            SERVER_IMAGE,
            "auth",
            "hash-password",
            "--password-stdin",
        ],
        input="character-memory-smoke-only\n",
        check=True,
        capture_output=True,
        text=True,
    ).stdout.strip()
    users_file = TOKEN_DATA_DIR / "auth-users.yml"
    users_file.write_text(
        "users:\n"
        "  character-memory-playwright:\n"
        f"    password_hash: {password_hash!r}\n"
        "    scopes: [world:admin]\n",
        encoding="utf-8",
    )
    users_file.chmod(0o600)
    proc = subprocess.Popen(
        [
            *runtime,
            "run",
            "--rm",
            "--name",
            SERVER_CONTAINER_NAME,
            "-p",
            f"127.0.0.1:{port}:8765",
            "-v",
            f"{TOKEN_DATA_DIR}:/data",
            SERVER_IMAGE,
            "serve",
            "--generator",
            os.environ.get("BUNNYLAND_MEMORY_GENERATOR", "apartment-demo"),
            "--seed",
            os.environ.get("BUNNYLAND_MEMORY_SEED", "character memory playwright"),
            "--ticks",
            "0",
            "--tick-seconds",
            os.environ.get("BUNNYLAND_MEMORY_TICK_SECONDS", "0.2"),
            "--api-host",
            "0.0.0.0",
            "--api-port",
            "8765",
            "--token-db",
            "/data/auth-tokens.sqlite3",
            "--auth-users-file",
            "/data/auth-users.yml",
            "--claim-timeout-seconds",
            "0",
            "--memory-backend",
            "in-memory",
        ],
        stdout=log,
        stderr=subprocess.STDOUT,
    )
    try:
        wait_for_api(api_url, proc)
    except Exception:
        proc.terminate()
        try:
            proc.wait(timeout=10)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait(timeout=10)
        raise
    return api_url, proc


def select_memory_character(api_url: str) -> dict:
    body = api_get(api_url, "/v1/admin/memory/collections")
    for character in body.get("characters", []):
        collection = character.get("private_collection") or ""
        if collection:
            return {
                "id": character["character_id"],
                "name": character.get("name") or character["character_id"],
                "collection": collection,
            }
    raise RuntimeError(f"server returned no memory-enabled characters: {body!r}")


def claim_character(api_url: str, character_id: str) -> dict:
    body, headers = api_request_with_headers(
        api_url,
        "/v1/play/claims",
        method="POST",
        body=ClaimCreateRequest(
            character_id=character_id,
            label="character-memory-test",
            fallback_controller="suspend",
            timeout_seconds=300,
        ),
    )
    secret = headers.get("X-Bunnyland-Claim-Secret")
    if not secret:
        raise RuntimeError("claim response omitted X-Bunnyland-Claim-Secret")
    return {**body, "claim_secret": secret}


def seed_memory_note(api_url: str, character: dict) -> str:
    claim = claim_character(api_url, character["id"])
    command_id = "character-memory-note"
    response = api_request(
        api_url,
        f"/v1/play/claims/{claim['id']}/commands",
        method="POST",
        body=ClaimCommandRequest(
            command_type="take-note",
            payload={"text": "Berries grow north.", "tags": ["forage"]},
            cost=CommandCostRequest(focus=1),
            lane="focus",
            on_insufficient_points="deny",
            id=command_id,
        ),
        extra_headers={"X-Bunnyland-Claim-Secret": claim["claim_secret"]},
    )
    if response.get("status") != "queued":
        raise RuntimeError(f"take-note was rejected: {response!r}")
    deadline = time.monotonic() + 20
    while time.monotonic() < deadline:
        documents = api_get(
            api_url,
            f"/v1/admin/memory/collections/{character['collection']}/documents",
        ).get("documents", [])
        for document in documents:
            if document.get("document") == "Berries grow north.":
                return document["id"]
        time.sleep(0.5)
    raise RuntimeError("seeded memory note did not appear")


def launch_browser(playwright):
    chrome = (
        os.environ.get("BUNNYLAND_CHROME")
        or shutil.which("google-chrome")
        or shutil.which("chromium")
        or shutil.which("chromium-browser")
    )
    kwargs = {"headless": True}
    if chrome:
        kwargs["executable_path"] = chrome
        kwargs["args"] = ["--no-sandbox"]
    return playwright.chromium.launch(**kwargs)


def fresh_page(browser, coverage: PlaywrightCoverage, api_url: str):
    page = coverage.new_page(browser, viewport={"width": 1280, "height": 720}, device_scale_factor=1)
    page.set_extra_http_headers({"Authorization": f"Bearer {ADMIN_TOKEN}"})

    def proxy_api(route) -> None:
        parsed = urllib.parse.urlsplit(route.request.url)
        path = parsed.path.removeprefix("/api-memory")
        target = f"{api_url}{path}"
        if parsed.query:
            target = f"{target}?{parsed.query}"
        route.fulfill(response=route.fetch(url=target))

    page.route("**/api-memory/**", proxy_api)
    page.goto(
        f"{BASE_URL}/character-memory.html?server=%2Fapi-memory%2Fv1",
        wait_until="networkidle",
    )
    return page


def assert_(condition, message) -> None:
    if not condition:
        raise AssertionError(message)


def test_memory_editor_flow(page, api_url: str, character: dict, document_id: str) -> None:
    expect(page.locator("#api-status")).to_have_text("live")
    expect(page.locator("#character-list")).to_contain_text(character["name"])

    page.locator(f'.collection-row[data-collection="{character["collection"]}"]').click()
    expect(page.locator("#document-list")).to_contain_text(document_id)
    page.locator(f'.document-row[data-document="{document_id}"]').click()
    expect(page.locator("#document-text")).to_have_value("Berries grow north.")

    page.locator("#document-text").fill("Berries grow north by the old basin.")
    page.locator("#metadata-json").fill("{bad json")
    assert_(page.locator("#btn-save-document").is_disabled(), "invalid metadata did not block save")
    expect(page.locator("#metadata-error")).not_to_have_text("")

    page.locator("#metadata-json").fill(
        json.dumps({"source": "admin", "tags": ["edited"], "created_at_epoch": 6}, indent=2)
    )
    page.locator("#memory-tags .tag-input").fill("playwright")
    page.locator("#memory-tags [data-add-tag]").click()
    assert_(not page.locator("#btn-save-document").is_disabled(), "save stayed disabled")
    page.locator("#btn-save-document").click()
    expect(page.locator("#editor-status")).to_have_text("Ready.")
    saved = api_get(
        api_url,
        f"/v1/admin/memory/collections/{character['collection']}/documents",
    )
    saved_document = next(doc for doc in saved["documents"] if doc["id"] == document_id)
    assert_(saved_document["document"] == "Berries grow north by the old basin.",
            f"document was not patched: {saved!r}")
    assert_(saved_document["metadata"] == {
        "source": "admin",
        "tags": ["edited", "playwright"],
        "created_at_epoch": 6,
    }, f"metadata was not patched: {saved!r}")

    page.locator("#btn-new-document").click()
    expect(page.locator("#selected-document-id")).to_have_text("New document")
    page.locator("#document-text").fill("The pantry latch sticks.")
    page.locator("#metadata-json").fill(
        json.dumps({"source": "admin", "created_at_epoch": 7}, indent=2)
    )
    page.locator("#memory-tags .tag-input").fill("new")
    page.locator("#memory-tags [data-add-tag]").click()
    assert_(not page.locator("#btn-save-document").is_disabled(), "new document save stayed disabled")
    with page.expect_response(
        lambda response: response.request.method == "POST"
        and f"/admin/memory/collections/{character['collection']}/documents" in response.url
        and response.status == 201
    ):
        page.locator("#btn-save-document").click()
    expect(page.locator("#editor-status")).to_have_text("Ready.")
    deadline = time.monotonic() + 5
    created: dict = {}
    created_document = None
    while time.monotonic() < deadline:
        created = api_get(
            api_url,
            f"/v1/admin/memory/collections/{character['collection']}/documents",
        )
        created_document = next(
            (
                doc
                for doc in created["documents"]
                if doc["document"] == "The pantry latch sticks."
            ),
            None,
        )
        if created_document is not None:
            break
        time.sleep(0.1)
    assert_(created_document is not None, f"new document was not persisted: {created!r}")
    assert_(created_document["metadata"] == {
        "source": "admin",
        "created_at_epoch": 7,
        "tags": ["new"],
    }, f"document was not created through the editor: {created!r}")

    page.on("dialog", lambda dialog: dialog.accept())
    page.locator("#btn-delete-document").click()
    page.locator(f'.document-row[data-document="{document_id}"]').click()
    page.locator("#btn-delete-document").click()
    expect(page.locator("#document-list")).to_contain_text("No matching documents.")
    after_delete = api_get(
        api_url,
        f"/v1/admin/memory/collections/{character['collection']}/documents",
    )
    assert_(all(doc["id"] != document_id for doc in after_delete["documents"]),
            f"document was not deleted: {after_delete!r}")
    assert_(all(doc["id"] != created_document["id"] for doc in after_delete["documents"]),
            f"created document was not deleted: {after_delete!r}")


def test_client_menu_active(page) -> None:
    page.locator("#btn-client-menu").click()
    active = page.locator(".client-menu-item.active")
    active.wait_for()
    href = active.get_attribute("href") or ""
    assert_(href.startswith("character-memory.html"), f"active menu item is {href!r}")
    page.keyboard.press("Escape")


TESTS = [
    test_memory_editor_flow,
    test_client_menu_active,
]


def main() -> None:
    ensure_web_server(BASE_URL)
    SCREENSHOT_DIR.mkdir(parents=True, exist_ok=True)
    failures = []
    api_url, api_proc = start_memory_api()
    try:
        character = select_memory_character(api_url)
        document_id = seed_memory_note(api_url, character)
        with sync_playwright() as playwright:
            coverage = PlaywrightCoverage("character-memory")
            browser = launch_browser(playwright)
            for test in TESTS:
                page = fresh_page(browser, coverage, api_url)
                try:
                    if test is test_memory_editor_flow:
                        test(page, api_url, character, document_id)
                    else:
                        test(page)
                    print(f"{test.__name__}=ok")
                except AssertionError as err:
                    failures.append(f"{test.__name__}: {err}")
                    print(f"{test.__name__}=FAIL {err}")
                finally:
                    if test is TESTS[0]:
                        page.screenshot(path=str(SCREENSHOT))
                    coverage.close_page(page)
            coverage.close_browser(browser)
    finally:
        if api_proc is not None:
            api_proc.terminate()
            try:
                api_proc.wait(timeout=10)
            except subprocess.TimeoutExpired:
                api_proc.kill()
                api_proc.wait(timeout=10)
        if SERVER_CONTAINER_NAME:
            subprocess.run(
                [*container_cli(), "stop", SERVER_CONTAINER_NAME],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )

    if failures:
        raise SystemExit("character memory regressions:\n  " + "\n  ".join(failures))
    print(f"character_memory=ok ({len(TESTS)} checks)")


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        log_path = Path(os.environ.get("BUNNYLAND_MEMORY_API_LOG", "/tmp/bunnyland-character-memory-api.log"))
        if log_path.exists():
            print(f"\n--- character memory server log: {log_path} ---", file=sys.stderr)
            print(log_path.read_text(encoding="utf-8", errors="replace")[-8000:], file=sys.stderr)
        raise exc
